function VFXAssetIds.GetEntry(element: string, slot: string): VFXAssetEntry?
    local group = VFXAssetIds[element]
    if not group then return nil end
    local mappedSlot = slot
    if slot == "1" then mappedSlot = "Move1"
    elseif slot == "2" then mappedSlot = "Move2"
    elseif slot == "3" then mappedSlot = "Move3"
    elseif slot == "4" then mappedSlot = "Move4"
    elseif slot == "5" then mappedSlot = "Move5"
    end
    return group[mappedSlot]
end

