          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">CameraShakeController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Camera Shake Controller
    Non-intrusive 6D Perlin noise camera shake based on trauma decay.
    NEVER locks or overrides the player's camera control.
]]

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local camera: Camera? = Workspace.CurrentCamera

local CameraShakeController = {}

local trauma = 0.0
local shakeFrequency = 24.0
local maxPitch = 4.0   -- Max degrees
local maxYaw = 4.0     -- Max degrees
local maxRoll = 3.0    -- Max degrees

function CameraShakeController.Shake(intensity: number)
    -- Clamp trauma up to 1.0
    trauma = math.clamp(trauma + intensity, 0, 1.0)
end

function CameraShakeController.Init()
    camera = Workspace.CurrentCamera

    RunService.RenderStepped:Connect(function(deltaTime)
        if trauma <= 0 then return end

        -- Exponential trauma decay
        trauma = math.max(0, trauma - (deltaTime * 1.8))
        local shakeAmount = trauma * trauma -- Quadratic falloff gives crisp snap and smooth fade

        local time = os.clock() * shakeFrequency
        local yawOffset = (math.noise(time, 0, 0) - 0.5) * 2 * maxYaw * shakeAmount
        local pitchOffset = (math.noise(0, time, 0) - 0.5) * 2 * maxPitch * shakeAmount
        local rollOffset = (math.noise(0, 0, time) - 0.5) * 2 * maxRoll * shakeAmount

        local cam = camera or Workspace.CurrentCamera
        if not cam then return end

        local shakeCFrame = CFrame.Angles(math.rad(pitchOffset), math.rad(yawOffset), math.rad(rollOffset))
        cam.CFrame = cam.CFrame * shakeCFrame
    end)
end

return table.freeze(CameraShakeController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">CombatController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Client Combat Controller (Blox Fruits Anime Combat)
    Features:
    - 0ms Latency Client-Side Prediction: Animations, procedural motions, UI cooldown sweeps,
      and sound triggers fire INSTANTLY without waiting for network roundtrips!
    - Input Queuing & Buffering: Rapid M1 clicks within 0.14s of cooldown recovery automatically
      queue the next hit, eliminating dropped clicks.
    - Anime RPG Keybinds: [Z], [X], [C], [V], [B] AND [1], [2], [3], [4], [5]
    - Flash Step / Anime Dash on [Q] with velocity impulse, neon trails, FOV punch, and whoosh audio.
    - 4-hit M1 combo chain with alternating punches and heavy finisher camera shake.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local SharedLoader = require(script.Parent.Parent.SharedLoader)
local GameConfig = SharedLoader.GameConfig
local AbilityConfig = SharedLoader.AbilityConfig
local AnimationMarkerUtil = SharedLoader.AnimationMarkerUtil
local VFXHelper = SharedLoader.VFXHelper
local SoundController = require(script.Parent.SoundController)
local CameraShakeController = require(script.Parent.CameraShakeController)
local ProceduralAnimController = require(script.Parent.ProceduralAnimController)
local UIController = require(script.Parent.UIController)
local VFXController = require(script.Parent.VFXController)

local localPlayer = Players.LocalPlayer

local CombatController = {}

local castAbilityEvent: RemoteEvent? = nil
local abilityEvent: RemoteEvent? = nil

-- Combat & Element Cache
local currentElement = "Fire"
local localCooldowns: { [string]: number } = {}

-- Combo State
local comboStep = 1
local lastM1Time = 0.0
local COMBO_RESET_DELAY = 1.3
local m1Queued = false

-- Dash state
local lastDashTime = 0.0
local DASH_COOLDOWN = 1.2
local DASH_ENERGY_COST = 40

local onCooldownStartedCallback: ((slot: string, duration: number) -> ())? = nil

function CombatController.SetCooldownCallback(callback: (slot: string, duration: number) -> ())
    onCooldownStartedCallback = callback
end

function CombatController.SetCurrentElement(elem: string)
    currentElement = elem
end

-- ==================== FLASH STEP / ANIME DASH ====================
local function PerformAnimeDash()
    local now = os.clock()
    if now - lastDashTime < DASH_COOLDOWN then return end

    local char = localPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not humanoid or humanoid.Health <= 0 or not rootPart then return end

    -- Consume energy
    local canDash = UIController.ConsumeEnergy(DASH_ENERGY_COST)
    if not canDash then return end

    lastDashTime = now
    UIController.StartCooldown("Dash", DASH_COOLDOWN)

    -- Determine dash direction (movement direction or camera facing)
    local moveDir = humanoid.MoveDirection
    local dashDir = if moveDir.Magnitude > 0.1 then moveDir else rootPart.CFrame.LookVector

    -- Instant tactile feedback: dash sound, sonic shockwave ring & FOV punch
    SoundController.PlaySound2D("Dash", 0.9)
    CameraShakeController.Shake(0.18)
    VFXHelper.CreateShockwave(rootPart.Position, 7, 0.22, currentElement)

    -- Dynamic camera FOV punch
    local cam = Workspace.CurrentCamera
    if cam then
        local origFOV = cam.FieldOfView
        TweenService:Create(cam, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = origFOV + 6 }):Play()
        task.delay(0.12, function()
            TweenService:Create(cam, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = origFOV }):Play()
        end)
    end

    -- High-velocity physics impulse
    local attachment = Instance.new("Attachment")
    attachment.Parent = rootPart

    local linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.MaxForce = 140000
    linearVelocity.VectorVelocity = dashDir * 88
    linearVelocity.Attachment0 = attachment
    linearVelocity.Parent = rootPart

    -- Visual motion trail line styled with current element palette
    local elemPalette = VFXHelper.GetPalette(currentElement)
    local trailPart = Instance.new("Part")
    trailPart.Size = Vector3.new(0.4, 0.4, (dashDir * 22).Magnitude)
    trailPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, -6)
    trailPart.Color = elemPalette.Secondary
    trailPart.Material = Enum.Material.Neon
    trailPart.Transparency = 0.2
    trailPart.Anchored = true
    trailPart.CanCollide = false
    trailPart.Parent = Workspace:FindFirstChild("VFX") or Workspace

    TweenService:Create(trailPart, TweenInfo.new(0.22), { Transparency = 1, Size = Vector3.new(0.02, 0.02, 28) }):Play()
    Debris:AddItem(trailPart, 0.3)

    task.delay(0.18, function()
        linearVelocity:Destroy()
        attachment:Destroy()
    end)
end

-- ==================== CLIENT PREDICTED CAST ====================
function CombatController.Cast(slot: string)
    if slot == "Dash" then
        PerformAnimeDash()
        return
    end

    if not castAbilityEvent then
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            castAbilityEvent = remotes:FindFirstChild(GameConfig.REMOTES.CAST_ABILITY) :: RemoteEvent?
        end
    end

    local now = os.clock()
    local char = localPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    local ability = AbilityConfig.GetAbility(currentElement, slot)

    if slot == "M1" then
        local m1Cooldown = if comboStep == 4 then 0.75 else 0.28

        -- Check cooldown & input buffer
        if localCooldowns["M1"] and now < localCooldowns["M1"] then
            local remaining = localCooldowns["M1"] - now
            if remaining <= 0.14 and not m1Queued then
                m1Queued = true
                task.delay(remaining, function()
                    m1Queued = false
                    CombatController.Cast("M1")
                end)
            end
            return
        end

        localCooldowns["M1"] = now + m1Cooldown

        if now - lastM1Time > COMBO_RESET_DELAY then
            comboStep = 1
        end
        lastM1Time = now

        -- 1. Instantly trigger UI cooldown
        if onCooldownStartedCallback then
            onCooldownStartedCallback("M1", m1Cooldown)
        end

        -- 2. Instantly trigger character animation & procedural motion
        ProceduralAnimController.PlayProceduralPunch(comboStep)
        if ability and ability.AnimationId and ability.AnimationId ~= "" then
            AnimationMarkerUtil.PlayWithMarker(humanoid, ability.AnimationId, "Hit", 0.2, function() end)
        end

        -- 3. Instant tactile sound & screen shake
        if ability and ability.SFXId and ability.SFXId ~= "" then
            SoundController.PlayAudioId2D(ability.SFXId, 0.7)
        else
            SoundController.PlaySound2D("Punch", 0.65)
        end
        if comboStep == 4 then
            CameraShakeController.Shake(0.35)
            VFXController.TriggerImpactFrame(0.06, 1.0)
        end

        -- 4. Authoritative server dispatch
        if castAbilityEvent then
            castAbilityEvent:FireServer("M1", { ComboStep = comboStep })
        end

        comboStep = (comboStep % 4) + 1
    else
        if not ability then return end

        local cd = ability.Cooldown
        if localCooldowns[slot] and now < localCooldowns[slot] then
            return
        end

        localCooldowns[slot] = now + cd

        -- 1. Instant UI cooldown sweep
        if onCooldownStartedCallback then
            onCooldownStartedCallback(slot, cd)
        end

        -- 2. Instant procedural motion & animation
        if slot == "2" or slot == "4" then
            ProceduralAnimController.PlayHeavySlam()
        else
            ProceduralAnimController.PlayLunge()
        end

        if ability.AnimationId and ability.AnimationId ~= "" then
            AnimationMarkerUtil.PlayWithMarker(humanoid, ability.AnimationId, ability.AnimationMarker or "Hit", 0.25, function() end)
        end

        -- 3. Instant sound, camera shake & ultimate effects
        if ability.SFXId and ability.SFXId ~= "" then
            SoundController.PlayAudioId2D(ability.SFXId, 0.8)
        else
            SoundController.PlaySound2D("MagicCast", 0.75)
        end
        CameraShakeController.Shake(ability.ScreenShake or 0.25)
        if slot == "4" then
            VFXController.TriggerImpactFrame(0.08, 1.2)
            VFXHelper.CreateConvergingCharge(char:GetPivot().Position, currentElement, 0.45)
        end

        -- 4. Authoritative server dispatch
        if castAbilityEvent then
            castAbilityEvent:FireServer(slot, {})
        end
    end
end

function CombatController.Init()
    local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
    if not remotes then return end

    castAbilityEvent = remotes:WaitForChild(GameConfig.REMOTES.CAST_ABILITY) :: RemoteEvent?
    abilityEvent = remotes:WaitForChild(GameConfig.REMOTES.ABILITY_EVENT) :: RemoteEvent?

    -- Server sync listener (re-syncs if server overrides cooldown)
    if abilityEvent then
        abilityEvent.OnClientEvent:Connect(function(slot: string, cooldown: number, animId: string?, marker: string?)
            localCooldowns[slot] = os.clock() + cooldown
            if onCooldownStartedCallback then
                onCooldownStartedCallback(slot, cooldown)
            end
        end)
    end

    -- PC Keyboard & Mouse Inputs (Blox Fruits style: Z/X/C/V or 1/2/3/4, Q for Dash)
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end

        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            CombatController.Cast("M1")
        elseif input.KeyCode == Enum.KeyCode.Q then
            PerformAnimeDash()
        elseif input.KeyCode == Enum.KeyCode.Z or input.KeyCode == Enum.KeyCode.One then
            CombatController.Cast("1")
        elseif input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.Two then
            CombatController.Cast("2")
        elseif input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.Three then
            CombatController.Cast("3")
        elseif input.KeyCode == Enum.KeyCode.V or input.KeyCode == Enum.KeyCode.Four then
            CombatController.Cast("4")
        elseif input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.Five then
            CombatController.Cast("5")
        end
    end)
end

return table.freeze(CombatController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">DamageNumbersController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: 3D Floating Damage Numbers Controller (Blox Fruits Modern Design)
    Renders dynamic, bouncing damage text in world-space with element-specific color accents
    and anime impact pop scale.
]]

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local DamageNumbersController = {}

local ELEMENT_TEXT_COLORS = {
    Fire  = Color3.fromRGB(255, 90, 40),
    Aqua  = Color3.fromRGB(0, 180, 255),
    Earth = Color3.fromRGB(180, 130, 75),
    Light = Color3.fromRGB(255, 235, 120),
    Wind  = Color3.fromRGB(80, 235, 160),
    Error = Color3.fromRGB(255, 30, 150),
    Time  = Color3.fromRGB(140, 95, 255),
}

function DamageNumbersController.SpawnDamageNumber(position: Vector3, damage: number, element: string, isCrit: boolean)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DamageNumberGui"
    billboard.Size = UDim2.new(0, 140, 0, 48)
    billboard.Adornee = nil
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0

    -- Random horizontal scatter
    local spread = Vector3.new(math.random(-15, 15) / 10, math.random(5, 12) / 10, math.random(-15, 15) / 10)
    local startPos = position + Vector3.new(0, 2.8, 0) + spread

    local anchor = Instance.new("Part")
    anchor.Name = "DamageAnchor"
    anchor.Size = Vector3.new(0.1, 0.1, 0.1)
    anchor.CFrame = CFrame.new(startPos)
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.Anchored = true
    anchor.Parent = Workspace:FindFirstChild("VFX") or Workspace

    billboard.Adornee = anchor
    billboard.Parent = anchor

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBlack
    label.TextSize = if isCrit then 32 else 20
    label.TextColor3 = if isCrit then Color3.fromRGB(255, 80, 80) else (ELEMENT_TEXT_COLORS[element] or Color3.fromRGB(255, 255, 255))
    label.TextStrokeTransparency = 0.15
    label.TextStrokeColor3 = Color3.fromRGB(12, 16, 26)
    label.Text = (if isCrit then "CRIT! " else "") .. tostring(math.round(damage))
    label.Parent = billboard

    -- Initial pop animation
    label.TextSize = if isCrit then 40 else 24
    TweenService:Create(label, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        TextSize = if isCrit then 28 else 18,
    }):Play()

    -- Upward float and fade tween
    local floatDuration = 0.8
    local targetCFrame = anchor.CFrame * CFrame.new(0, 3.8, 0)

    local moveTween = TweenService:Create(anchor, TweenInfo.new(floatDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = targetCFrame,
    })
    local fadeTween = TweenService:Create(label, TweenInfo.new(floatDuration, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
        TextTransparency = 1,
        TextStrokeTransparency = 1,
    })

    moveTween:Play()
    fadeTween:Play()

    Debris:AddItem(anchor, floatDuration + 0.1)
end

return table.freeze(DamageNumbersController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">MobileController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Mobile Touch Controller (Blox Fruits Modern Design)
    Detects touch screens and dynamically generates right-side combat controls:
    - Primary Attack (M1)
    - Anime Dash / Flash Step (Q)
    Safe-area margins and responsive tap targets.
]]

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local localPlayer = Players.LocalPlayer

local function GetPlayerGui(): PlayerGui?
    if not localPlayer then
        localPlayer = Players.LocalPlayer
    end
    if not localPlayer then return nil end
    return (localPlayer:FindFirstChild("PlayerGui") or localPlayer:WaitForChild("PlayerGui", 15)) :: PlayerGui?
end

local MobileController = {}

function MobileController.Init()
    if not UserInputService.TouchEnabled then
        return
    end

    local playerGui = GetPlayerGui()
    if not playerGui then return end

    local mobileGui = Instance.new("ScreenGui")
    mobileGui.Name = "ElementalWorlds_MobileControls"
    mobileGui.ResetOnSpawn = false
    mobileGui.Parent = playerGui

    local combatController = require(script.Parent.CombatController)

    -- Container positioned on lower right
    local rightContainer = Instance.new("Frame")
    rightContainer.Name = "MobileCombatContainer"
    rightContainer.Size = UDim2.new(0, 180, 0, 180)
    rightContainer.Position = UDim2.new(1, -200, 1, -210)
    rightContainer.BackgroundTransparency = 1
    rightContainer.Parent = mobileGui

    -- Primary M1 Attack Button (Circular)
    local m1Button = Instance.new("TextButton")
    m1Button.Name = "Mobile_M1"
    m1Button.Size = UDim2.new(0, 80, 0, 80)
    m1Button.Position = UDim2.new(1, -85, 1, -85)
    m1Button.BackgroundColor3 = Color3.fromRGB(18, 24, 38)
    m1Button.Text = "ATTACK"
    m1Button.Font = Enum.Font.GothamBlack
    m1Button.TextSize = 13
    m1Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    m1Button.AutoButtonColor = false
    m1Button.Parent = rightContainer

    local m1Corner = Instance.new("UICorner")
    m1Corner.CornerRadius = UDim.new(1, 0)
    m1Corner.Parent = m1Button

    local m1Stroke = Instance.new("UIStroke")
    m1Stroke.Color = Color3.fromRGB(115, 90, 245)
    m1Stroke.Thickness = 2.5
    m1Stroke.Parent = m1Button

    local function AnimatePress(btn: GuiButton, origSize: UDim2)
        TweenService:Create(btn, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(origSize.X.Scale, math.round(origSize.X.Offset * 0.9), origSize.Y.Scale, math.round(origSize.Y.Offset * 0.9)),
        }):Play()
        task.delay(0.07, function()
            TweenService:Create(btn, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = origSize,
            }):Play()
        end)
    end

    local origM1Size = m1Button.Size
    m1Button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            AnimatePress(m1Button, origM1Size)
            combatController.Cast("M1")
        end
    end)

    -- Dash Button (Circular, Blox Fruits Flash Step)
    local dashButton = Instance.new("TextButton")
    dashButton.Name = "Mobile_Dash"
    dashButton.Size = UDim2.new(0, 56, 0, 56)
    dashButton.Position = UDim2.new(0, 15, 0.5, -28)
    dashButton.BackgroundColor3 = Color3.fromRGB(15, 20, 34)
    dashButton.Text = "DASH"
    dashButton.Font = Enum.Font.GothamBlack
    dashButton.TextSize = 11
    dashButton.TextColor3 = Color3.fromRGB(0, 180, 255)
    dashButton.AutoButtonColor = false
    dashButton.Parent = rightContainer

    local dashCorner = Instance.new("UICorner")
    dashCorner.CornerRadius = UDim.new(1, 0)
    dashCorner.Parent = dashButton

    local dashStroke = Instance.new("UIStroke")
    dashStroke.Color = Color3.fromRGB(0, 180, 255)
    dashStroke.Thickness = 2.0
    dashStroke.Parent = dashButton

    local origDashSize = dashButton.Size
    dashButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            AnimatePress(dashButton, origDashSize)
            combatController.Cast("Dash")
        end
    end)
end

return table.freeze(MobileController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">ProceduralAnimController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Procedural Animation Controller (Blox Fruits Anime Combat)
    Provides instantaneous client-side physical rig reactions:
    - Punches & Combo Chains
    - Heavy Cast Recoil
    - Ground Slams
    - Forward Lunges & Thrusts
    - Whirlwind Spins
    Guarantees 0ms tactile responsiveness even before animations replicate!
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local localPlayer = Players.LocalPlayer

local ProceduralAnimController = {}

local function GetJoints(character: Model)
    local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if not rootPart or not torso then return nil end

    local rightArm = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
    local leftArm = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")

    local rightShoulder: Motor6D? = nil
    local leftShoulder: Motor6D? = nil
    local rootJoint: Motor6D? = nil

    for _, desc in character:GetDescendants() do
        if desc:IsA("Motor6D") then
            if desc.Name == "RightShoulder" or desc.Part1 == rightArm then
                rightShoulder = desc
            elseif desc.Name == "LeftShoulder" or desc.Part1 == leftArm then
                leftShoulder = desc
            elseif desc.Name == "Root" or desc.Name == "RootJoint" then
                rootJoint = desc
            end
        end
    end

    return {
        RightShoulder = rightShoulder,
        LeftShoulder = leftShoulder,
        RootJoint = rootJoint,
    }
end

-- Procedural Punch motion for M1 attacks
function ProceduralAnimController.PlayProceduralPunch(comboStep: number)
    local char = localPlayer.Character
    if not char then return end

    local joints = GetJoints(char)
    if not joints then return end

    local rShoulder = joints.RightShoulder
    local lShoulder = joints.LeftShoulder
    local rootJoint = joints.RootJoint

    if comboStep % 2 == 1 and rShoulder then
        local originalC0 = rShoulder.C0
        local targetC0 = originalC0 * CFrame.Angles(math.rad(90), math.rad(-15), math.rad(25))

        local punchTween = TweenService:Create(rShoulder, TweenInfo.new(0.07, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { C0 = targetC0 })
        punchTween:Play()
        punchTween.Completed:Once(function()
            TweenService:Create(rShoulder, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = originalC0 }):Play()
        end)
    elseif lShoulder then
        local originalC0 = lShoulder.C0
        local targetC0 = originalC0 * CFrame.Angles(math.rad(90), math.rad(15), math.rad(-25))

        local punchTween = TweenService:Create(lShoulder, TweenInfo.new(0.07, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { C0 = targetC0 })
        punchTween:Play()
        punchTween.Completed:Once(function()
            TweenService:Create(lShoulder, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = originalC0 }):Play()
        end)
    end
end

-- Heavy Cast Recoil
function ProceduralAnimController.PlayCastRecoil()
    local char = localPlayer.Character
    if not char then return end

    local joints = GetJoints(char)
    if not joints or not joints.RootJoint then return end

    local rootJoint = joints.RootJoint
    local origC0 = rootJoint.C0
    local recoilC0 = origC0 * CFrame.Angles(math.rad(-12), 0, 0)

    local tween = TweenService:Create(rootJoint, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { C0 = recoilC0 })
    tween:Play()
    tween.Completed:Once(function()
        TweenService:Create(rootJoint, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = origC0 }):Play()
    end)
end

-- Ground Slam Motion
function ProceduralAnimController.PlayHeavySlam()
    local char = localPlayer.Character
    if not char then return end

    local joints = GetJoints(char)
    if not joints or not joints.RootJoint then return end

    local rootJoint = joints.RootJoint
    local rShoulder = joints.RightShoulder
    local lShoulder = joints.LeftShoulder

    local origRoot = rootJoint.C0
    local slamRoot = origRoot * CFrame.new(0, -1.2, -0.5) * CFrame.Angles(math.rad(30), 0, 0)

    TweenService:Create(rootJoint, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.In), { C0 = slamRoot }):Play()

    if rShoulder and lShoulder then
        local origR = rShoulder.C0
        local origL = lShoulder.C0
        local slamArmR = origR * CFrame.Angles(math.rad(110), 0, math.rad(-20))
        local slamArmL = origL * CFrame.Angles(math.rad(110), 0, math.rad(20))

        TweenService:Create(rShoulder, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { C0 = slamArmR }):Play()
        TweenService:Create(lShoulder, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { C0 = slamArmL }):Play()

        task.delay(0.25, function()
            TweenService:Create(rootJoint, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { C0 = origRoot }):Play()
            TweenService:Create(rShoulder, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { C0 = origR }):Play()
            TweenService:Create(lShoulder, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { C0 = origL }):Play()
        end)
    end
end

-- Forward Lunge / Thrust
function ProceduralAnimController.PlayLunge()
    local char = localPlayer.Character
    if not char then return end

    local joints = GetJoints(char)
    if not joints or not joints.RootJoint then return end

    local rootJoint = joints.RootJoint
    local origRoot = rootJoint.C0
    local lungeRoot = origRoot * CFrame.new(0, -0.4, 1.2) * CFrame.Angles(math.rad(15), 0, 0)

    local tween = TweenService:Create(rootJoint, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { C0 = lungeRoot })
    tween:Play()
    tween.Completed:Once(function()
        TweenService:Create(rootJoint, TweenInfo.new(0.2, Enum.EasingStyle.Quad), { C0 = origRoot }):Play()
    end)
end

return table.freeze(ProceduralAnimController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">ShopUIController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: In-Game Gamepass & Robux Shop UI (Blox Fruits Modern Design)
    Features:
    - Blox Fruits style categorized shop: GAMEPASSES & SPIN BUNDLES
    - Sleek dark obsidian cards with electric indigo/cyan accents
    - Integrated purchase prompting via MarketplaceService
    - Hover highlights, animated transitions, clean typography
    - NO gold or rainbow styling
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local SharedLoader = require(script.Parent.Parent.SharedLoader)
local ShopConfig = SharedLoader.ShopConfig
local SoundController = require(script.Parent.SoundController)

local localPlayer = Players.LocalPlayer

local function GetPlayerGui(): PlayerGui?
    if not localPlayer then
        localPlayer = Players.LocalPlayer
    end
    if not localPlayer then return nil end
    return (localPlayer:FindFirstChild("PlayerGui") or localPlayer:WaitForChild("PlayerGui", 15)) :: PlayerGui?
end

local ShopUIController = {}

local shopGui: ScreenGui? = nil
local shopModal: Frame? = nil
local activeTab = "GamePasses"
local scrollContainer: ScrollingFrame? = nil

-- Modern Blox Fruits Style Color Tokens
local PALETTE = {
    BG_MAIN         = Color3.fromRGB(12, 16, 26),
    BG_CARD         = Color3.fromRGB(18, 24, 38),
    BG_CARD_HOVER   = Color3.fromRGB(26, 34, 54),
    BORDER_DEFAULT  = Color3.fromRGB(42, 52, 75),
    BORDER_ACCENT   = Color3.fromRGB(115, 90, 245),
    BTN_PRIMARY     = Color3.fromRGB(115, 90, 245),
    BTN_HOVER       = Color3.fromRGB(135, 110, 255),
    TEXT_PRIMARY    = Color3.fromRGB(245, 248, 255),
    TEXT_MUTED      = Color3.fromRGB(135, 145, 170),
    PRICE_TAG       = Color3.fromRGB(80, 215, 255),
}

local function MakeRounded(inst: GuiObject, r: number)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = inst
end

local function MakeStroke(inst: GuiObject, color: Color3, thickness: number): UIStroke
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness
    s.Parent = inst
    return s
end

-- Renders item cards into the scroll container
local function PopulateCards()
    if not scrollContainer then return end

    for _, child in scrollContainer:GetChildren() do
        if child:IsA("Frame") then child:Destroy() end
    end

    if activeTab == "GamePasses" then
        local passes = {
            ShopConfig.GAMEPASSES.DoubleExp,
            ShopConfig.GAMEPASSES.DoubleCharges,
            ShopConfig.GAMEPASSES.LuckySpins,
            ShopConfig.GAMEPASSES.VIPMaster,
            ShopConfig.GAMEPASSES.SpeedBoost,
        }

        scrollContainer.CanvasSize = UDim2.new(0, 0, 0, #passes * 88)

        for _, pass in passes do
            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, -10, 0, 80)
            card.BackgroundColor3 = PALETTE.BG_CARD
            card.Parent = scrollContainer
            MakeRounded(card, 8)
            local stroke = MakeStroke(card, PALETTE.BORDER_DEFAULT, 1.2)

            -- Left accent bar
            local accentBar = Instance.new("Frame")
            accentBar.Size = UDim2.new(0, 4, 1, 0)
            accentBar.BackgroundColor3 = PALETTE.BORDER_ACCENT
            accentBar.BorderSizePixel = 0
            accentBar.Parent = card
            MakeRounded(accentBar, 4)

            -- Pass Name
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -150, 0, 24)
            nameLbl.Position = UDim2.new(0, 16, 0, 10)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Font = Enum.Font.GothamBlack
            nameLbl.TextSize = 14
            nameLbl.TextColor3 = PALETTE.TEXT_PRIMARY
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Text = pass.Name
            nameLbl.Parent = card

            -- Description
            local descLbl = Instance.new("TextLabel")
            descLbl.Size = UDim2.new(1, -150, 0, 36)
            descLbl.Position = UDim2.new(0, 16, 0, 34)
            descLbl.BackgroundTransparency = 1
            descLbl.Font = Enum.Font.GothamMedium
            descLbl.TextSize = 11
            descLbl.TextColor3 = PALETTE.TEXT_MUTED
            descLbl.TextXAlignment = Enum.TextXAlignment.Left
            descLbl.TextWrapped = true
            descLbl.Text = pass.Description
            descLbl.Parent = card

            -- Buy Button
            local buyBtn = Instance.new("TextButton")
            buyBtn.Size = UDim2.new(0, 115, 0, 36)
            buyBtn.Position = UDim2.new(1, -125, 0.5, -18)
            buyBtn.BackgroundColor3 = PALETTE.BTN_PRIMARY
            buyBtn.Font = Enum.Font.GothamBlack
            buyBtn.TextSize = 12
            buyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            buyBtn.Text = "R$ " .. tostring(pass.Price)
            buyBtn.AutoButtonColor = false
            buyBtn.Parent = card
            MakeRounded(buyBtn, 6)

            buyBtn.MouseEnter:Connect(function()
                TweenService:Create(buyBtn, TweenInfo.new(0.12), { BackgroundColor3 = PALETTE.BTN_HOVER }):Play()
            end)
            buyBtn.MouseLeave:Connect(function()
                TweenService:Create(buyBtn, TweenInfo.new(0.12), { BackgroundColor3 = PALETTE.BTN_PRIMARY }):Play()
            end)
            buyBtn.MouseButton1Click:Connect(function()
                if pass.Id and pass.Id > 0 then
                    MarketplaceService:PromptGamePassPurchase(localPlayer, pass.Id)
                else
                    SoundController.PlayUI("hover")
                end
            end)

            card.MouseEnter:Connect(function()
                TweenService:Create(card, TweenInfo.new(0.12), { BackgroundColor3 = PALETTE.BG_CARD_HOVER }):Play()
                TweenService:Create(stroke, TweenInfo.new(0.12), { Color = PALETTE.BORDER_ACCENT }):Play()
            end)
            card.MouseLeave:Connect(function()
                TweenService:Create(card, TweenInfo.new(0.12), { BackgroundColor3 = PALETTE.BG_CARD }):Play()
                TweenService:Create(stroke, TweenInfo.new(0.12), { Color = PALETTE.BORDER_DEFAULT }):Play()
            end)
        end
    else
        -- Spin Bundles
        local products = {
            ShopConfig.PRODUCTS.Spins_1,
            ShopConfig.PRODUCTS.Spins_5,
            ShopConfig.PRODUCTS.Spins_10,
        }

        scrollContainer.CanvasSize = UDim2.new(0, 0, 0, #products * 88)

        for _, prod in products do
            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, -10, 0, 80)
            card.BackgroundColor3 = PALETTE.BG_CARD
            card.Parent = scrollContainer
            MakeRounded(card, 8)
            local stroke = MakeStroke(card, PALETTE.BORDER_DEFAULT, 1.2)

            local accentBar = Instance.new("Frame")
            accentBar.Size = UDim2.new(0, 4, 1, 0)
            accentBar.BackgroundColor3 = PALETTE.PRICE_TAG
            accentBar.BorderSizePixel = 0
            accentBar.Parent = card
            MakeRounded(accentBar, 4)

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -150, 0, 24)
            nameLbl.Position = UDim2.new(0, 16, 0, 10)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Font = Enum.Font.GothamBlack
            nameLbl.TextSize = 14
            nameLbl.TextColor3 = PALETTE.TEXT_PRIMARY
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Text = prod.Name
            nameLbl.Parent = card

            local descLbl = Instance.new("TextLabel")
            descLbl.Size = UDim2.new(1, -150, 0, 36)
            descLbl.Position = UDim2.new(0, 16, 0, 34)
            descLbl.BackgroundTransparency = 1
            descLbl.Font = Enum.Font.GothamMedium
            descLbl.TextSize = 11
            descLbl.TextColor3 = PALETTE.TEXT_MUTED
            descLbl.TextXAlignment = Enum.TextXAlignment.Left
            descLbl.TextWrapped = true
            descLbl.Text = prod.Description
            descLbl.Parent = card

            local buyBtn = Instance.new("TextButton")
            buyBtn.Size = UDim2.new(0, 115, 0, 36)
            buyBtn.Position = UDim2.new(1, -125, 0.5, -18)
            buyBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 245)
            buyBtn.Font = Enum.Font.GothamBlack
            buyBtn.TextSize = 12
            buyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            buyBtn.Text = "R$ " .. tostring(prod.Price)
            buyBtn.AutoButtonColor = false
            buyBtn.Parent = card
            MakeRounded(buyBtn, 6)

            buyBtn.MouseButton1Click:Connect(function()
                if prod.Id and prod.Id > 0 then
                    MarketplaceService:PromptProductPurchase(localPlayer, prod.Id)
                else
                    SoundController.PlayUI("hover")
                end
            end)
        end
    end
end

function ShopUIController.Init()
    local playerGui = GetPlayerGui()
    if not playerGui then return end

    shopGui = Instance.new("ScreenGui")
    shopGui.Name = "ElementalWorlds_Shop"
    shopGui.ResetOnSpawn = false
    shopGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    shopGui.Parent = playerGui

    -- HUD Toggle Button (Top-Right Widget Dock)
    local shopToggleBtn = Instance.new("TextButton")
    shopToggleBtn.Name = "ShopHUDButton"
    shopToggleBtn.Size = UDim2.new(0, 125, 0, 34)
    shopToggleBtn.Position = UDim2.new(1, -145, 0, 96)
    shopToggleBtn.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
    shopToggleBtn.Font = Enum.Font.GothamBlack
    shopToggleBtn.TextSize = 11
    shopToggleBtn.TextColor3 = PALETTE.PRICE_TAG
    shopToggleBtn.Text = "ROBUX SHOP"
    shopToggleBtn.AutoButtonColor = false
    shopToggleBtn.Parent = shopGui
    MakeRounded(shopToggleBtn, 6)
    MakeStroke(shopToggleBtn, PALETTE.PRICE_TAG, 1.5)

    shopToggleBtn.MouseEnter:Connect(function()
        TweenService:Create(shopToggleBtn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(24, 30, 48) }):Play()
        SoundController.PlayUI("hover")
    end)
    shopToggleBtn.MouseLeave:Connect(function()
        TweenService:Create(shopToggleBtn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(15, 20, 32) }):Play()
    end)

    -- Shop Modal Window
    shopModal = Instance.new("Frame")
    shopModal.Name = "ShopModalWindow"
    shopModal.Size = UDim2.new(0, 580, 0, 480)
    shopModal.Position = UDim2.new(0.5, -290, 0.5, -240)
    shopModal.BackgroundColor3 = PALETTE.BG_MAIN
    shopModal.BackgroundTransparency = 0.05
    shopModal.Visible = false
    shopModal.ZIndex = 25
    shopModal.Parent = shopGui
    MakeRounded(shopModal, 12)
    MakeStroke(shopModal, PALETTE.BORDER_ACCENT, 2.0)

    -- Title Bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 48)
    titleBar.BackgroundColor3 = Color3.fromRGB(18, 22, 36)
    titleBar.ZIndex = 26
    titleBar.Parent = shopModal
    MakeRounded(titleBar, 12)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -60, 1, 0)
    titleLabel.Position = UDim2.new(0, 18, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.GothamBlack
    titleLabel.TextSize = 16
    titleLabel.TextColor3 = PALETTE.TEXT_PRIMARY
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Text = "ELEMENTAL SHOP"
    titleLabel.ZIndex = 27
    titleLabel.Parent = titleBar

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -40, 0.5, -15)
    closeBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 60)
    closeBtn.Font = Enum.Font.GothamBlack
    closeBtn.TextSize = 13
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.Text = "X"
    closeBtn.ZIndex = 27
    closeBtn.Parent = titleBar
    MakeRounded(closeBtn, 6)

    -- Tab Bar (Blox Fruits Style Clean Navigation)
    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(1, -36, 0, 36)
    tabBar.Position = UDim2.new(0, 18, 0, 56)
    tabBar.BackgroundTransparency = 1
    tabBar.ZIndex = 26
    tabBar.Parent = shopModal

    local tabPasses = Instance.new("TextButton")
    tabPasses.Size = UDim2.new(0.5, -4, 1, 0)
    tabPasses.BackgroundColor3 = PALETTE.BORDER_ACCENT
    tabPasses.Font = Enum.Font.GothamBlack
    tabPasses.TextSize = 12
    tabPasses.TextColor3 = Color3.fromRGB(255, 255, 255)
    tabPasses.Text = "GAMEPASSES"
    tabPasses.ZIndex = 27
    tabPasses.Parent = tabBar
    MakeRounded(tabPasses, 6)

    local tabSpins = Instance.new("TextButton")
    tabSpins.Size = UDim2.new(0.5, -4, 1, 0)
    tabSpins.Position = UDim2.new(0.5, 4, 0, 0)
    tabSpins.BackgroundColor3 = PALETTE.BG_CARD
    tabSpins.Font = Enum.Font.GothamBlack
    tabSpins.TextSize = 12
    tabSpins.TextColor3 = PALETTE.TEXT_MUTED
    tabSpins.Text = "SPIN BUNDLES"
    tabSpins.ZIndex = 27
    tabSpins.Parent = tabBar
    MakeRounded(tabSpins, 6)

    -- Scroll Area
    scrollContainer = Instance.new("ScrollingFrame")
    scrollContainer.Size = UDim2.new(1, -36, 1, -110)
    scrollContainer.Position = UDim2.new(0, 18, 0, 98)
    scrollContainer.BackgroundTransparency = 1
    scrollContainer.ScrollBarThickness = 5
    scrollContainer.ScrollBarImageColor3 = PALETTE.BORDER_ACCENT
    scrollContainer.ZIndex = 26
    scrollContainer.Parent = shopModal

    local scrollLayout = Instance.new("UIListLayout")
    scrollLayout.Padding = UDim.new(0, 8)
    scrollLayout.Parent = scrollContainer

    local function SwitchTab(tabName: string)
        activeTab = tabName
        if activeTab == "GamePasses" then
            tabPasses.BackgroundColor3 = PALETTE.BORDER_ACCENT
            tabPasses.TextColor3 = Color3.fromRGB(255, 255, 255)
            tabSpins.BackgroundColor3 = PALETTE.BG_CARD
            tabSpins.TextColor3 = PALETTE.TEXT_MUTED
        else
            tabSpins.BackgroundColor3 = PALETTE.BORDER_ACCENT
            tabSpins.TextColor3 = Color3.fromRGB(255, 255, 255)
            tabPasses.BackgroundColor3 = PALETTE.BG_CARD
            tabPasses.TextColor3 = PALETTE.TEXT_MUTED
        end
        PopulateCards()
    end

    tabPasses.MouseButton1Click:Connect(function() SwitchTab("GamePasses") end)
    tabSpins.MouseButton1Click:Connect(function() SwitchTab("Spins") end)

    local function ToggleShop()
        shopModal.Visible = not shopModal.Visible
        if shopModal.Visible then
            SoundController.PlayUI("open")
            PopulateCards()
            shopModal.Position = UDim2.new(0.5, -290, 0.5, -220)
            TweenService:Create(shopModal, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, -290, 0.5, -240),
            }):Play()
        else
            SoundController.PlayUI("close")
        end
    end

    shopToggleBtn.MouseButton1Click:Connect(ToggleShop)
    closeBtn.MouseButton1Click:Connect(ToggleShop)
end

return table.freeze(ShopUIController)
]]></string>
