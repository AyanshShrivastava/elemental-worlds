        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">AquaElement</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Aqua Element Implementation
    M1: Water
    1: Water Hand (Mid damage strike)
    2: Vortex of Destruction (High damage spinning sphere)
    3: Water Dragon (Transformation with on-hit burst cancellation)
    4: Aqua: Limitless Punches (Crazy damage rapid strikes)
]]

local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConfig = require(ReplicatedStorage.Shared.Config.AbilityConfig)
local HitboxService = require(script.Parent.Parent.Services.HitboxService)
local StatusEffectService = require(script.Parent.Parent.Services.StatusEffectService)
local VFXBroadcastService = require(script.Parent.Parent.Services.VFXBroadcastService)

local AquaElement = {}

-- M1: Water (4-hit combo support)
function AquaElement.CastM1(player: Player, character: Model, rootPart: BasePart, comboStep: number?)
    local ability = AbilityConfig.GetAbility("Aqua", "M1")
    if not ability then return end

    local step = comboStep or 1
    local isFinisher = (step == 4)
    local damage = if isFinisher then math.round(ability.BaseDamage * 1.6) else ability.BaseDamage
    local knockback = if isFinisher then (rootPart.CFrame.LookVector * 35 + Vector3.new(0, 12, 0)) else (rootPart.CFrame.LookVector * 10)

    -- Broadcast to ElementalVFX Dispatcher
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Aqua",
        Move = "M1",
        Character = character,
        Target = rootPart.Position + rootPart.CFrame.LookVector * 16,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual dual water spray from hands
    VFXBroadcastService.Broadcast("WaterSpray", {
        CFrame = rootPart.CFrame,
        Range = ability.Range,
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, damage, knockback, step)
    end
end

-- Move 1: Water Hand
function AquaElement.CastMove1(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Aqua", "1")
    if not ability then return end

    local strikeCFrame = rootPart.CFrame * CFrame.new(0, 0, -8)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Aqua",
        Move = "Move1",
        Character = character,
        Target = strikeCFrame.Position,
        Direction = rootPart.CFrame.LookVector,
    })
    VFXBroadcastService.Broadcast("WaterHand", {
        Position = strikeCFrame.Position,
        SFXId = ability.SFXId,
        Shake = 0.45,
    })

    local targets = HitboxService.FindTargetsInCone(strikeCFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        local knockback = Vector3.new(0, -20, 0) -- Slam downward
        HitboxService.ApplyDamage(player, target, ability.BaseDamage, knockback)
    end
end

-- Move 2: Vortex of Destruction
function AquaElement.CastMove2(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Aqua", "2")
    if not ability then return end

    local dir = rootPart.CFrame.LookVector
    local spawnPos = rootPart.Position + (dir * 3)

    task.spawn(function()
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = { character }
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        local hitResult = Workspace:Raycast(spawnPos, dir * ability.Range, raycastParams)
        local impactPos = if hitResult then hitResult.Position else (spawnPos + dir * ability.Range)

        VFXBroadcastService.Broadcast("ElementalMove", {
            Element = "Aqua",
            Move = "Move2",
            Character = character,
            Target = impactPos,
            Direction = dir,
        })
        VFXBroadcastService.Broadcast("VortexSphere", {
            StartPos = spawnPos,
            EndPos = impactPos,
            Duration = 0.4,
            SFXId = ability.SFXId,
            Shake = 0.5,
        })

        local targets = HitboxService.FindTargetsInCone(CFrame.new(impactPos), 18, 360, character)
        for _, target in targets do
            local pushVector = (target.RootPart.Position - impactPos).Unit * 35 + Vector3.new(0, 10, 0)
            HitboxService.ApplyDamage(player, target, ability.BaseDamage, pushVector)
        end
    end)
end

-- Move 3: Water Dragon (Transformation)
function AquaElement.CastMove3(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Aqua", "3")
    if not ability then return end

    local duration = ability.Duration or 5.0
    StatusEffectService.ApplyEffect(character, "WaterDragon", duration, player)

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Aqua",
        Move = "Move3",
        Character = character,
        Duration = duration,
    })
    VFXBroadcastService.Broadcast("WaterDragon", {
        Character = character,
        Duration = duration,
        SFXId = ability.SFXId,
    })
end

-- Move 4: Aqua: Limitless Punches
function AquaElement.CastMove4(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Aqua", "4")
    if not ability then return end

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Aqua",
        Move = "Move4",
        Character = character,
        Target = rootPart.Position + rootPart.CFrame.LookVector * 10,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Rapid strikes: 8 hits over 1.5 seconds totaling crazy damage
    local totalHits = 8
    local perHitDamage = math.round(ability.BaseDamage / totalHits)

    task.spawn(function()
        for i = 1, totalHits do
            if not character.Parent then break end

            local punchOffset = CFrame.new(math.random(-2, 2) * 0.8, math.random(-1, 2) * 0.5, -3.5)
            VFXBroadcastService.Broadcast("SlashArc", {
                CFrame = rootPart.CFrame * punchOffset,
                Element = "Aqua",
                Scale = 0.85,
                SFXId = "rbxassetid://3041191430",
            })

            local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
            for _, target in targets do
                local knock = if i == totalHits then (rootPart.CFrame.LookVector * 40 + Vector3.new(0, 15, 0)) else nil
                HitboxService.ApplyDamage(player, target, perHitDamage, knock)
            end

            if i == totalHits then
                VFXBroadcastService.Broadcast("ImpactFrame", {
                    Duration = 0.08,
                    Intensity = 1.25,
                })
                VFXBroadcastService.Broadcast("Crater", {
                    Position = rootPart.Position + (rootPart.CFrame.LookVector * 6),
                    Element = "Aqua",
                    Radius = 16,
                    SFXId = ability.SFXId,
                })
                VFXBroadcastService.Broadcast("Shockwave", {
                    Position = rootPart.Position + (rootPart.CFrame.LookVector * 6),
                    Element = "Aqua",
                    Radius = 20,
                    Duration = 0.4,
                    Shake = 0.6,
                    SFXId = ability.SFXId,
                })
            end

            task.wait(1.5 / totalHits)
        end
    end)
end

return table.freeze(AquaElement)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">EarthElement</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Earth Element Implementation
    M1: Earth Sword
    1: Earthy Wall (Collidable obstacle blocking attacks)
    2: Boulder of Destruction (Giant rolling projectile)
    3: Accelerated Earth Punch (Infused punch on impact)
    4: The Master of Terra (Cinematic two-character sequence with target reservation)
]]

local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConfig = require(ReplicatedStorage.Shared.Config.AbilityConfig)
local HitboxService = require(script.Parent.Parent.Services.HitboxService)
local StatusEffectService = require(script.Parent.Parent.Services.StatusEffectService)
local VFXBroadcastService = require(script.Parent.Parent.Services.VFXBroadcastService)

local EarthElement = {}

-- M1: Earth Sword (4-hit combo support)
function EarthElement.CastM1(player: Player, character: Model, rootPart: BasePart, comboStep: number?)
    local ability = AbilityConfig.GetAbility("Earth", "M1")
    if not ability then return end

    local step = comboStep or 1
    local isFinisher = (step == 4)
    local damage = if isFinisher then math.round(ability.BaseDamage * 1.6) else ability.BaseDamage
    local knockback = if isFinisher then (rootPart.CFrame.LookVector * 35 + Vector3.new(0, 12, 0)) else (rootPart.CFrame.LookVector * 10)

    -- Broadcast to ElementalVFX Dispatcher
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Earth",
        Move = "M1",
        Character = character,
        Target = rootPart.Position + rootPart.CFrame.LookVector * 12,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual stone blade slash
    VFXBroadcastService.Broadcast("SlashArc", {
        CFrame = rootPart.CFrame * CFrame.new(0, 0, -3),
        Element = "Earth",
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, damage, knockback, step)
    end
end

-- Move 1: Earthy Wall
function EarthElement.CastMove1(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Earth", "1")
    if not ability then return end

    local wallDuration = ability.Duration or 6.0
    local wallPart = Instance.new("Part")
    wallPart.Name = "EarthyWall"
    wallPart.Size = Vector3.new(16, 9, 3)
    wallPart.CFrame = rootPart.CFrame * CFrame.new(0, 3, -6)
    wallPart.Material = Enum.Material.Slate
    wallPart.Color = Color3.fromRGB(120, 85, 55)
    wallPart.Anchored = true
    wallPart.CanCollide = true
    wallPart.Parent = Workspace:FindFirstChild("Map") or Workspace

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Earth",
        Move = "Move1",
        Character = character,
        Target = wallPart.Position,
        Direction = rootPart.CFrame.LookVector,
        Duration = wallDuration,
    })

    -- Visual 3-pillar rock eruption
    VFXBroadcastService.Broadcast("EarthPillars", {
        CFrame = wallPart.CFrame,
        Duration = wallDuration,
        SFXId = ability.SFXId,
    })

    Debris:AddItem(wallPart, wallDuration)
end

-- Move 2: Boulder of Destruction
function EarthElement.CastMove2(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Earth", "2")
    if not ability then return end

    local dir = rootPart.CFrame.LookVector
    local spawnPos = rootPart.Position + (dir * 4)

    task.spawn(function()
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = { character }
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        local hitResult = Workspace:Raycast(spawnPos, dir * ability.Range, raycastParams)
        local impactPos = if hitResult then hitResult.Position else (spawnPos + dir * ability.Range)

        VFXBroadcastService.Broadcast("ElementalMove", {
            Element = "Earth",
            Move = "Move2",
            Character = character,
            Target = impactPos,
            Direction = dir,
        })

        -- Visual giant rolling boulder and shatter impact
        VFXBroadcastService.Broadcast("Boulder", {
            StartPos = spawnPos,
            EndPos = impactPos,
            Duration = 0.45,
            SFXId = ability.SFXId,
            Shake = 0.55,
        })

        local targets = HitboxService.FindTargetsInCone(CFrame.new(impactPos), 15, 360, character)
        for _, target in targets do
            local knock = (target.RootPart.Position - impactPos).Unit * 40 + Vector3.new(0, 15, 0)
            HitboxService.ApplyDamage(player, target, ability.BaseDamage, knock)
        end
    end)
end

-- Move 3: Accelerated Earth Punch
function EarthElement.CastMove3(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Earth", "3")
    if not ability then return end

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Earth",
        Move = "Move3",
        Character = character,
        Target = rootPart.Position + rootPart.CFrame.LookVector * 16,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual stone gauntlet manifests on punch
    VFXBroadcastService.Broadcast("StoneGauntlet", {
        Character = character,
        Duration = 0.4,
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, ability.BaseDamage, rootPart.CFrame.LookVector * 25)
    end
end

-- Move 4: The Master of Terra (Cinematic 2-character sequence)
function EarthElement.CastMove4(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Earth", "4")
    if not ability then return end

    -- 1. Validate and reserve target
    local target = HitboxService.FindClosestTargetInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Earth",
        Move = "Move4",
        Character = character,
        Target = if target and target.RootPart then target.RootPart.Position else (rootPart.Position + rootPart.CFrame.LookVector * 10),
        TargetCharacter = if target then target.Model else nil,
        Direction = rootPart.CFrame.LookVector,
    })
    if not target or not target.Character.Parent then
        -- Whiff feedback: Colossal Earth Terra Ground Shatter
        local strikePos = rootPart.Position + (rootPart.CFrame.LookVector * 10)
        VFXBroadcastService.Broadcast("ImpactFrame", {
            Duration = 0.08,
            Intensity = 1.3,
        })
        VFXBroadcastService.Broadcast("Crater", {
            Position = strikePos,
            Element = "Earth",
            Radius = 22,
            SFXId = ability.SFXId,
        })
        VFXBroadcastService.Broadcast("EarthPillars", {
            CFrame = CFrame.new(strikePos),
            Duration = 4.0,
            SFXId = ability.SFXId,
        })
        VFXBroadcastService.Broadcast("Shockwave", {
            Position = strikePos,
            Element = "Earth",
            Radius = 70,
            Duration = 0.5,
            Shake = 0.75,
            SFXId = ability.SFXId,
        })
        return
    end

    local tRoot = target.RootPart
    local tHum = target.Humanoid

    -- Stun target for sequence
    StatusEffectService.ApplyEffect(target.Character, "Stunned", 3.0, player)

    -- Phase 1: Launch target upward
    tRoot.CFrame = tRoot.CFrame * CFrame.new(0, 20, 0)
    rootPart.CFrame = tRoot.CFrame * CFrame.new(0, 0, 4) -- Teleport behind target in air

    -- Phase 2: Descend together
    task.delay(0.6, function()
        if not target.Character.Parent or tHum.Health <= 0 then return end
        tRoot.CFrame = tRoot.CFrame * CFrame.new(0, -18, 0)
        rootPart.CFrame = tRoot.CFrame * CFrame.new(0, 0, 4)

        -- Phase 3: Earth dagger finishing strike
        task.delay(0.4, function()
            if target.Character.Parent and tHum.Health > 0 then
                local slamKnock = Vector3.new(0, -30, 0)
                HitboxService.ApplyDamage(player, target, ability.BaseDamage, slamKnock)

                VFXBroadcastService.Broadcast("ImpactFrame", {
                    Duration = 0.08,
                    Intensity = 1.3,
                })
                VFXBroadcastService.Broadcast("TerraSequence", {
                    Position = tRoot.Position,
                    SFXId = ability.SFXId,
                })
            end
        end)
    end)
end

return table.freeze(EarthElement)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ErrorElement</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Error Element Implementation (Secret)
    M1: Glitched Dash (Dash with glitch trail; builds Error Meter on hit)
    1: Chaotic Destruction (Glitched wall dash + crazy damage)
    2: 404 Not Found (Glitched ball AoE + heavy knockback)
    3: Got Glitched (5s Invisibility + invulnerability, usable while stunned)
    4: Spatial Distortion (Requires 50% Error Meter: 7s Glitched Domain realm)
    5: Unparalleled (Requires 100% Error Meter: 5s complete enemy movement freeze)
]]

local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConfig = require(ReplicatedStorage.Shared.Config.AbilityConfig)
local HitboxService = require(script.Parent.Parent.Services.HitboxService)
local StatusEffectService = require(script.Parent.Parent.Services.StatusEffectService)
local PlayerDataService = require(script.Parent.Parent.Services.PlayerDataService)
local VFXBroadcastService = require(script.Parent.Parent.Services.VFXBroadcastService)

local ErrorElement = {}

-- M1: Glitched Dash (4-hit combo support)
function ErrorElement.CastM1(player: Player, character: Model, rootPart: BasePart, comboStep: number?)
    local ability = AbilityConfig.GetAbility("Error", "M1")
    if not ability then return end

    local step = comboStep or 1
    local isFinisher = (step == 4)
    local damage = if isFinisher then math.round(ability.BaseDamage * 1.6) else ability.BaseDamage
    local knockback = if isFinisher then (rootPart.CFrame.LookVector * 40 + Vector3.new(0, 15, 0)) else (rootPart.CFrame.LookVector * 15)

    local prevPos = rootPart.Position
    -- Dash forward
    rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, -12)

    -- Broadcast to ElementalVFX Dispatcher
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Error",
        Move = "M1",
        Character = character,
        Target = rootPart.Position,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual chromatic aberration glitch trail
    VFXBroadcastService.Broadcast("GlitchedTrail", {
        StartPos = prevPos,
        EndPos = rootPart.Position,
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, damage, knockback, step)
    end

    -- Build Error Meter (+10% on cast)
    PlayerDataService.AddErrorMeter(player, 10)
end

-- Move 1: Chaotic Destruction
function ErrorElement.CastMove1(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Error", "1")
    if not ability then return end

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Error",
        Move = "Move1",
        Character = character,
        Target = rootPart.Position + rootPart.CFrame.LookVector * 18,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual holographic digital arm shield
    VFXBroadcastService.Broadcast("GlitchWall", {
        Character = character,
        Duration = 0.6,
        SFXId = ability.SFXId,
    })

    -- Dash forward with glitched wall impact
    rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, -18)

    VFXBroadcastService.Broadcast("Crater", {
        Position = rootPart.Position,
        Element = "Error",
        Radius = 14,
        SFXId = ability.SFXId,
    })
    VFXBroadcastService.Broadcast("Shockwave", {
        Position = rootPart.Position,
        Element = "Error",
        Radius = 20,
        Duration = 0.4,
        Shake = 0.45,
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        local knock = rootPart.CFrame.LookVector * 45 + Vector3.new(0, 15, 0)
        HitboxService.ApplyDamage(player, target, ability.BaseDamage, knock)
    end

    -- Build Error Meter (+15%)
    PlayerDataService.AddErrorMeter(player, 15)
end

-- Move 2: 404 Not Found
function ErrorElement.CastMove2(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Error", "2")
    if not ability then return end

    -- Build Error Meter (+20%)
    PlayerDataService.AddErrorMeter(player, 20)

    local dir = rootPart.CFrame.LookVector
    local spawnPos = rootPart.Position + (dir * 3)

    task.spawn(function()
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = { character }
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        local hitResult = Workspace:Raycast(spawnPos, dir * ability.Range, raycastParams)
        local impactPos = if hitResult then hitResult.Position else (spawnPos + dir * ability.Range)

        VFXBroadcastService.Broadcast("ElementalMove", {
            Element = "Error",
            Move = "Move2",
            Character = character,
            Target = impactPos,
            Direction = dir,
        })

        -- Visual pulsating chromatic aberration 404 ball
        VFXBroadcastService.Broadcast("404Ball", {
            StartPos = spawnPos,
            EndPos = impactPos,
            Duration = 0.45,
            SFXId = ability.SFXId,
            Shake = 0.6,
        })

        local targets = HitboxService.FindTargetsInCone(CFrame.new(impactPos), 20, 360, character)
        for _, target in targets do
            local blastKnock = (target.RootPart.Position - impactPos).Unit * 50 + Vector3.new(0, 20, 0)
            HitboxService.ApplyDamage(player, target, ability.BaseDamage, blastKnock)
        end
    end)
end

-- Move 3: Got Glitched (5s Invisibility and Invulnerability)
function ErrorElement.CastMove3(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Error", "3")
    if not ability then return end

    -- Build Error Meter (+25%)
    PlayerDataService.AddErrorMeter(player, 25)

    local duration = ability.Duration or 5.0
    StatusEffectService.ApplyEffect(character, "GotGlitched", duration, player)

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Error",
        Move = "Move3",
        Character = character,
        Duration = duration,
    })

    -- Visual scanline glitch dissolution and shimmer silhouette
    VFXBroadcastService.Broadcast("GlitchInvis", {
        Character = character,
        Duration = duration,
        SFXId = ability.SFXId,
    })
end

-- Move 4: Spatial Distortion (Requires 50% Error Meter)
function ErrorElement.CastMove4(player: Player, character: Model, rootPart: BasePart)
    local profile = PlayerDataService.GetProfile(player)
    if not profile or profile.ErrorMeter < 50 then
        return -- Insufficient Error Meter!
    end

    local ability = AbilityConfig.GetAbility("Error", "4")
    if not ability then return end

    -- Deduct Error Meter
    PlayerDataService.AddErrorMeter(player, -50)

    -- Glitched realm activation VFX
    VFXBroadcastService.Broadcast("ImpactFrame", {
        Duration = 0.08,
        Intensity = 1.3,
    })
    VFXBroadcastService.Broadcast("ConvergingCharge", {
        Position = rootPart.Position,
        Element = "Error",
        Duration = 0.45,
    })
    VFXBroadcastService.Broadcast("Crater", {
        Position = rootPart.Position,
        Element = "Error",
        Radius = 20,
        SFXId = ability.SFXId,
    })
    VFXBroadcastService.Broadcast("Shockwave", {
        Position = rootPart.Position,
        Element = "Error",
        Radius = 30,
        Duration = 0.5,
        Shake = 0.65,
        SFXId = ability.SFXId,
    })

    local duration = ability.Duration or 7.0
    local domainRadius = 80
    local domainCenter = rootPart.Position

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Error",
        Move = "Move4",
        Character = character,
        Target = domainCenter,
        Duration = duration,
        Radius = domainRadius,
    })

    -- Spawn Grounded Cyber Glitched Domain Arena (NO sky teleport, NO void plummet!)
    VFXBroadcastService.Broadcast("SpatialDistortionDomain", {
        Position = domainCenter,
        Radius = domainRadius,
        Duration = duration,
        SFXId = ability.SFXId,
        Shake = 0.7,
    })

    -- Trap and apply ticks to nearby targets inside the 80-stud arena
    task.spawn(function()
        local elapsed = 0
        while elapsed < duration and character.Parent do
            task.wait(1.0)
            elapsed += 1.0

            local targets = HitboxService.FindTargetsInCone(CFrame.new(domainCenter), domainRadius, 360, character)
            for _, target in targets do
                if target.Character.Parent and target.Humanoid.Health > 0 then
                    StatusEffectService.ApplyEffect(target.Character, "Stunned", 1.2, player)
                    local tickDamage = math.round(ability.BaseDamage / duration)
                    HitboxService.ApplyDamage(player, target, tickDamage, nil)
                end
            end

            -- Pulse a chromatic distortion shockwave every second
            VFXBroadcastService.Broadcast("Shockwave", {
                Position = domainCenter,
                Element = "Error",
                Radius = domainRadius * 0.8,
                Duration = 0.35,
                Shake = 0.3,
            })
        end

        -- Final inward collapse burst
        VFXBroadcastService.Broadcast("ImpactFrame", {
            Duration = 0.1,
            Intensity = 1.4,
        })
        VFXBroadcastService.Broadcast("Crater", {
            Position = domainCenter,
            Element = "Error",
            Radius = 24,
            SFXId = ability.SFXId,
        })
        VFXBroadcastService.Broadcast("Shockwave", {
            Position = domainCenter,
            Element = "Error",
            Radius = domainRadius * 1.2,
            Duration = 0.5,
            Shake = 0.6,
            SFXId = ability.SFXId,
        })
        local finalTargets = HitboxService.FindTargetsInCone(CFrame.new(domainCenter), domainRadius, 360, character)
        for _, target in finalTargets do
            HitboxService.ApplyDamage(player, target, 25, Vector3.new(0, 20, 0))
        end
    end)
end

-- Move 5: Unparalleled (Requires 100% Error Meter)
function ErrorElement.CastMove5(player: Player, character: Model, rootPart: BasePart)
    local profile = PlayerDataService.GetProfile(player)
    if not profile or profile.ErrorMeter < 100 then
        return -- Insufficient Error Meter!
    end

    local ability = AbilityConfig.GetAbility("Error", "5")
    if not ability then return end

    -- Deduct full Error Meter
    PlayerDataService.AddErrorMeter(player, -100)

    VFXBroadcastService.Broadcast("ImpactFrame", {
        Duration = 0.1,
        Intensity = 1.4,
    })
    VFXBroadcastService.Broadcast("Shockwave", {
        Position = rootPart.Position,
        Element = "Error",
        Radius = 35,
        Duration = 0.6,
        Shake = 0.7,
        SFXId = ability.SFXId,
    })

    local duration = ability.Duration or 5.0
    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, 360, character)

    local targetModels = {}
    for _, t in targets do
        if t.Character then table.insert(targetModels, t.Character) end
    end
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Error",
        Move = "Move5",
        Character = character,
        Targets = targetModels,
        Direction = rootPart.CFrame.LookVector,
    })
    if #targets > 0 then
        for _, target in targets do
            StatusEffectService.ApplyEffect(target.Character, "UnparalleledStun", duration, player)
            HitboxService.ApplyDamage(player, target, ability.BaseDamage, nil)
            VFXBroadcastService.Broadcast("GlitchCage", {
                Position = target.RootPart.Position,
                Duration = duration,
                SFXId = ability.SFXId,
            })
        end
    else
        -- Whiff visual feedback: spawn cyber glitch cage in front of caster
        VFXBroadcastService.Broadcast("GlitchCage", {
            Position = rootPart.Position + rootPart.CFrame.LookVector * 12,
            Duration = duration,
            SFXId = ability.SFXId,
        })
    end
end

return table.freeze(ErrorElement)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">FireElement</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Fire Element Implementation
    M1: Flame Dagger
    1: Scorching Fireball (Projectile with impact/miss burst)
    2: Infernal Beast (Summons fire minion with 25% max HP)
    3: Flames of Fury (Teleports behind target + Goldi beam & lines)
    4: Infernal Judgement (10s Fire Domain barrier with boundary lock)
]]

local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConfig = require(ReplicatedStorage.Shared.Config.AbilityConfig)
local HitboxService = require(script.Parent.Parent.Services.HitboxService)
local StatusEffectService = require(script.Parent.Parent.Services.StatusEffectService)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local VFXBroadcastService = require(script.Parent.Parent.Services.VFXBroadcastService)

local FireElement = {}

-- M1: Flame Dagger (4-hit combo support)
function FireElement.CastM1(player: Player, character: Model, rootPart: BasePart, comboStep: number?)
    local ability = AbilityConfig.GetAbility("Fire", "M1")
    if not ability then return end

    local step = comboStep or 1
    local isFinisher = (step == 4)
    local damage = if isFinisher then math.round(ability.BaseDamage * 1.6) else ability.BaseDamage
    local knockback = if isFinisher then (rootPart.CFrame.LookVector * 35 + Vector3.new(0, 12, 0)) else (rootPart.CFrame.LookVector * 10)

    -- Broadcast to ElementalVFX Dispatcher
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Fire",
        Move = "M1",
        Character = character,
        Target = rootPart.Position + rootPart.CFrame.LookVector * 12,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual fiery slash arc (Finisher triggers circular fire slash wheel)
    if isFinisher then
        VFXBroadcastService.Broadcast("CircularSlashWheel", {
            CFrame = rootPart.CFrame * CFrame.new(0, 0, -3),
            Element = "Fire",
            Radius = 10,
            Count = 16,
            Duration = 0.35,
            SFXId = "rbxassetid://9114223170",
            Shake = 0.45,
        })
    else
        VFXBroadcastService.Broadcast("SlashArc", {
            CFrame = rootPart.CFrame * CFrame.new(0, 0, -2.5),
            Element = "Fire",
            Scale = 1.0,
            SFXId = ability.SFXId,
        })
    end

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, damage, knockback, step)
    end
end

-- Move 1: Scorching Fireball
function FireElement.CastMove1(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Fire", "1")
    if not ability then return end

    local spawnPos = rootPart.Position + (rootPart.CFrame.LookVector * 3)
    local dir = rootPart.CFrame.LookVector

    -- Simulate projectile raycast forward
    task.spawn(function()
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = { character }
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        local hitResult = Workspace:Raycast(spawnPos, dir * ability.Range, raycastParams)
        local impactPos = if hitResult then hitResult.Position else (spawnPos + dir * ability.Range)

        -- Broadcast to ElementalVFX Dispatcher
        VFXBroadcastService.Broadcast("ElementalMove", {
            Element = "Fire",
            Move = "Move1",
            Character = character,
            Target = impactPos,
            Direction = dir,
        })

        -- Visual fireball projectile with traveling flame sphere and burst on arrival
        VFXBroadcastService.Broadcast("Fireball", {
            StartPos = spawnPos,
            EndPos = impactPos,
            Duration = 0.35,
            SFXId = ability.SFXId,
            Shake = 0.4,
        })

        task.delay(0.32, function()
            VFXBroadcastService.Broadcast("CircularSlashWheel", {
                CFrame = CFrame.new(impactPos),
                Element = "Fire",
                Radius = 15,
                Count = 16,
                Duration = 0.38,
                SFXId = "rbxassetid://9114223170",
                Shake = 0.55,
            })
        end)

        local burstCFrame = CFrame.new(impactPos)
        local blastRadius = 15
        local targets = HitboxService.FindTargetsInCone(burstCFrame, blastRadius, 360, character)
        for _, target in targets do
            HitboxService.ApplyDamage(player, target, ability.BaseDamage, (target.RootPart.Position - impactPos).Unit * 25)
        end
    end)
end

-- Move 2: Infernal Beast
function FireElement.CastMove2(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Fire", "2")
    if not ability then return end

    local summonerHum = character:FindFirstChildOfClass("Humanoid")
    local maxHealth = if summonerHum then summonerHum.MaxHealth else 100
    local beastHealth = maxHealth * 0.25

    -- Create summon NPC model
    local beast = Instance.new("Model")
    beast.Name = player.Name .. "_InfernalBeast"

    local bRoot = Instance.new("Part")
    bRoot.Name = "HumanoidRootPart"
    bRoot.Size = Vector3.new(2, 2, 2)
    bRoot.Color = Color3.fromRGB(255, 69, 0)
    bRoot.Material = Enum.Material.Neon
    bRoot.CFrame = rootPart.CFrame * CFrame.new(3, 0, -3)
    bRoot.CanCollide = false
    bRoot.Parent = beast

    local bHum = Instance.new("Humanoid")
    bHum.MaxHealth = beastHealth
    bHum.Health = beastHealth
    bHum.WalkSpeed = 18
    bHum.Parent = beast

    beast.PrimaryPart = bRoot
    beast.Parent = Workspace:FindFirstChild("NPCs") or Workspace

    -- Broadcast to ElementalVFX Dispatcher
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Fire",
        Move = "Move2",
        Character = character,
        Target = bRoot.Position,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Beast auto-targeting loop
    local duration = ability.Duration or 15
    local alive = true

    task.spawn(function()
        local elapsed = 0
        while alive and elapsed < duration do
            task.wait(1.5)
            elapsed += 1.5
            if not beast.Parent or bHum.Health <= 0 then break end

            local target = HitboxService.FindClosestTargetInCone(bRoot.CFrame, 25, 360, beast)
            if target and target.Character ~= character then
                bHum:MoveTo(target.RootPart.Position)
                local dist = (target.RootPart.Position - bRoot.Position).Magnitude
                if dist <= 6 then
                    HitboxService.ApplyDamage(player, target, ability.BaseDamage, nil)
                end
            end
        end

        alive = false
        if beast.Parent then
            beast:Destroy()
        end
    end)

    Debris:AddItem(beast, duration + 1)
end

-- Move 3: Flames of Fury
function FireElement.CastMove3(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Fire", "3")
    if not ability then return end

    local target = HitboxService.FindClosestTargetInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    
    -- Goldi Chant
    local chant = "Flames of Fury, I command. Through heaven and earth, I am the Honoured One."
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local announceEvent = remotes:FindFirstChild(GameConfig.REMOTES.GLOBAL_ANNOUNCEMENT) :: RemoteEvent?
        if announceEvent then
            announceEvent:FireClient(player, "[Goldi]: " .. chant)
        end
    end

    if target and target.Character.Parent then
        -- Broadcast to ElementalVFX Dispatcher
        VFXBroadcastService.Broadcast("ElementalMove", {
            Element = "Fire",
            Move = "Move3",
            Character = character,
            Target = target.RootPart.Position,
            TargetCharacter = target.Model,
            Direction = rootPart.CFrame.LookVector,
        })

        -- Teleport behind target
        rootPart.CFrame = target.RootPart.CFrame * CFrame.new(0, 0, 4)

        -- Fiery circular slash wheel vortex around target
        VFXBroadcastService.Broadcast("CircularSlashWheel", {
            CFrame = CFrame.new(target.RootPart.Position),
            Element = "Fire",
            Radius = 12,
            Count = 16,
            Duration = 0.35,
            SFXId = "rbxassetid://9114223170",
            Shake = 0.5,
        })

        -- Fire beam at target
        VFXBroadcastService.Broadcast("Beam", {
            StartPos = rootPart.Position + Vector3.new(0, 1.5, 0),
            EndPos = target.RootPart.Position,
            Element = "Fire",
            Thickness = 1.8,
            Shake = 0.4,
            SFXId = ability.SFXId,
        })

        task.delay(0.2, function()
            if target.Character.Parent and target.Humanoid.Health > 0 then
                local knockback = rootPart.CFrame.LookVector * 45 + Vector3.new(0, 15, 0)
                HitboxService.ApplyDamage(player, target, ability.BaseDamage, knockback)
            end
        end)
    else
        -- Whiff action: Flame flash dash forward and searing fire slash wheel
        rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, -16)
        local beamEnd = rootPart.Position + (rootPart.CFrame.LookVector * ability.Range)
        VFXBroadcastService.Broadcast("CircularSlashWheel", {
            CFrame = rootPart.CFrame * CFrame.new(0, 0, -8),
            Element = "Fire",
            Radius = 11,
            Count = 14,
            Duration = 0.35,
            SFXId = "rbxassetid://9114223170",
            Shake = 0.4,
        })
        VFXBroadcastService.Broadcast("Beam", {
            StartPos = rootPart.Position + Vector3.new(0, 1.5, 0),
            EndPos = beamEnd,
            Element = "Fire",
            Thickness = 1.8,
            Shake = 0.4,
            SFXId = ability.SFXId,
        })
        VFXBroadcastService.Broadcast("Shockwave", {
            Position = rootPart.Position,
            Element = "Fire",
            Radius = 14,
            Duration = 0.35,
            Shake = 0.35,
            SFXId = ability.SFXId,
        })
    end
end

-- Move 4: Infernal Judgement (10s Domain)
function FireElement.CastMove4(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Fire", "4")
    if not ability then return end

    local domainCenter = rootPart.Position
    local domainRadius = 75
    local duration = ability.Duration or 10

    -- Rise above ground
    rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 12, 0)
    rootPart.Anchored = true

    -- Broadcast to ElementalVFX Dispatcher
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Fire",
        Move = "Move4",
        Character = character,
        Target = domainCenter,
        Duration = duration,
        Radius = domainRadius,
    })

    -- VFX: Converging charge wind-up, impact frame, massive eruption crater and shockwave
    VFXBroadcastService.Broadcast("ImpactFrame", {
        Duration = 0.08,
        Intensity = 1.2,
    })
    VFXBroadcastService.Broadcast("ConvergingCharge", {
        Position = domainCenter,
        Element = "Fire",
        Duration = 0.45,
    })
    VFXBroadcastService.Broadcast("Crater", {
        Position = domainCenter,
        Radius = 35,
        Element = "Fire",
        SFXId = ability.SFXId,
    })
    VFXBroadcastService.Broadcast("Shockwave", {
        Position = domainCenter,
        Element = "Fire",
        Radius = domainRadius,
        Duration = 0.6,
        Shake = 0.7,
        SFXId = ability.SFXId,
    })

    -- Visual Domain Boundary Part
    local domainPart = Instance.new("Part")
    domainPart.Name = "FireDomain_Boundary"
    domainPart.Shape = Enum.PartType.Cylinder
    domainPart.Size = Vector3.new(45, domainRadius * 2, domainRadius * 2)
    domainPart.CFrame = CFrame.new(domainCenter) * CFrame.Angles(0, 0, math.rad(90))
    domainPart.Transparency = 0.7
    domainPart.Color = Color3.fromRGB(255, 80, 0)
    domainPart.Material = Enum.Material.ForceField
    domainPart.Anchored = true
    domainPart.CanCollide = false
    domainPart.Parent = Workspace:FindFirstChild("VFX") or Workspace

    -- Tick damage and boundary containment loop
    local elapsed = 0
    task.spawn(function()
        while elapsed < duration and character.Parent do
            task.wait(1.0)
            elapsed += 1.0

            local targets = HitboxService.FindTargetsInCone(CFrame.new(domainCenter), domainRadius, 360, character)
            for _, t in targets do
                HitboxService.ApplyDamage(player, t, math.round(ability.BaseDamage / duration), nil)
                -- Clamp to boundary
                local offset = t.RootPart.Position - domainCenter
                if offset.Magnitude > domainRadius - 2 then
                    t.RootPart.Position = domainCenter + (offset.Unit * (domainRadius - 3))
                end
            end
        end

        -- Safe Cleanup
        if rootPart and rootPart.Parent then
            rootPart.Anchored = false
        end
        if domainPart.Parent then
            domainPart:Destroy()
        end
    end)
end

return table.freeze(FireElement)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">LightElement</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Light Element Implementation
    M1: Dim Light Ray
    1: Amplified Light (Piercing beam)
    2: Mirrors of Judgement (Mirror bounce slam)
    3: Blinding Attack (2-second blind effect + low damage)
    4: Divine Light Amplification (Massive amplified charge blast)
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConfig = require(ReplicatedStorage.Shared.Config.AbilityConfig)
local HitboxService = require(script.Parent.Parent.Services.HitboxService)
local StatusEffectService = require(script.Parent.Parent.Services.StatusEffectService)
local VFXBroadcastService = require(script.Parent.Parent.Services.VFXBroadcastService)

local LightElement = {}

-- M1: Dim Light Ray (4-hit combo support)
function LightElement.CastM1(player: Player, character: Model, rootPart: BasePart, comboStep: number?)
    local ability = AbilityConfig.GetAbility("Light", "M1")
    if not ability then return end

    local step = comboStep or 1
    local isFinisher = (step == 4)
    local damage = if isFinisher then math.round(ability.BaseDamage * 1.6) else ability.BaseDamage
    local knockback = if isFinisher then (rootPart.CFrame.LookVector * 35 + Vector3.new(0, 12, 0)) else (rootPart.CFrame.LookVector * 10)

    -- Broadcast to ElementalVFX Dispatcher
    local m1End = rootPart.Position + (rootPart.CFrame.LookVector * ability.Range)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Light",
        Move = "M1",
        Character = character,
        Target = m1End,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual dim light beam
    VFXBroadcastService.Broadcast("Beam", {
        StartPos = rootPart.Position + Vector3.new(0, 1.2, 0),
        EndPos = m1End,
        Element = "Light",
        Thickness = 0.7,
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, damage, knockback, step)
    end
end

-- Move 1: Amplified Light
function LightElement.CastMove1(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Light", "1")
    if not ability then return end

    local beamEnd = rootPart.Position + (rootPart.CFrame.LookVector * ability.Range)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Light",
        Move = "Move1",
        Character = character,
        Target = beamEnd,
        Direction = rootPart.CFrame.LookVector,
    })
    VFXBroadcastService.Broadcast("Beam", {
        StartPos = rootPart.Position + Vector3.new(0, 1.5, 0),
        EndPos = beamEnd,
        Element = "Light",
        Thickness = 2.0,
        Shake = 0.35,
        SFXId = ability.SFXId,
    })
    VFXBroadcastService.Broadcast("LightExplosion", {
        Position = beamEnd,
        Radius = 16,
        Duration = 0.45,
        SFXId = "rbxassetid://9114223170",
        Shake = 0.45,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, ability.BaseDamage, rootPart.CFrame.LookVector * 20)
    end
end

-- Move 2: Mirrors of Judgement
function LightElement.CastMove2(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Light", "2")
    if not ability then return end

    local target = HitboxService.FindClosestTargetInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    local mirrorPos = if target and target.Character.Parent then target.RootPart.Position else (rootPart.Position + rootPart.CFrame.LookVector * 14)

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Light",
        Move = "Move2",
        Character = character,
        Target = mirrorPos,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual crystalline mirrors with bouncing light rays and inward slam
    VFXBroadcastService.Broadcast("MirrorsOfJudgement", {
        Position = mirrorPos,
        SFXId = ability.SFXId,
        Shake = 0.5,
    })

    if target and target.Character.Parent then
        task.delay(0.35, function()
            if target.Character.Parent and target.Humanoid.Health > 0 then
                local slamVector = Vector3.new(0, -25, 0)
                HitboxService.ApplyDamage(player, target, ability.BaseDamage, slamVector)
                VFXBroadcastService.Broadcast("LightExplosion", {
                    Position = target.RootPart.Position,
                    Radius = 20,
                    Duration = 0.5,
                    SFXId = "rbxassetid://9114223170",
                    Shake = 0.55,
                })
            end
        end)
    end
end

-- Move 3: Blinding Attack (2s Blind Effect)
function LightElement.CastMove3(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Light", "3")
    if not ability then return end

    local flashPos = rootPart.Position + (rootPart.CFrame.LookVector * 10)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Light",
        Move = "Move3",
        Character = character,
        Target = flashPos,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Always broadcast blinding flash forward
    VFXBroadcastService.Broadcast("BlindingFlash", {
        Position = flashPos,
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, ability.BaseDamage, nil)
        -- Apply fair 2-second blindness status effect
        StatusEffectService.ApplyEffect(target.Character, "Blinded", ability.Duration or 2.0, player)
    end
end

-- Move 4: Divine Light Amplification
function LightElement.CastMove4(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Light", "4")
    if not ability then return end

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Light",
        Move = "Move4",
        Character = character,
        Target = rootPart.Position + rootPart.CFrame.LookVector * 30,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Broadcast converging charge during 0.4s wind-up
    VFXBroadcastService.Broadcast("ConvergingCharge", {
        Position = rootPart.Position,
        Element = "Light",
        Duration = 0.4,
    })

    -- Brief charge delay before releasing massive beam
    task.delay(0.4, function()
        if not character.Parent then return end

        local beamEnd = rootPart.Position + (rootPart.CFrame.LookVector * ability.Range)
        VFXBroadcastService.Broadcast("ImpactFrame", {
            Duration = 0.08,
            Intensity = 1.25,
        })
        VFXBroadcastService.Broadcast("Beam", {
            StartPos = rootPart.Position + Vector3.new(0, 1.5, 0),
            EndPos = beamEnd,
            Element = "Light",
            Thickness = 3.6,
            Shake = 0.65,
            SFXId = ability.SFXId,
        })
        VFXBroadcastService.Broadcast("LightExplosion", {
            Position = rootPart.Position + (rootPart.CFrame.LookVector * 18),
            Radius = 32,
            Duration = 0.65,
            SFXId = "rbxassetid://9114223170",
            Shake = 0.75,
        })
        VFXBroadcastService.Broadcast("LightExplosion", {
            Position = beamEnd,
            Radius = 26,
            Duration = 0.55,
            SFXId = "rbxassetid://9114223170",
            Shake = 0.6,
        })
        VFXBroadcastService.Broadcast("Shockwave", {
            Position = rootPart.Position,
            Element = "Light",
            Radius = 22,
            Duration = 0.45,
            Shake = 0.5,
            SFXId = ability.SFXId,
        })

        local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
        for _, target in targets do
            local blastKnock = rootPart.CFrame.LookVector * 50 + Vector3.new(0, 20, 0)
            HitboxService.ApplyDamage(player, target, ability.BaseDamage, blastKnock)
        end
    end)
end

return table.freeze(LightElement)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">TimeElement</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Time Element Implementation (Secret)
    M1: Time Punch (Blue aura high damage punch)
    1: Got Throwed (0.5s target freeze, teleport behind, heavy punch)
    2: Time Injection (Abstract time freeze & information overload)
    3: Untouchable (Invulnerability shield against incoming hits, usable while stunned)
    4: Virtual Kill (Ultimate instant KO finisher with 150s cooldown)
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConfig = require(ReplicatedStorage.Shared.Config.AbilityConfig)
local HitboxService = require(script.Parent.Parent.Services.HitboxService)
local StatusEffectService = require(script.Parent.Parent.Services.StatusEffectService)
local VFXBroadcastService = require(script.Parent.Parent.Services.VFXBroadcastService)

local TimeElement = {}

-- M1: Time Punch (4-hit combo support)
function TimeElement.CastM1(player: Player, character: Model, rootPart: BasePart, comboStep: number?)
    local ability = AbilityConfig.GetAbility("Time", "M1")
    if not ability then return end

    local step = comboStep or 1
    local isFinisher = (step == 4)
    local damage = if isFinisher then math.round(ability.BaseDamage * 1.6) else ability.BaseDamage
    local knockback = if isFinisher then (rootPart.CFrame.LookVector * 40 + Vector3.new(0, 15, 0)) else (rootPart.CFrame.LookVector * 15)

    -- Broadcast to ElementalVFX Dispatcher
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Time",
        Move = "M1",
        Character = character,
        Target = rootPart.Position + rootPart.CFrame.LookVector * 12,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual glowing clock dial aura on striking fist
    VFXBroadcastService.Broadcast("ClockAura", {
        Character = character,
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, damage, knockback, step)
    end
end

-- Move 1: Got Throwed
function TimeElement.CastMove1(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Time", "1")
    if not ability then return end

    local target = HitboxService.FindClosestTargetInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Time",
        Move = "Move1",
        Character = character,
        Target = if target and target.RootPart then target.RootPart.Position else (rootPart.Position + rootPart.CFrame.LookVector * 18),
        Direction = rootPart.CFrame.LookVector,
    })
    if target and target.Character.Parent then
        local tRoot = target.RootPart
        local tHum = target.Humanoid

        -- Freeze target for 0.5 seconds
        StatusEffectService.ApplyEffect(target.Character, "TimeStopped", 0.5, player)

        -- Teleport behind target
        rootPart.CFrame = tRoot.CFrame * CFrame.new(0, 0, 4)

        -- Land hard punch when freeze ends
        task.delay(0.5, function()
            if target.Character.Parent and tHum.Health > 0 then
                local punchKnock = rootPart.CFrame.LookVector * 40 + Vector3.new(0, 10, 0)
                HitboxService.ApplyDamage(player, target, ability.BaseDamage, punchKnock)

                VFXBroadcastService.Broadcast("Shockwave", {
                    Position = tRoot.Position,
                    Element = "Time",
                    Radius = 16,
                    Duration = 0.35,
                    Shake = 0.4,
                    SFXId = ability.SFXId,
                })
            end
        end)
    else
        -- Whiff action: Chronological high-speed dash forward with time rift shockwave
        rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, -18)
        VFXBroadcastService.Broadcast("Shockwave", {
            Position = rootPart.Position,
            Element = "Time",
            Radius = 14,
            Duration = 0.3,
            Shake = 0.35,
            SFXId = ability.SFXId,
        })
    end
end

-- Move 2: Time Injection (Abstract 2 years in 0.2s effect)
function TimeElement.CastMove2(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Time", "2")
    if not ability then return end

    local castPos = rootPart.Position + (rootPart.CFrame.LookVector * 12)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Time",
        Move = "Move2",
        Character = character,
        Target = castPos,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual abstract timeline streams & spinning clock rings
    VFXBroadcastService.Broadcast("TimeInjection", {
        Position = castPos,
        SFXId = ability.SFXId,
        Shake = 0.45,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        -- Brief time stop effect
        StatusEffectService.ApplyEffect(target.Character, "TimeStopped", 0.8, player)
        task.delay(0.2, function()
            if target.Character.Parent and target.Humanoid.Health > 0 then
                HitboxService.ApplyDamage(player, target, ability.BaseDamage, nil)
            end
        end)
    end
end

-- Move 3: Untouchable (Incoming attack invulnerability)
function TimeElement.CastMove3(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Time", "3")
    if not ability then return end

    local duration = ability.Duration or 4.0
    -- Applies Untouchable status: StatusEffectService.CanTakeDamage returns false!
    StatusEffectService.ApplyEffect(character, "Untouchable", duration, player)

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Time",
        Move = "Move3",
        Character = character,
        Duration = duration,
    })

    -- Visual revolving chronological forcefield with ethereal clock gears
    VFXBroadcastService.Broadcast("UntouchableBarrier", {
        Character = character,
        Duration = duration,
        SFXId = ability.SFXId,
    })
end

-- Move 4: Virtual Kill (Ultimate instant KO with 150s cooldown)
function TimeElement.CastMove4(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Time", "4")
    if not ability then return end

    local target = HitboxService.FindClosestTargetInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    local strikePos = if target and target.Character.Parent then target.RootPart.Position else (rootPart.Position + rootPart.CFrame.LookVector * 15)

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Time",
        Move = "Move4",
        Character = character,
        Target = strikePos,
        Direction = rootPart.CFrame.LookVector,
    })

    VFXBroadcastService.Broadcast("ConvergingCharge", {
        Position = rootPart.Position,
        Element = "Time",
        Duration = 0.4,
    })

    if target and target.Character.Parent then
        -- Time freeze during execution
        StatusEffectService.ApplyEffect(target.Character, "TimeStopped", 1.0, player)
    end

    task.delay(0.4, function()
        if not character.Parent then return end

        local strikePos = if target and target.Character.Parent then target.RootPart.Position else (rootPart.Position + rootPart.CFrame.LookVector * 15)

        VFXBroadcastService.Broadcast("ImpactFrame", {
            Duration = 0.1,
            Intensity = 1.5,
        })
        -- Visual colossal floor clock dial, vertical chronological beam and burst
        VFXBroadcastService.Broadcast("VirtualKill", {
            Position = strikePos,
            SFXId = ability.SFXId,
        })
        VFXBroadcastService.Broadcast("Shockwave", {
            Position = strikePos,
            Element = "Time",
            Radius = 75,
            Duration = 0.5,
            Shake = 0.7,
            SFXId = ability.SFXId,
        })

        if target and target.Character.Parent and target.Humanoid.Health > 0 then
            -- Instant KO under balance rules (deals max health as true damage)
            local killDamage = target.Humanoid.MaxHealth + 1000
            HitboxService.ApplyDamage(player, target, killDamage, rootPart.CFrame.LookVector * 50)
        end
    end)
end

return table.freeze(TimeElement)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">WindElement</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Wind Element Implementation
    M1: Compressed Wind (Lightning-bolt shaped wind projectile)
    1: Airy Vortex (Small tornado)
    2: The Cyclone of Fury (Pulls targets into vortex + high damage)
    3: Maximum Speed (5-second speed boost for escape/repositioning)
    4: Wind: Death Speed (Cinematic dive, rock ride, and lightning wind dash)
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AbilityConfig = require(ReplicatedStorage.Shared.Config.AbilityConfig)
local HitboxService = require(script.Parent.Parent.Services.HitboxService)
local StatusEffectService = require(script.Parent.Parent.Services.StatusEffectService)
local VFXBroadcastService = require(script.Parent.Parent.Services.VFXBroadcastService)

local WindElement = {}

-- M1: Compressed Wind (4-hit combo support)
function WindElement.CastM1(player: Player, character: Model, rootPart: BasePart, comboStep: number?)
    local ability = AbilityConfig.GetAbility("Wind", "M1")
    if not ability then return end

    local step = comboStep or 1
    local isFinisher = (step == 4)
    local damage = if isFinisher then math.round(ability.BaseDamage * 1.6) else ability.BaseDamage
    local knockback = if isFinisher then (rootPart.CFrame.LookVector * 40 + Vector3.new(0, 15, 0)) else (rootPart.CFrame.LookVector * 15)

    -- Broadcast to ElementalVFX Dispatcher
    local m1End = rootPart.Position + (rootPart.CFrame.LookVector * ability.Range)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Wind",
        Move = "M1",
        Character = character,
        Target = m1End,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual wind lightning projectile
    VFXBroadcastService.Broadcast("WindLightning", {
        StartPos = rootPart.Position + Vector3.new(0, 1.2, 0),
        EndPos = m1End,
        SFXId = ability.SFXId,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        HitboxService.ApplyDamage(player, target, damage, knockback, step)
    end
end

-- Move 1: Airy Vortex
function WindElement.CastMove1(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Wind", "1")
    if not ability then return end

    local spawnPos = rootPart.Position + (rootPart.CFrame.LookVector * 2)
    local endPos = rootPart.Position + (rootPart.CFrame.LookVector * ability.Range)

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Wind",
        Move = "Move1",
        Character = character,
        Target = endPos,
        Direction = rootPart.CFrame.LookVector,
    })

    -- Visual mini tornado traveling forward
    VFXBroadcastService.Broadcast("Tornado", {
        StartPos = spawnPos,
        EndPos = endPos,
        Duration = 0.45,
        SFXId = ability.SFXId,
        Shake = 0.35,
    })

    local targets = HitboxService.FindTargetsInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    for _, target in targets do
        local push = rootPart.CFrame.LookVector * 30 + Vector3.new(0, 10, 0)
        HitboxService.ApplyDamage(player, target, ability.BaseDamage, push)
    end
end

-- Move 2: The Cyclone of Fury
function WindElement.CastMove2(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Wind", "2")
    if not ability then return end

    local cycloneCenter = rootPart.Position + (rootPart.CFrame.LookVector * 10)
    local duration = ability.Duration or 4.0

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Wind",
        Move = "Move2",
        Character = character,
        Target = cycloneCenter,
        Duration = duration,
    })

    -- Visual massive swirling cyclone with suction particles
    VFXBroadcastService.Broadcast("Cyclone", {
        Position = cycloneCenter,
        Radius = ability.Range,
        Duration = duration,
        SFXId = ability.SFXId,
        Shake = 0.5,
    })

    local elapsed = 0
    task.spawn(function()
        while elapsed < duration and character.Parent do
            task.wait(0.5)
            elapsed += 0.5

            local targets = HitboxService.FindTargetsInCone(CFrame.new(cycloneCenter), ability.Range, 360, character)
            for _, target in targets do
                -- Pull toward cyclone center
                local toCenter = (cycloneCenter - target.RootPart.Position).Unit * 20
                target.RootPart:ApplyImpulse(toCenter * target.RootPart.AssemblyMass)
                HitboxService.ApplyDamage(player, target, math.round(ability.BaseDamage / (duration * 2)), nil)
            end
        end
    end)
end

-- Move 3: Maximum Speed (5s Speed Boost)
function WindElement.CastMove3(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Wind", "3")
    if not ability then return end

    local duration = ability.Duration or 5.0
    StatusEffectService.ApplyEffect(character, "SpeedBoost", duration, player)

    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Wind",
        Move = "Move3",
        Character = character,
        Duration = duration,
    })

    -- Visual sonic wind trails and foot ring emitters
    VFXBroadcastService.Broadcast("SpeedBoost", {
        Character = character,
        Duration = duration,
        SFXId = ability.SFXId,
    })
end

-- Move 4: Wind: Death Speed (Cinematic Sequence)
function WindElement.CastMove4(player: Player, character: Model, rootPart: BasePart)
    local ability = AbilityConfig.GetAbility("Wind", "4")
    if not ability then return end

    local target = HitboxService.FindClosestTargetInCone(rootPart.CFrame, ability.Range, ability.ConeAngle, character)
    VFXBroadcastService.Broadcast("ElementalMove", {
        Element = "Wind",
        Move = "Move4",
        Character = character,
        Target = if target and target.RootPart then target.RootPart.Position else (rootPart.Position + rootPart.CFrame.LookVector * 28),
        TargetCharacter = if target then target.Model else nil,
        Direction = rootPart.CFrame.LookVector,
    })

    if not target or not target.Character.Parent then
        -- Whiff action: Supersonic wind dive dash forward 28 studs with massive shockwave and crater
        rootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, -28)
        VFXBroadcastService.Broadcast("ImpactFrame", {
            Duration = 0.08,
            Intensity = 1.3,
        })
        VFXBroadcastService.Broadcast("Crater", {
            Position = rootPart.Position,
            Element = "Wind",
            Radius = 18,
            SFXId = ability.SFXId,
        })
        VFXBroadcastService.Broadcast("Shockwave", {
            Position = rootPart.Position,
            Element = "Wind",
            Radius = 26,
            Duration = 0.45,
            Shake = 0.65,
            SFXId = ability.SFXId,
        })
        return
    end

    local tRoot = target.RootPart
    local tHum = target.Humanoid

    -- Sequence Step 1: Lift target and caster into the air
    StatusEffectService.ApplyEffect(target.Character, "Stunned", 3.0, player)
    tRoot.CFrame = tRoot.CFrame * CFrame.new(0, 25, 0)
    rootPart.CFrame = tRoot.CFrame * CFrame.new(0, 5, 5)

    -- Sequence Step 2: Dive down quickly
    task.delay(0.5, function()
        if not target.Character.Parent or tHum.Health <= 0 then return end
        tRoot.CFrame = tRoot.CFrame * CFrame.new(0, -23, 0)
        rootPart.CFrame = tRoot.CFrame * CFrame.new(0, 2, -10)

        -- Sequence Step 3: Wind lightning bolt dash finisher
        task.delay(0.4, function()
            if target.Character.Parent and tHum.Health > 0 then
                local finalDashKnock = rootPart.CFrame.LookVector * 50 + Vector3.new(0, 15, 0)
                HitboxService.ApplyDamage(player, target, ability.BaseDamage, finalDashKnock)

                VFXBroadcastService.Broadcast("ImpactFrame", {
                    Duration = 0.08,
                    Intensity = 1.3,
                })
                VFXBroadcastService.Broadcast("Crater", {
                    Position = tRoot.Position,
                    Element = "Wind",
                    Radius = 16,
                    SFXId = ability.SFXId,
                })
                VFXBroadcastService.Broadcast("Shockwave", {
                    Position = tRoot.Position,
                    Element = "Wind",
                    Radius = 24,
                    Duration = 0.45,
                    Shake = 0.6,
                    SFXId = ability.SFXId,
                })
            end
        end)
    end)
end

return table.freeze(WindElement)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="41">
        <Properties>
          <string name="Name">ServerMain</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Master Server Entry Point
    Initializes: Remotes, Services, Map Generation, Monetization, Creator Perks,
    Player Lifecycles, Gamepass Ownership Checks, and Network Routing.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local PlayerDataService = require(script.Parent.Services.PlayerDataService)
local CooldownService = require(script.Parent.Services.CooldownService)
local CombatService = require(script.Parent.Services.CombatService)
local RNGSystem = require(script.Parent.Services.RNGSystem)
local AdminService = require(script.Parent.Services.AdminService)
local MapService = require(script.Parent.Services.MapService)
local MonetizationService = require(script.Parent.Services.MonetizationService)
local CreatorPerksService = require(script.Parent.Services.CreatorPerksService)

-- 1. Ensure Remotes folder and all events exist
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "Remotes"
    remotesFolder.Parent = ReplicatedStorage
end

local function GetOrCreateRemoteEvent(name: string): RemoteEvent
    local remote = remotesFolder:FindFirstChild(name) :: RemoteEvent?
    if not remote then
        remote = Instance.new("RemoteEvent")
        remote.Name = name
        remote.Parent = remotesFolder
    end
    return remote :: RemoteEvent
end

local function GetOrCreateRemoteFunction(name: string): RemoteFunction
    local remote = remotesFolder:FindFirstChild(name) :: RemoteFunction?
    if not remote then
        remote = Instance.new("RemoteFunction")
        remote.Name = name
        remote.Parent = remotesFolder
    end
    return remote :: RemoteFunction
end

-- Create all remote events
local castAbilityEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.CAST_ABILITY)
local abilityEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.ABILITY_EVENT)
local updateStatsEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.UPDATE_STATS)
local rollElementEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.ROLL_ELEMENT)
local globalAnnounceEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.GLOBAL_ANNOUNCEMENT)
local vfxTriggerEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.VFX_TRIGGER)
local soundTriggerEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.SOUND_TRIGGER)
local elementRolledEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.ELEMENT_ROLLED)
local adminCommandEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.ADMIN_COMMAND)
local openShopEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.OPEN_SHOP)
local fragmentCollectedEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.FRAGMENT_COLLECTED)
local mapTeleportEvent = GetOrCreateRemoteEvent(GameConfig.REMOTES.MAP_TELEPORT)

-- 2. Build World 1 Map & Preload 36 Ability VFX Models
MapService.BuildWorld1()
local VFXModelBuilder = require(ReplicatedStorage.Shared.Modules.VFXModelBuilder)
VFXModelBuilder.BuildAll()

-- 3. Remote Event Listeners

-- Combat abilities
castAbilityEvent.OnServerEvent:Connect(function(player: Player, slot: any, clientData: any)
    if type(slot) == "string" then
        CombatService.ProcessCast(player, slot, clientData)
    end
end)

-- Spin for element
rollElementEvent.OnServerEvent:Connect(function(player: Player)
    local profile = PlayerDataService.GetProfile(player)
    if not profile then return end

    -- Deduct spin ticket
    if profile.SpinTickets <= 0 then
        return
    end
    profile.SpinTickets -= 1

    local rolled = RNGSystem.RollElement(player)
    elementRolledEvent:FireClient(player, rolled)
    PlayerDataService.SyncClient(player)
end)

-- Admin commands via remote (from admin panel)
adminCommandEvent.OnServerEvent:Connect(function(player: Player, cmd: any, arg1: any, arg2: any)
    if type(cmd) == "string" then
        -- Reconstruct command string for AdminService
        local fullCmd = cmd
        if arg1 then fullCmd = fullCmd .. " " .. tostring(arg1) end
        if arg2 then fullCmd = fullCmd .. " " .. tostring(arg2) end
        AdminService.ExecuteCommand(player, fullCmd)
    end
end)

-- Map teleport
mapTeleportEvent.OnServerEvent:Connect(function(player: Player, worldId: any)
    if type(worldId) ~= "string" then return end
    local profile = PlayerDataService.GetProfile(player)
    if not profile then return end

    local hasWorld = profile.UnlockedWorlds[worldId]
    if not hasWorld then return end

    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return end

    -- Teleport to world spawn (MapService provides spawn positions)
    local spawnPos = MapService.GetWorldSpawn(worldId)
    root.CFrame = spawnPos
end)

-- 4. Player Lifecycle
local function OnPlayerAdded(player: Player)
    -- Load profile
    PlayerDataService.LoadProfile(player)

    -- Check gamepass ownership
    MonetizationService.CheckOwnershipOnJoin(player)

    -- Apply creator visuals if applicable
    CreatorPerksService.ApplyCreatorVisuals(player)

    -- Handle character spawns
    player.CharacterAdded:Connect(function(character)
        -- Wait for humanoid to exist
        local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
        if humanoid then
            -- Apply speed boost gamepass
            local profile = PlayerDataService.GetProfile(player)
            if profile and profile.GamePasses["SpeedBoost"] then
                humanoid.WalkSpeed = 19
                humanoid.JumpPower = 54
            end
        end

        PlayerDataService.ApplyLevelHealth(player)
        PlayerDataService.SyncClient(player)
        CreatorPerksService.ApplyCreatorVisuals(player)
    end)

    if player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local profile = PlayerDataService.GetProfile(player)
            if profile and profile.GamePasses["SpeedBoost"] then
                humanoid.WalkSpeed = 19
                humanoid.JumpPower = 54
            end
        end
        PlayerDataService.ApplyLevelHealth(player)
        PlayerDataService.SyncClient(player)
    end

    -- Legacy chat fallback for commands
    player.Chatted:Connect(function(msg)
        AdminService.ExecuteCommand(player, msg)
    end)
end

local function OnPlayerRemoving(player: Player)
    PlayerDataService.RemoveProfile(player)
    CooldownService.ClearPlayer(player)
end

Players.PlayerAdded:Connect(OnPlayerAdded)
Players.PlayerRemoving:Connect(OnPlayerRemoving)

-- Handle players already in server (Studio play test)
for _, player in Players:GetPlayers() do
    task.spawn(OnPlayerAdded, player)
end

-- Hook TextChatService for modern slash command handling
pcall(function()
    local tcs = game:GetService("TextChatService")
    tcs.MessageReceived:Connect(function(textChatMessage)
        local source = textChatMessage.TextSource
        if source then
            local sender = Players:GetPlayerByUserId(source.UserId)
            if sender then
                AdminService.ExecuteCommand(sender, textChatMessage.Text)
            end
        end
    end)
end)

print("[Elemental Worlds] Server initialized — Map, Monetization, Creator Perks, Saving, and Remotes ready.")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Admin & Owner Command Service
    Authenticates Owner strictly by numeric UserId (6225357795).
    Resolves admin usernames to immutable UserIds.
    Prevents admins from targeting the owner or executing owner-only commands.
]]

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local AdminConfig = require(ReplicatedStorage.Shared.Config.AdminConfig)
local PlayerDataService = require(script.Parent.PlayerDataService)
local RNGSystem = require(script.Parent.RNGSystem)
local RaidService = require(script.Parent.RaidService)

local AdminService = {}

-- Set of authorized admin UserIds (resolved at runtime)
local authorizedAdminUserIds: { [number]: boolean } = {}
local bannedUserIds: { [number]: boolean } = {}

-- Resolve initial admin usernames to numeric UserIds
local function ResolveInitialAdmins()
    for _, username in AdminConfig.INITIAL_ADMIN_USERNAMES do
        task.spawn(function()
            local success, userId = pcall(function()
                return Players:GetUserIdFromNameAsync(username)
            end)
            if success and userId and userId ~= GameConfig.OWNER_USER_ID then
                authorizedAdminUserIds[userId] = true
            end
        end)
    end
end
ResolveInitialAdmins()

function AdminService.IsOwner(player: Player): boolean
    return player.UserId == GameConfig.OWNER_USER_ID
end

function AdminService.IsAdmin(player: Player): boolean
    if AdminService.IsOwner(player) then
        return true
    end
    return authorizedAdminUserIds[player.UserId] == true
end

-- Find a connected player by name fragment
local function FindPlayerByName(name: string): Player?
    name = string.lower(name)
    for _, player in Players:GetPlayers() do
        if string.lower(player.Name) == name or string.find(string.lower(player.Name), name) == 1 then
            return player
        end
    end
    return nil
end

-- Process command string from player
function AdminService.ExecuteCommand(sender: Player, message: string): boolean
    if not string.find(message, "^/") then
        return false -- Not a command
    end

    local tokens = string.split(message, " ")
    local cmd = string.lower(tokens[1])
    local isOwner = AdminService.IsOwner(sender)
    local isAdmin = AdminService.IsAdmin(sender)

    if not isAdmin then
        return false -- Unauthorized
    end

    -- Check if it is an owner-only command
    if AdminConfig.OWNER_ONLY_COMMANDS[cmd] and not isOwner then
        warn(string.format("[AdminService] %s attempted unauthorized owner command: %s", sender.Name, cmd))
        return false
    end

    -- ==================== OWNER-ONLY COMMANDS ====================
    if isOwner then
        if cmd == "/addadmin" then
            local targetName = tokens[2]
            if targetName then
                local success, targetId = pcall(function() return Players:GetUserIdFromNameAsync(targetName) end)
                if success and targetId and targetId ~= GameConfig.OWNER_USER_ID then
                    authorizedAdminUserIds[targetId] = true
                    print(string.format("[AdminService] Added admin: %s (%d)", targetName, targetId))
                end
            end
            return true
        elseif cmd == "/removeadmin" then
            local targetName = tokens[2]
            if targetName then
                local success, targetId = pcall(function() return Players:GetUserIdFromNameAsync(targetName) end)
                if success and targetId then
                    authorizedAdminUserIds[targetId] = nil
                    print(string.format("[AdminService] Removed admin: %s (%d)", targetName, targetId))
                end
            end
            return true
        elseif cmd == "/kick" then
            local target = FindPlayerByName(tokens[2] or "")
            if target and target.UserId ~= GameConfig.OWNER_USER_ID then
                target:Kick(tokens[3] or "Kicked by Owner.")
            end
            return true
        elseif cmd == "/ban" then
            local targetName = tokens[2]
            if targetName then
                local success, targetId = pcall(function() return Players:GetUserIdFromNameAsync(targetName) end)
                if success and targetId and targetId ~= GameConfig.OWNER_USER_ID then
                    bannedUserIds[targetId] = true
                    local target = Players:GetPlayerByUserId(targetId)
                    if target then target:Kick("Banned by Owner.") end
                end
            end
            return true
        elseif cmd == "/unban" then
            local targetName = tokens[2]
            if targetName then
                local success, targetId = pcall(function() return Players:GetUserIdFromNameAsync(targetName) end)
                if success and targetId then
                    bannedUserIds[targetId] = nil
                end
            end
            return true
        elseif cmd == "/setcharges" then
            local target = FindPlayerByName(tokens[2] or "")
            local amount = tonumber(tokens[3])
            if target and amount then
                PlayerDataService.SetCharges(target, amount)
            end
            return true
        elseif cmd == "/resetrng" then
            RNGSystem.ResetRates(sender)
            return true
        elseif cmd == "/kill" then
            local target = FindPlayerByName(tokens[2] or "")
            if target and target.UserId ~= GameConfig.OWNER_USER_ID and target.Character then
                local hum = target.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 end
            end
            return true
        elseif cmd == "/tp" then
            local target = FindPlayerByName(tokens[2] or "")
            if target and target.Character and sender.Character then
                local tRoot = target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
                local sRoot = sender.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
                if tRoot and sRoot then
                    sRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                end
            end
            return true
        elseif cmd == "/bring" then
            local target = FindPlayerByName(tokens[2] or "")
            if target and target.UserId ~= GameConfig.OWNER_USER_ID and target.Character and sender.Character then
                local tRoot = target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
                local sRoot = sender.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
                if tRoot and sRoot then
                    tRoot.CFrame = sRoot.CFrame * CFrame.new(0, 0, -3)
                end
            end
            return true
        end
    end

    -- ==================== ADMIN & OWNER COMMANDS ====================
    if cmd == "/givelevel" then
        local target = FindPlayerByName(tokens[2] or "")
        local amount = tonumber(tokens[3]) or 1
        if target then
            PlayerDataService.AddLevel(target, amount)
        end
        return true
    elseif cmd == "/removelevel" then
        local target = FindPlayerByName(tokens[2] or "")
        local amount = tonumber(tokens[3]) or 1
        if target then
            PlayerDataService.AddLevel(target, -amount)
        end
        return true
    elseif cmd == "/setlevel" then
        local target = FindPlayerByName(tokens[2] or "")
        local level = tonumber(tokens[3])
        if target and level then
            PlayerDataService.SetLevel(target, level)
        end
        return true
    elseif cmd == "/givecharges" then
        local target = FindPlayerByName(tokens[2] or "")
        local amount = tonumber(tokens[3]) or 10
        if target then
            PlayerDataService.AddCharges(target, amount)
        end
        return true
    elseif cmd == "/removecharges" then
        local target = FindPlayerByName(tokens[2] or "")
        local amount = tonumber(tokens[3]) or 10
        if target then
            PlayerDataService.AddCharges(target, -amount)
        end
        return true
    elseif cmd == "/giveelement" then
        local target = FindPlayerByName(tokens[2] or "")
        local elemName = tokens[3]
        local validElements = { Fire = true, Aqua = true, Earth = true, Light = true, Wind = true, Error = true, Time = true }
        if target and elemName and validElements[elemName] then
            PlayerDataService.SetElement(target, elemName :: GameConfig.ElementType)
        end
        return true
    elseif cmd == "/givespins" then
        local target = FindPlayerByName(tokens[2] or "")
        local amount = tonumber(tokens[3]) or 1
        if target then
            PlayerDataService.AddSpinTickets(target, amount)
        end
        return true
    elseif cmd == "/heal" then
        local target = FindPlayerByName(tokens[2] or "")
        if target and target.Character then
            local hum = target.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Health = hum.MaxHealth
            end
        end
        return true
    elseif cmd == "/raid" then
        if tokens[2] == "start" then
            RaidService.StartRaid(sender)
        end
        return true
    elseif cmd == "/announce" then
        local announcement = table.concat(tokens, " ", 2)
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            local announceEvent = remotes:FindFirstChild(GameConfig.REMOTES.GLOBAL_ANNOUNCEMENT) :: RemoteEvent?
            if announceEvent then
                announceEvent:FireAllClients(string.format("[ANNOUNCEMENT] %s", announcement))
            end
        end
        return true
    end

    return false
end

-- Check bans on player joining
Players.PlayerAdded:Connect(function(player)
    if bannedUserIds[player.UserId] and player.UserId ~= GameConfig.OWNER_USER_ID then
        player:Kick("You are banned from Elemental Worlds.")
    end
end)

return table.freeze(AdminService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Combat Service
    Server-authoritative router for player ability casts.
    Validates cooldowns, stuns, elements, error meters, and combo steps.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local AbilityConfig = require(ReplicatedStorage.Shared.Config.AbilityConfig)
local CooldownService = require(script.Parent.CooldownService)
local StatusEffectService = require(script.Parent.StatusEffectService)
local PlayerDataService = require(script.Parent.PlayerDataService)

-- Element handlers
local FireElement = require(script.Parent.Parent.Elements.FireElement)
local AquaElement = require(script.Parent.Parent.Elements.AquaElement)
local EarthElement = require(script.Parent.Parent.Elements.EarthElement)
local LightElement = require(script.Parent.Parent.Elements.LightElement)
local WindElement = require(script.Parent.Parent.Elements.WindElement)
local ErrorElement = require(script.Parent.Parent.Elements.ErrorElement)
local TimeElement = require(script.Parent.Parent.Elements.TimeElement)

local CombatService = {}

local elementHandlers: { [string]: any } = {
    Fire = FireElement,
    Aqua = AquaElement,
    Earth = EarthElement,
    Light = LightElement,
    Wind = WindElement,
    Error = ErrorElement,
    Time = TimeElement,
}

function CombatService.ProcessCast(player: Player, slot: string, clientData: any?)
    local char = player.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not humanoid or humanoid.Health <= 0 or not rootPart then
        return
    end

    local profile = PlayerDataService.GetProfile(player)
    if not profile then return end

    local element = profile.Element
    local ability = AbilityConfig.GetAbility(element, slot)
    if not ability then
        return
    end

    -- 1. Cooldown Check
    local isOnCooldown, remainingTime = CooldownService.IsOnCooldown(player, slot)
    if isOnCooldown then
        return
    end

    -- 2. Stun Check
    if not ability.CanCastWhileStunned and not StatusEffectService.CanCastAbilities(char) then
        return
    end

    -- 3. Error Meter Check
    if ability.ErrorMeterCost and ability.ErrorMeterCost > 0 then
        if profile.ErrorMeter < ability.ErrorMeterCost then
            return
        end
    end

    -- Extract optional combo step for M1 (1, 2, 3, 4)
    local comboStep = 1
    if clientData and type(clientData) == "table" and type(clientData.ComboStep) == "number" then
        comboStep = math.clamp(math.floor(clientData.ComboStep), 1, 4)
    end

    -- M1 has a shorter internal cooldown (0.28s) to allow fluid combo chaining, while move 4 finisher adds slightly more
    local cooldown = if slot == "M1" then (if comboStep == 4 then 0.75 else 0.28) else ability.Cooldown
    CooldownService.StartCooldown(player, slot, cooldown)

    -- Notify client to trigger local animation and start visual cooldown timer
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local abilityRemote = remotes:FindFirstChild(GameConfig.REMOTES.ABILITY_EVENT) :: RemoteEvent?
        if abilityRemote then
            abilityRemote:FireClient(player, slot, cooldown, ability.AnimationId, ability.AnimationMarker)
        end
    end

    -- Route to Element Handler
    local handler = elementHandlers[element]
    if handler then
        if slot == "M1" and handler.CastM1 then
            handler.CastM1(player, char, rootPart, comboStep)
        else
            local methodName = "CastMove" .. slot
            if handler[methodName] then
                handler[methodName](player, char, rootPart)
            end
        end
    end
end

return table.freeze(CombatService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">CooldownService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Cooldown Service
    Server-authoritative cooldown management per player per ability slot.
]]

local CooldownService = {}

-- Map of [UserId][Slot] = ExpiryTimestamp (os.clock())
local activeCooldowns: { [number]: { [string]: number } } = {}

function CooldownService.IsOnCooldown(player: Player, slot: string): (boolean, number)
    local userCooldowns = activeCooldowns[player.UserId]
    if not userCooldowns then
        return false, 0
    end

    local expiryTime = userCooldowns[slot]
    if not expiryTime then
        return false, 0
    end

    local currentTime = os.clock()
    if currentTime < expiryTime then
        return true, expiryTime - currentTime
    end

    -- Expired
    userCooldowns[slot] = nil
    return false, 0
end

function CooldownService.StartCooldown(player: Player, slot: string, durationSeconds: number)
    local userId = player.UserId
    if not activeCooldowns[userId] then
        activeCooldowns[userId] = {}
    end

    activeCooldowns[userId][slot] = os.clock() + durationSeconds
end

function CooldownService.ResetCooldown(player: Player, slot: string)
    local userCooldowns = activeCooldowns[player.UserId]
    if userCooldowns then
        userCooldowns[slot] = nil
    end
end

function CooldownService.ClearPlayer(player: Player)
    activeCooldowns[player.UserId] = nil
end

return table.freeze(CooldownService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">CreatorPerksService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Creator Perks Service (Blox Fruits Modern Design)
    Applies modern, high-end prestige visuals to the owner (coolzgamer9 / UserId 6225357795)
    and VIP gamepass holders.
    
    Aesthetic rules:
    - NO rainbow color cycling
    - NO tacky gold models or spinning cylinders
    - Modern dark obsidian-navy badges with electric indigo/cyan glow
    - Minimalist ambient body auras and particle trails
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local PlayerDataService = require(script.Parent.PlayerDataService)

local CreatorPerksService = {}

-- Modern Blox Fruits style color tokens
local CREATOR_ACCENT = Color3.fromRGB(130, 95, 255)   -- Electric Astral Purple
local VIP_ACCENT = Color3.fromRGB(0, 170, 255)        -- Electric Royal Azure
local BADGE_BG = Color3.fromRGB(10, 14, 22)           -- Obsidian Navy
local TEXT_COLOR = Color3.fromRGB(245, 248, 255)       -- Crisp White

-- Creates a sleek, modern overhead title badge (Blox Fruits style)
local function CreateOverheadBadge(character: Model, prefix: string, playerName: string, accentColor: Color3)
    local head = character:FindFirstChild("Head") :: BasePart?
    if not head then return end

    -- Clean up any existing badge
    local existing = head:FindFirstChild("OverheadBadgeGui")
    if existing then existing:Destroy() end

    local billGui = Instance.new("BillboardGui")
    billGui.Name = "OverheadBadgeGui"
    billGui.Size = UDim2.new(0, 210, 0, 36)
    billGui.StudsOffset = Vector3.new(0, 2.8, 0)
    billGui.AlwaysOnTop = false
    billGui.MaxDistance = 80
    billGui.Parent = head

    local container = Instance.new("Frame")
    container.Name = "Container"
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundColor3 = BADGE_BG
    container.BackgroundTransparency = 0.12
    container.Parent = billGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = container

    local stroke = Instance.new("UIStroke")
    stroke.Color = accentColor
    stroke.Thickness = 1.8
    stroke.Transparency = 0.1
    stroke.Parent = container

    -- Title tag (e.g. [ CREATOR ] or [ VIP ])
    local tagLabel = Instance.new("TextLabel")
    tagLabel.Name = "Tag"
    tagLabel.Size = UDim2.new(0, 90, 1, 0)
    tagLabel.Position = UDim2.new(0, 8, 0, 0)
    tagLabel.BackgroundTransparency = 1
    tagLabel.Font = Enum.Font.GothamBlack
    tagLabel.TextSize = 12
    tagLabel.TextColor3 = accentColor
    tagLabel.TextXAlignment = Enum.TextXAlignment.Left
    tagLabel.Text = prefix
    tagLabel.Parent = container

    -- Player name
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "PlayerName"
    nameLabel.Size = UDim2.new(1, -100, 1, 0)
    nameLabel.Position = UDim2.new(0, 95, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 12
    nameLabel.TextColor3 = TEXT_COLOR
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Text = playerName
    nameLabel.Parent = container

    -- Subtle breathing stroke animation
    task.spawn(function()
        while container.Parent do
            local t1 = TweenService:Create(stroke, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Thickness = 2.4, Transparency = 0 })
            local t2 = TweenService:Create(stroke, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Thickness = 1.5, Transparency = 0.3 })
            t1:Play()
            t1.Completed:Wait()
            t2:Play()
            t2.Completed:Wait()
        end
    end)
end

-- Attaches a sleek modern ambient aura (PointLight + gentle energy particles)
local function AttachModernAura(character: Model, color: Color3, isCreator: boolean)
    local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not rootPart then return end

    -- Remove any old lights
    local oldLight = rootPart:FindFirstChild("ModernAuraLight")
    if oldLight then oldLight:Destroy() end
    local oldAttach = rootPart:FindFirstChild("ModernAuraAttach")
    if oldAttach then oldAttach:Destroy() end

    -- Ambient PointLight
    local light = Instance.new("PointLight")
    light.Name = "ModernAuraLight"
    light.Color = color
    light.Range = if isCreator then 16 else 12
    light.Brightness = if isCreator then 1.5 else 1.0
    light.Parent = rootPart

    -- Subtle particle attachment
    local attach = Instance.new("Attachment")
    attach.Name = "ModernAuraAttach"
    attach.Position = Vector3.new(0, -1.5, 0)
    attach.Parent = rootPart

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "PrestigeParticles"
    emitter.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.4, color),
        ColorSequenceKeypoint.new(1, color),
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4),
        NumberSequenceKeypoint.new(0.8, 0.6),
        NumberSequenceKeypoint.new(1, 1),
    })
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.5),
        NumberSequenceKeypoint.new(1, 0),
    })
    emitter.Rate = if isCreator then 12 else 6
    emitter.Speed = NumberRange.new(2, 4)
    emitter.SpreadAngle = Vector2.new(20, 20)
    emitter.Lifetime = NumberRange.new(0.8, 1.4)
    emitter.LightEmission = 0.9
    emitter.LightInfluence = 0
    emitter.VelocitySpread = 20
    emitter.Parent = attach
end

function CreatorPerksService.ApplyCreatorVisuals(player: Player)
    local char = player.Character
    if not char then return end

    local isOwner = (player.UserId == GameConfig.OWNER_USER_ID)
    local profile = PlayerDataService.GetProfile(player)
    local hasVIP = profile and profile.GamePasses["VIPMaster"] or false

    if isOwner then
        -- Creator aura (subtle ambient lighting only, no overhead card)
        AttachModernAura(char, CREATOR_ACCENT, true)
    elseif hasVIP then
        -- VIP aura
        AttachModernAura(char, VIP_ACCENT, false)
    end
end

return table.freeze(CreatorPerksService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">HitboxService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Hitbox & Target Resolution Service
    Authoritative spatial queries supporting Players and NPCs in nested folders.
    MANDATORY: Directional verification via CombatHelper guarantees no damage to targets behind or outside cone.
    Replicates visual impact bursts, 3D damage numbers, and combo counters to clients.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local CombatHelper = require(ReplicatedStorage.Shared.Modules.CombatHelper)
local StatusEffectService = require(script.Parent.StatusEffectService)
local PlayerDataService = require(script.Parent.PlayerDataService)

export type ValidTarget = {
    Character: Model,
    Humanoid: Humanoid,
    RootPart: BasePart,
}

local HitboxService = {}

-- Collect all potential combat characters in workspace (Players and nested NPCs)
local function GetAllCombatants(ignoreCharacter: Model?): { Model }
    local combatants: { Model } = {}

    -- 1. Check all connected players
    for _, player in Players:GetPlayers() do
        local char = player.Character
        if char and char ~= ignoreCharacter then
            table.insert(combatants, char)
        end
    end

    -- 2. Check NPCs folder (including any nested subfolders)
    local npcsFolder = Workspace:FindFirstChild("NPCs")
    if npcsFolder then
        for _, desc in npcsFolder:GetDescendants() do
            if desc:IsA("Model") and desc ~= ignoreCharacter and desc:FindFirstChildOfClass("Humanoid") then
                table.insert(combatants, desc)
            end
        end
    end

    -- 3. Check Workspace direct children for generic enemy models
    for _, child in Workspace:GetChildren() do
        if child:IsA("Model") and child ~= ignoreCharacter and not Players:GetPlayerFromCharacter(child) then
            if child:FindFirstChildOfClass("Humanoid") and child:FindFirstChild("HumanoidRootPart") then
                table.insert(combatants, child)
            end
        end
    end

    return combatants
end

-- Finds all valid targets within a directional cone and range
function HitboxService.FindTargetsInCone(
    attackerCFrame: CFrame,
    maxRange: number,
    maxConeAngle: number,
    attackerCharacter: Model?
): { ValidTarget }
    local targets: { ValidTarget } = {}
    local combatants = GetAllCombatants(attackerCharacter)

    for _, candidate in combatants do
        local isAlive, humanoid = CombatHelper.IsAlive(candidate)
        if isAlive and humanoid then
            local rootPart = candidate:FindFirstChild("HumanoidRootPart") :: BasePart?
            if rootPart then
                -- CRITICAL: Validates both distance and look-direction cone
                local isValid = CombatHelper.ValidateHit(attackerCFrame, rootPart, maxRange, maxConeAngle)
                if isValid then
                    table.insert(targets, {
                        Character = candidate,
                        Humanoid = humanoid,
                        RootPart = rootPart,
                    })
                end
            end
        end
    end

    return targets
end

-- Finds a single closest target in cone
function HitboxService.FindClosestTargetInCone(
    attackerCFrame: CFrame,
    maxRange: number,
    maxConeAngle: number,
    attackerCharacter: Model?
): ValidTarget?
    local targets = HitboxService.FindTargetsInCone(attackerCFrame, maxRange, maxConeAngle, attackerCharacter)
    local closest: ValidTarget? = nil
    local minDistance = math.huge

    for _, target in targets do
        local dist = (target.RootPart.Position - attackerCFrame.Position).Magnitude
        if dist < minDistance then
            minDistance = dist
            closest = target
        end
    end

    return closest
end

-- Authoritatively deals damage and replicates visual / audio feedback
function HitboxService.ApplyDamage(
    attackerPlayer: Player?,
    target: ValidTarget,
    baseDamage: number,
    knockbackVector: Vector3?,
    comboStep: number?
): boolean
    local targetChar = target.Character
    local humanoid = target.Humanoid

    -- 1. Check if target can take damage (checks Untouchable & GotGlitched)
    if not StatusEffectService.CanTakeDamage(targetChar) then
        return false -- Invulnerable!
    end

    -- 2. Check if Water Dragon transformation is active on target (ends on hit + burst)
    if StatusEffectService.HasEffect(targetChar, "WaterDragon") then
        StatusEffectService.RemoveEffect(targetChar, "WaterDragon")
        local burstTargets = HitboxService.FindTargetsInCone(target.RootPart.CFrame, 15, 360, targetChar)
        for _, bTarget in burstTargets do
            bTarget.Humanoid:TakeDamage(15)
        end
    end

    -- 3. Calculate scaled damage based on attacker's level
    local attackerLevel = 1
    local attackerElement = "Fire"
    if attackerPlayer then
        local profile = PlayerDataService.GetProfile(attackerPlayer)
        if profile then
            attackerLevel = profile.Level
            attackerElement = profile.Element

            -- If using Error element M1, add +5% to Error Meter on valid hit
            if profile.Element == "Error" then
                PlayerDataService.AddErrorMeter(attackerPlayer, 5)
            end
        end
    end

    local finalDamage = CombatHelper.CalculateDamage(baseDamage, attackerLevel)
    humanoid:TakeDamage(finalDamage)

    -- 4. Replicate Visual Burst & Floating 3D Damage Numbers to clients
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local vfxEvent = remotes:FindFirstChild(GameConfig.REMOTES.VFX_TRIGGER) :: RemoteEvent?
        if vfxEvent then
            local isCrit = (comboStep == 4)
            -- 3D Damage Number
            vfxEvent:FireAllClients("DamageNumber", {
                Position = target.RootPart.Position,
                Damage = finalDamage,
                Element = attackerElement,
                IsCrit = isCrit,
            })
            -- Impact Particle Burst & Shake
            vfxEvent:FireAllClients("ImpactBurst", {
                Position = target.RootPart.Position,
                Element = attackerElement,
                Count = if isCrit then 45 else 25,
                Shake = if isCrit then 0.4 else 0.2,
                SFXId = if isCrit then "rbxassetid://3041191430" else "rbxassetid://1720389178",
            })

            -- Finisher Slash Arc
            if isCrit then
                vfxEvent:FireAllClients("SlashArc", {
                    CFrame = target.RootPart.CFrame,
                    Element = attackerElement,
                    Scale = 1.3,
                    SFXId = "rbxassetid://6760643020",
                })
            end

            -- Combo Hit Counter to attacker
            if attackerPlayer and comboStep then
                vfxEvent:FireClient(attackerPlayer, "ComboHit", { Count = comboStep })
            end
        end
    end

    -- 5. Apply knockback impulse
    if knockbackVector and target.RootPart and not target.RootPart.Anchored then
        target.RootPart:ApplyImpulse(knockbackVector * target.RootPart.AssemblyMass)
    end

    return true
end

return table.freeze(HitboxService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Map & Environment Service
    Configures Anime Lighting, validates Workspace named folder hierarchy,
    and sets up functional gameplay interactive objects (World Fragments,
    Raid Entrance Portal, and Combat Training Dummies) without placing crude procedural geometry.

    Follows the Game Designer specification:
    - Designer builds the map and assets in:
      Workspace.Map.Village, Workspace.Map.Forest, Workspace.Map.Cave, Workspace.Map.Ruins
    - Scripts provide clean folders, interactive hooks, and target dummies.
]]

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local PlayerDataService = require(script.Parent.PlayerDataService)
local RaidService = require(script.Parent.RaidService)

local MapService = {}

-- Configures high-end modern anime lighting (Unified Anime RPG Preset)
local function SetupAnimeLighting()
    Lighting.ClockTime = 14.2
    Lighting.Brightness = 2.1
    Lighting.ExposureCompensation = -0.05
    Lighting.GlobalShadows = true
    pcall(function() Lighting.ShadowSoftness = 0.25 end)
    pcall(function() Lighting.EnvironmentDiffuseScale = 0.40 end)
    pcall(function() Lighting.EnvironmentSpecularScale = 0.25 end)

    Lighting.Ambient = Color3.fromRGB(84, 94, 110)
    Lighting.OutdoorAmbient = Color3.fromRGB(139, 148, 164)
    Lighting.ColorShift_Top = Color3.fromRGB(255, 248, 238)
    Lighting.ColorShift_Bottom = Color3.fromRGB(213, 225, 240)

    -- Atmosphere
    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atmosphere then
        atmosphere = Instance.new("Atmosphere")
        atmosphere.Name = "AnimeAtmosphere"
        atmosphere.Parent = Lighting
    end
    atmosphere.Density = 0.20
    atmosphere.Offset = 0.20
    atmosphere.Haze = 0.70
    atmosphere.Glare = 0.08
    atmosphere.Color = Color3.fromRGB(199, 222, 255)
    atmosphere.Decay = Color3.fromRGB(112, 130, 157)

    -- ColorCorrection for anime vibrancy
    local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "AnimeColorCorrection"
        cc.Parent = Lighting
    end
    cc.Brightness = -0.02
    cc.Contrast = 0.08
    cc.Saturation = 0.06
    cc.TintColor = Color3.fromRGB(255, 248, 241)

    -- BloomEffect tuned to prevent text blooming/blinding glare while preserving vibrant VFX
    local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
    if not bloom then
        bloom = Instance.new("BloomEffect")
        bloom.Name = "AnimeBloom"
        bloom.Parent = Lighting
    end
    bloom.Intensity = 0.18
    bloom.Size = 24
    bloom.Threshold = 1.5

    -- SunRays for anime atmosphere
    local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect")
    if not sunRays then
        sunRays = Instance.new("SunRaysEffect")
        sunRays.Name = "AnimeSunRays"
        sunRays.Parent = Lighting
    end
    sunRays.Intensity = 0.025
    sunRays.Spread = 0.65
end

-- World spawn positions
local WORLD_SPAWNS: { [string]: CFrame } = {
    World1 = CFrame.new(0, 4, 0),
    World2 = CFrame.new(0, 4, 0),
    World3 = CFrame.new(0, 4, 0),
}

function MapService.GetWorldSpawn(worldId: string): CFrame
    return WORLD_SPAWNS[worldId] or CFrame.new(0, 4, 0)
end

local function EnsureFolder(parent: Instance, name: string): Folder
    local folder = parent:FindFirstChild(name) :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = parent
    end
    return folder :: Folder
end

-- Spawns an interactive collectable World Fragment with spinning neon visual and ProximityPrompt
local function SpawnWorldFragment(id: string, name: string, pos: Vector3, parentFolder: Instance)
    local existing = parentFolder:FindFirstChild("WorldFragment_" .. id)
    if existing then return end

    local fragModel = Instance.new("Model")
    fragModel.Name = "WorldFragment_" .. id

    local gem = Instance.new("Part")
    gem.Name = "FragmentGem"
    gem.Size = Vector3.new(3, 4.5, 3)
    gem.Color = Color3.fromRGB(0, 220, 255)
    gem.Material = Enum.Material.Neon
    gem.Anchored = true
    gem.CanCollide = false
    gem.CFrame = CFrame.new(pos)
    gem.Parent = fragModel

    local inner = Instance.new("Part")
    inner.Name = "InnerOrb"
    inner.Size = Vector3.new(1.8, 1.8, 1.8)
    inner.Shape = Enum.PartType.Ball
    inner.Color = Color3.fromRGB(180, 245, 255)
    inner.Material = Enum.Material.Neon
    inner.Anchored = true
    inner.CanCollide = false
    inner.CFrame = CFrame.new(pos)
    inner.Parent = fragModel

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(0, 220, 255)
    light.Range = 20
    light.Brightness = 2.5
    light.Parent = gem

    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Collect Fragment"
    prompt.ObjectText = name
    prompt.HoldDuration = 1.0
    prompt.MaxActivationDistance = 14
    prompt.RequiresLineOfSight = false
    prompt.Parent = gem

    prompt.Triggered:Connect(function(player)
        local success = PlayerDataService.CollectFragment(player, id)
        if success then
            gem:Destroy()
            inner:Destroy()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if remotes then
                local fragEvent = remotes:FindFirstChild(GameConfig.REMOTES.FRAGMENT_COLLECTED) :: RemoteEvent?
                if fragEvent then
                    fragEvent:FireClient(player, name)
                end
            end
        end
    end)

    -- Idle levitation and rotation animation
    task.spawn(function()
        local baseY = pos.Y
        while gem.Parent do
            local t = os.clock()
            local newCF = CFrame.new(pos.X, baseY + math.sin(t * 2.2) * 1.2, pos.Z)
                * CFrame.Angles(0, t * 1.5, math.sin(t * 1.2) * 0.1)
            gem.CFrame = newCF
            inner.CFrame = newCF
            task.wait(0.03)
        end
    end)

    fragModel.PrimaryPart = gem
    fragModel.Parent = parentFolder
end

-- Spawns a functional Raid Entrance portal gateway prompt in Workspace.Map.Ruins
local function SetupRaidPortal(ruinsFolder: Folder)
    local existing = ruinsFolder:FindFirstChild("RaidEntrancePortal")
    if existing then return end

    local portalModel = Instance.new("Model")
    portalModel.Name = "RaidEntrancePortal"

    local frameLeft = Instance.new("Part")
    frameLeft.Name = "PillarLeft"
    frameLeft.Size = Vector3.new(3, 24, 3)
    frameLeft.CFrame = CFrame.new(-12, 12, -180)
    frameLeft.Color = Color3.fromRGB(25, 20, 35)
    frameLeft.Material = Enum.Material.Basalt
    frameLeft.Anchored = true
    frameLeft.Parent = portalModel

    local frameRight = Instance.new("Part")
    frameRight.Name = "PillarRight"
    frameRight.Size = Vector3.new(3, 24, 3)
    frameRight.CFrame = CFrame.new(12, 12, -180)
    frameRight.Color = Color3.fromRGB(25, 20, 35)
    frameRight.Material = Enum.Material.Basalt
    frameRight.Anchored = true
    frameRight.Parent = portalModel

    local frameTop = Instance.new("Part")
    frameTop.Name = "PillarTop"
    frameTop.Size = Vector3.new(27, 3, 3)
    frameTop.CFrame = CFrame.new(0, 24, -180)
    frameTop.Color = Color3.fromRGB(25, 20, 35)
    frameTop.Material = Enum.Material.Basalt
    frameTop.Anchored = true
    frameTop.Parent = portalModel

    local portalEnergy = Instance.new("Part")
    portalEnergy.Name = "PortalEnergy"
    portalEnergy.Size = Vector3.new(21, 21, 1)
    portalEnergy.CFrame = CFrame.new(0, 12, -180)
    portalEnergy.Color = Color3.fromRGB(150, 40, 220)
    portalEnergy.Material = Enum.Material.Neon
    portalEnergy.Transparency = 0.25
    portalEnergy.Anchored = true
    portalEnergy.CanCollide = false
    portalEnergy.Parent = portalModel

    local pLight = Instance.new("PointLight")
    pLight.Color = Color3.fromRGB(180, 50, 255)
    pLight.Range = 24
    pLight.Brightness = 3
    pLight.Parent = portalEnergy

    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Initiate Raid"
    prompt.ObjectText = "Elemental Portal"
    prompt.HoldDuration = 1.0
    prompt.MaxActivationDistance = 18
    prompt.RequiresLineOfSight = false
    prompt.Parent = portalEnergy

    prompt.Triggered:Connect(function(player)
        if not RaidService.IsActive() then
            RaidService.StartRaid(player)
        end
    end)

    portalModel.PrimaryPart = portalEnergy
    portalModel.Parent = ruinsFolder
end

-- Spawns training target dummy NPCs for combat testing
local function SetupTrainingDummies(npcsFolder: Folder)
    local function SpawnDummy(dummyName: string, cframe: CFrame, maxHp: number)
        local existing = npcsFolder:FindFirstChild(dummyName)
        if existing then return end

        local dummy = Instance.new("Model")
        dummy.Name = dummyName

        local root = Instance.new("Part")
        root.Name = "HumanoidRootPart"
        root.Size = Vector3.new(2, 2, 1)
        root.Color = Color3.fromRGB(130, 90, 60)
        root.Material = Enum.Material.Wood
        root.Anchored = true
        root.CFrame = cframe
        root.Parent = dummy

        local torso = Instance.new("Part")
        torso.Name = "Torso"
        torso.Size = Vector3.new(2, 2.5, 1.2)
        torso.Color = Color3.fromRGB(150, 110, 75)
        torso.Material = Enum.Material.Wood
        torso.Anchored = true
        torso.CFrame = cframe * CFrame.new(0, 2.25, 0)
        torso.Parent = dummy

        local head = Instance.new("Part")
        head.Name = "Head"
        head.Size = Vector3.new(1.4, 1.4, 1.4)
        head.Color = Color3.fromRGB(210, 180, 150)
        head.Material = Enum.Material.Wood
        head.Anchored = true
        head.CFrame = cframe * CFrame.new(0, 4.5, 0)
        head.Parent = dummy

        -- Billboard health bar
        local bg = Instance.new("BillboardGui")
        bg.Size = UDim2.new(0, 90, 0, 16)
        bg.StudsOffset = Vector3.new(0, 3.2, 0)
        bg.AlwaysOnTop = false
        bg.Parent = head

        local hpBg = Instance.new("Frame")
        hpBg.Size = UDim2.new(1, 0, 1, 0)
        hpBg.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
        hpBg.Parent = bg

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = hpBg

        local hpFill = Instance.new("Frame")
        hpFill.Name = "HPFill"
        hpFill.Size = UDim2.new(1, 0, 1, 0)
        hpFill.BackgroundColor3 = Color3.fromRGB(46, 214, 115)
        hpFill.BorderSizePixel = 0
        hpFill.Parent = hpBg

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(0, 4)
        fillCorner.Parent = hpFill

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 10
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.Text = dummyName
        nameLabel.Parent = hpBg

        local hum = Instance.new("Humanoid")
        hum.MaxHealth = maxHp
        hum.Health = maxHp
        hum.Parent = dummy

        dummy.PrimaryPart = root
        dummy.Parent = npcsFolder

        hum.HealthChanged:Connect(function(hp)
            local ratio = math.clamp(hp / maxHp, 0, 1)
            hpFill.Size = UDim2.new(ratio, 0, 1, 0)
            hpFill.BackgroundColor3 = (ratio > 0.5)
                and Color3.fromRGB(46, 214, 115)
                or (ratio > 0.25 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(220, 50, 50))
        end)

        hum.Died:Connect(function()
            task.delay(4.0, function()
                pcall(function() dummy:Destroy() end)
                SpawnDummy(dummyName, cframe, maxHp)
            end)
        end)
    end

    SpawnDummy("Training Dummy 1", CFrame.new(25, 2, -25), 500)
    SpawnDummy("Training Dummy 2", CFrame.new(40, 2, -25), 500)
    SpawnDummy("Training Dummy 3", CFrame.new(55, 2, -25), 500)
    SpawnDummy("Target Dummy (Boss)", CFrame.new(70, 2, -25), 2500)
end

function MapService.BuildWorld1()
    SetupAnimeLighting()

    -- Ensure clean spec folder hierarchy exists
    local mapFolder = EnsureFolder(Workspace, "Map")
    local villageFolder = EnsureFolder(mapFolder, "Village")
    local forestFolder = EnsureFolder(mapFolder, "Forest")
    local caveFolder = EnsureFolder(mapFolder, "Cave")
    local ruinsFolder = EnsureFolder(mapFolder, "Ruins")

    local npcsFolder = EnsureFolder(Workspace, "NPCs")
    local vfxFolder = EnsureFolder(Workspace, "VFX")
    local spawnsFolder = EnsureFolder(Workspace, "SpawnLocations")

    -- Set up functional interactive items (Fragments, Raid Portal, Combat Dummies)
    SpawnWorldFragment("ForestFragment", "Forest Whispers", Vector3.new(-80, 4, 60), forestFolder)
    SpawnWorldFragment("VillageFragment", "Village Solace", Vector3.new(40, 4, 40), villageFolder)
    SpawnWorldFragment("CaveFragment", "Deep Crystal", Vector3.new(0, 4, 120), caveFolder)
    SpawnWorldFragment("RuinsFragment", "Ancient Terra", Vector3.new(-60, 4, -120), ruinsFolder)

    SetupRaidPortal(ruinsFolder)
    SetupTrainingDummies(npcsFolder)

    print("[MapService] Clean environment initialized — Folders, Anime Lighting, Fragments, and Combat Dummies ready.")
end

return table.freeze(MapService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Monetization & Gamepass Service
    Integrates MarketplaceService with PlayerDataService.
    Handles: GamePasses (2x EXP, 2x Charges, Lucky Spins, VIP, Speed), and Developer Products (Spin bundles).

    HOW TO ACTIVATE:
    1. Create your passes in Creator Hub > Monetization > Game Passes
    2. Update GameConfig.GAMEPASS_IDS with the real IDs
    3. Create Developer Products and update GameConfig.PRODUCT_IDS
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local ShopConfig = require(ReplicatedStorage.Shared.Config.ShopConfig)
local PlayerDataService = require(script.Parent.PlayerDataService)

local MonetizationService = {}

-- Internal pass key reverse lookup by Id
local function BuildPassKeyMap(): { [number]: string }
    local map: { [number]: string } = {}
    for passKey, passData in ShopConfig.GAMEPASSES do
        if passData.Id and passData.Id > 0 then
            map[passData.Id] = passKey
        end
    end
    return map
end

-- Check existing GamePass ownership when player joins
function MonetizationService.CheckOwnershipOnJoin(player: Player)
    for passKey, passData in ShopConfig.GAMEPASSES do
        if passData.Id and passData.Id > 0 then
            local success, ownsPass = pcall(function()
                return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passData.Id)
            end)
            if success and ownsPass then
                PlayerDataService.GrantGamePass(player, passKey)
            end
        end
    end
end

-- Prompt purchase helper
function MonetizationService.PromptGamePass(player: Player, passKey: string)
    local passData = ShopConfig.GAMEPASSES[passKey]
    if not passData then return end
    if passData.Id <= 0 then
        -- Pass not yet configured in Creator Hub, inform via print
        warn(string.format("[MonetizationService] Gamepass '%s' has no real ID yet. Create it in Creator Hub.", passKey))
        return
    end
    MarketplaceService:PromptGamePassPurchase(player, passData.Id)
end

function MonetizationService.PromptProduct(player: Player, productKey: string)
    local productData = ShopConfig.PRODUCTS[productKey]
    if not productData then return end
    if productData.Id <= 0 then
        warn(string.format("[MonetizationService] Product '%s' has no real ID yet. Create it in Creator Hub.", productKey))
        return
    end
    MarketplaceService:PromptProductPurchase(player, productData.Id)
end

-- Hook gamepass purchase finished
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
    if not wasPurchased then return end

    for passKey, passData in ShopConfig.GAMEPASSES do
        if passData.Id == passId then
            PlayerDataService.GrantGamePass(player, passKey)

            -- Apply immediate effects
            if passKey == "SpeedBoost" then
                local char = player.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = 19
                        hum.JumpPower = 54
                    end
                end
            end

            -- Notify player
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if remotes then
                local announce = remotes:FindFirstChild(GameConfig.REMOTES.GLOBAL_ANNOUNCEMENT) :: RemoteEvent?
                if announce then
                    announce:FireClient(player, string.format("Purchased gamepass: %s! Enjoy your perks.", passData.Name))
                end
            end

            print(string.format("[MonetizationService] %s purchased gamepass: %s", player.Name, passData.Name))
            break
        end
    end
end)

-- Hook developer product purchases (ProcessReceipt)
-- IMPORTANT: Only one ProcessReceipt can be set per server. If you use other services, merge them here.
MarketplaceService.ProcessReceipt = function(receiptInfo): Enum.ProductPurchaseDecision
    local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
    if not player then
        -- Player may have left. Return NotProcessedYet so Roblox retries later.
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    local productId = receiptInfo.ProductId
    for _, productData in ShopConfig.PRODUCTS do
        if productData.Id == productId and productData.Id > 0 then
            local profile = PlayerDataService.GetProfile(player)
            if not profile then
                return Enum.ProductPurchaseDecision.NotProcessedYet
            end
            PlayerDataService.AddSpinTickets(player, productData.SpinsAwarded)

            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if remotes then
                local announce = remotes:FindFirstChild(GameConfig.REMOTES.GLOBAL_ANNOUNCEMENT) :: RemoteEvent?
                if announce then
                    announce:FireClient(player, string.format("Purchased %s! Tickets added to your account.", productData.Name))
                end
            end

            print(string.format("[MonetizationService] %s purchased product: %s (+%d spins)", player.Name, productData.Name, productData.SpinsAwarded))
            return Enum.ProductPurchaseDecision.PurchaseGranted
        end
    end

    -- Unrecognized product — grant to avoid duplicate charges
    return Enum.ProductPurchaseDecision.PurchaseGranted
end

return table.freeze(MonetizationService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Enterprise Player Data & Persistence Service
    Features:
    - Auto-saving background loop (every 120 seconds)
    - game:BindToClose shutdown protection ensuring 100% data persistence
    - Tracks Levels (1-300), Charges (0-10,000), Fragments, Unlocked Worlds, GamePasses
    - Atomic DataStore retries with session locking fallback
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

export type PlayerProfile = {
    UserId: number,
    Level: number,
    Charges: number,
    Element: GameConfig.ElementType,
    ErrorMeter: number,
    ClaimedSecretAllocation: boolean,
    Fragments: { [string]: boolean },
    UnlockedWorlds: { [string]: boolean },
    GamePasses: { [string]: boolean },
    SpinTickets: number,
}

local PlayerDataService = {}
local profiles: { [number]: PlayerProfile } = {}
local isDirty: { [number]: boolean } = {}
local lastSavedTime: { [number]: number } = {}
local DATASTORE_WRITE_COOLDOWN = 6

local PlayerDataStore: DataStore? = nil
pcall(function()
    PlayerDataStore = DataStoreService:GetDataStore("ElementalWorlds_PlayerData_v2")
end)

local DEFAULT_PROFILE: PlayerProfile = {
    UserId = 0,
    Level = 1,
    Charges = 0,
    Element = "Fire",
    ErrorMeter = 0,
    ClaimedSecretAllocation = false,
    Fragments = {},
    UnlockedWorlds = { World1 = true },
    GamePasses = {},
    SpinTickets = 1,
}

-- Load or create profile
function PlayerDataService.LoadProfile(player: Player): PlayerProfile
    local userId = player.UserId
    if profiles[userId] then
        return profiles[userId]
    end

    local loadedData: any = nil
    if PlayerDataStore then
        local attempts = 0
        local success = false
        while attempts < 3 and not success do
            attempts += 1
            local ok, result = pcall(function()
                return PlayerDataStore:GetAsync("User_" .. tostring(userId))
            end)
            if ok then
                success = true
                loadedData = result
            else
                task.wait(0.5)
            end
        end
    end

    local profile: PlayerProfile = {
        UserId = userId,
        Level = if loadedData and loadedData.Level then loadedData.Level else DEFAULT_PROFILE.Level,
        Charges = if loadedData and loadedData.Charges then loadedData.Charges else DEFAULT_PROFILE.Charges,
        Element = if loadedData and loadedData.Element then loadedData.Element else DEFAULT_PROFILE.Element,
        ErrorMeter = 0, -- Resets each session
        ClaimedSecretAllocation = if loadedData and loadedData.ClaimedSecretAllocation ~= nil then loadedData.ClaimedSecretAllocation else false,
        Fragments = if loadedData and loadedData.Fragments then loadedData.Fragments else {},
        UnlockedWorlds = if loadedData and loadedData.UnlockedWorlds then loadedData.UnlockedWorlds else { World1 = true },
        GamePasses = if loadedData and loadedData.GamePasses then loadedData.GamePasses else {},
        SpinTickets = if loadedData and loadedData.SpinTickets then loadedData.SpinTickets else 1,
    }

    profiles[userId] = profile
    PlayerDataService.ApplyLevelHealth(player)
    return profile
end

-- Save player profile with exponential retry
function PlayerDataService.SaveProfile(player: Player): boolean
    local userId = player.UserId
    local profile = profiles[userId]
    if not profile or not PlayerDataStore then
        return false
    end

    local dataToSave = {
        Level = profile.Level,
        Charges = profile.Charges,
        Element = profile.Element,
        ClaimedSecretAllocation = profile.ClaimedSecretAllocation,
        Fragments = profile.Fragments,
        UnlockedWorlds = profile.UnlockedWorlds,
        GamePasses = profile.GamePasses,
        SpinTickets = profile.SpinTickets,
    }

    local success = false
    local attempts = 0
    while attempts < 3 and not success do
        attempts += 1
        local ok = pcall(function()
            PlayerDataStore:SetAsync("User_" .. tostring(userId), dataToSave)
        end)
        if ok then
            success = true
        else
            task.wait(0.5)
        end
    end

    return success
end

function PlayerDataService.GetProfile(player: Player): PlayerProfile?
    return profiles[player.UserId]
end

function PlayerDataService.ApplyLevelHealth(player: Player)
    local profile = profiles[player.UserId]
    if not profile then return end

    local char = player.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local maxHp = GameConfig.GetMaxHealth(profile.Level)
        -- VIP pass bonus +200 HP
        if profile.GamePasses["VIPMaster"] then
            maxHp += 200
        end
        humanoid.MaxHealth = maxHp
        humanoid.Health = math.min(humanoid.Health, maxHp)
    end
end

function PlayerDataService.SetLevel(player: Player, newLevel: number)
    local profile = profiles[player.UserId]
    if not profile then return end

    profile.Level = math.clamp(newLevel, 1, GameConfig.MAX_LEVEL)
    PlayerDataService.ApplyLevelHealth(player)
    PlayerDataService.SyncClient(player)
end

function PlayerDataService.AddLevel(player: Player, amount: number)
    local profile = profiles[player.UserId]
    if not profile then return end

    -- 2x EXP Gamepass multiplier
    if amount > 0 and profile.GamePasses["DoubleExp"] then
        amount = amount * 2
    end

    PlayerDataService.SetLevel(player, profile.Level + amount)
end

function PlayerDataService.SetCharges(player: Player, amount: number)
    local profile = profiles[player.UserId]
    if not profile then return end

    profile.Charges = math.clamp(amount, 0, GameConfig.MAX_CHARGES)
    PlayerDataService.SyncClient(player)
end

function PlayerDataService.AddCharges(player: Player, amount: number)
    local profile = profiles[player.UserId]
    if not profile then return end

    -- 2x Charges Gamepass multiplier
    if amount > 0 and profile.GamePasses["DoubleCharges"] then
        amount = amount * 2
    end

    PlayerDataService.SetCharges(player, profile.Charges + amount)
end

function PlayerDataService.SetElement(player: Player, element: GameConfig.ElementType)
    local profile = profiles[player.UserId]
    if not profile then return end

    profile.Element = element
    profile.ErrorMeter = 0
    PlayerDataService.SyncClient(player)
end

function PlayerDataService.AddErrorMeter(player: Player, amount: number)
    local profile = profiles[player.UserId]
    if not profile or profile.Element ~= "Error" then return end

    profile.ErrorMeter = math.clamp(profile.ErrorMeter + amount, 0, 100)
    PlayerDataService.SyncClient(player)
end

-- Collect a world fragment (e.g. Forest, Cave, Ruins, Mountain)
function PlayerDataService.CollectFragment(player: Player, fragmentId: string): boolean
    local profile = profiles[player.UserId]
    if not profile then return false end

    if profile.Fragments[fragmentId] then
        return false -- Already collected
    end

    profile.Fragments[fragmentId] = true

    -- Count total collected
    local count = 0
    for _ in profile.Fragments do count += 1 end

    -- If collected all 4 World 1 fragments, unlock World 2!
    if count >= 4 and not profile.UnlockedWorlds["World2"] then
        profile.UnlockedWorlds["World2"] = true
        PlayerDataService.AddCharges(player, 500)
        PlayerDataService.AddLevel(player, 5)
    end

    PlayerDataService.SyncClient(player)
    return true
end

-- Add GamePass ownership
function PlayerDataService.GrantGamePass(player: Player, passKey: string)
    local profile = profiles[player.UserId]
    if not profile then return end

    profile.GamePasses[passKey] = true
    if passKey == "VIPMaster" then
        PlayerDataService.ApplyLevelHealth(player)
    end
    PlayerDataService.SyncClient(player)
end

function PlayerDataService.AddSpinTickets(player: Player, amount: number)
    local profile = profiles[player.UserId]
    if not profile then return end

    profile.SpinTickets = math.max(0, profile.SpinTickets + amount)
    PlayerDataService.SyncClient(player)
end

-- Sync state to client & mark profile dirty for immediate 1-second auto-save
function PlayerDataService.SyncClient(player: Player)
    local profile = profiles[player.UserId]
    if not profile then return end

    isDirty[player.UserId] = true

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local updateStatsEvent = remotes:FindFirstChild(GameConfig.REMOTES.UPDATE_STATS) :: RemoteEvent?
        if updateStatsEvent then
            local fragmentCount = 0
            for _ in profile.Fragments do fragmentCount += 1 end

            updateStatsEvent:FireClient(player, {
                Level = profile.Level,
                Charges = profile.Charges,
                Element = profile.Element,
                ErrorMeter = profile.ErrorMeter,
                MaxHealth = GameConfig.GetMaxHealth(profile.Level),
                FragmentCount = fragmentCount,
                TotalFragments = 4,
                UnlockedWorlds = profile.UnlockedWorlds,
                GamePasses = profile.GamePasses,
                SpinTickets = profile.SpinTickets,
            })
        end
    end
end

function PlayerDataService.MarkDirty(player: Player)
    isDirty[player.UserId] = true
end

function PlayerDataService.RemoveProfile(player: Player)
    PlayerDataService.SaveProfile(player)
    profiles[player.UserId] = nil
    isDirty[player.UserId] = nil
    lastSavedTime[player.UserId] = nil
end

-- ==================== 1-SECOND AUTO-SAVE LOOP ====================
-- Runs every 1 second, saving everything the player did or acquired
task.spawn(function()
    while true do
        task.wait(1)
        local now = os.clock()
        for _, player in Players:GetPlayers() do
            local userId = player.UserId
            local profile = profiles[userId]
            if profile and isDirty[userId] then
                local lastSave = lastSavedTime[userId] or 0
                -- In Studio or when cooldown has elapsed, persist dirty data to DataStore
                if RunService:IsStudio() or (now - lastSave >= DATASTORE_WRITE_COOLDOWN) then
                    isDirty[userId] = false
                    lastSavedTime[userId] = now
                    task.spawn(function()
                        PlayerDataService.SaveProfile(player)
                    end)
                end
            end
        end
    end
end)

-- ==================== BIND TO CLOSE SHUTDOWN HANDLER ====================
game:BindToClose(function()
    if RunService:IsStudio() then
        -- Quick save in studio
        for _, player in Players:GetPlayers() do
            PlayerDataService.SaveProfile(player)
        end
        return
    end

    local count = #Players:GetPlayers()
    if count == 0 then return end

    local finished = 0
    for _, player in Players:GetPlayers() do
        task.spawn(function()
            PlayerDataService.SaveProfile(player)
            finished += 1
        end)
    end

    -- Hold server open until all profiles are saved or 25s timeout
    local elapsed = 0
    while finished < count and elapsed < 25 do
        task.wait(0.2)
        elapsed += 0.2
    end
end)

return table.freeze(PlayerDataService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">RNGSystem</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: RNG & Element Spin System
    Controls element spinning with exact rate enforcement:
    Fire: 19.96%, Aqua: 19.96%, Earth: 19.96%, Light: 19.96%, Wind: 19.96%, Error: 0.10%, Time: 0.10%.
    Tracks the first 5,000 secret allocations atomically.
    Owner-only test controls and global roll broadcasts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local PlayerDataService = require(script.Parent.PlayerDataService)

type ElementType = GameConfig.ElementType

local RNGSystem = {}

-- Secret allocation counter
local secretAllocationCount = 0
local SecretAllocationStore: DataStore? = nil
pcall(function()
    SecretAllocationStore = DataStoreService:GetDataStore("ElementalWorlds_SecretClaims_v1")
    if SecretAllocationStore then
        local count = SecretAllocationStore:GetAsync("GlobalClaimCount")
        if count and type(count) == "number" then
            secretAllocationCount = count
        end
    end
end)

-- Current active rates (Can only be modified by Owner)
local currentRates: { [ElementType]: number } = {
    Fire = 0.1996,
    Aqua = 0.1996,
    Earth = 0.1996,
    Light = 0.1996,
    Wind = 0.1996,
    Error = 0.0010,
    Time = 0.0010,
}

-- Broadcast global announcement to all connected clients
local function BroadcastAnnouncement(message: string)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local announceEvent = remotes:FindFirstChild(GameConfig.REMOTES.GLOBAL_ANNOUNCEMENT) :: RemoteEvent?
        if announceEvent then
            announceEvent:FireAllClients(message)
        end
    end
end

-- Checks and grants the one-time secret allocation if eligible
function RNGSystem.TryClaimSecretAllocation(player: Player): ElementType?
    local profile = PlayerDataService.GetProfile(player)
    if not profile then return nil end

    -- Check if player already claimed or if cap reached
    if profile.ClaimedSecretAllocation or secretAllocationCount >= GameConfig.SECRET_ALLOCATION_MAX_PLAYERS then
        return nil
    end

    -- Atomic increment in DataStore
    if SecretAllocationStore then
        local success, newCount = pcall(function()
            return SecretAllocationStore:IncrementAsync("GlobalClaimCount", 1)
        end)
        if success and newCount then
            secretAllocationCount = newCount
            if secretAllocationCount > GameConfig.SECRET_ALLOCATION_MAX_PLAYERS then
                return nil -- Cap reached in parallel
            end
        end
    else
        secretAllocationCount += 1
    end

    -- 50/50 between Error and Time
    local roll = math.random()
    local secretElement: ElementType = if roll < 0.5 then "Error" else "Time"

    profile.ClaimedSecretAllocation = true
    PlayerDataService.SetElement(player, secretElement)
    PlayerDataService.SaveProfile(player)

    BroadcastAnnouncement(string.format("[SPECIAL ALLOCATION] [%s] received %s (Slot #%d/%d)!", player.Name, string.upper(secretElement), secretAllocationCount, GameConfig.SECRET_ALLOCATION_MAX_PLAYERS))
    return secretElement
end

-- Standard element roll using server RNG
function RNGSystem.RollElement(player: Player): ElementType
    local profile = PlayerDataService.GetProfile(player)
    if not profile then return "Fire" end

    -- Check if eligible for first 5,000 secret allocation first
    local secretResult = RNGSystem.TryClaimSecretAllocation(player)
    if secretResult then
        return secretResult
    end

    -- Normal RNG Spin (0.0 to 1.0)
    local roll = math.random()
    local cumulative = 0.0
    local chosenElement: ElementType = "Fire"

    local elements: { ElementType } = { "Fire", "Aqua", "Earth", "Light", "Wind", "Error", "Time" }
    for _, elem in elements do
        cumulative += currentRates[elem]
        if roll <= cumulative then
            chosenElement = elem
            break
        end
    end

    -- Update player profile
    PlayerDataService.SetElement(player, chosenElement)
    PlayerDataService.SaveProfile(player)

    -- Announce secret roll globally if Error or Time was rolled naturally
    if chosenElement == "Error" or chosenElement == "Time" then
        BroadcastAnnouncement(string.format("[%s] rolled %s!", player.Name, string.upper(chosenElement)))
    end

    return chosenElement
end

-- OWNER-ONLY: Override rates for testing
function RNGSystem.SetRates(ownerPlayer: Player, newRates: { [ElementType]: number }): boolean
    if ownerPlayer.UserId ~= GameConfig.OWNER_USER_ID then
        return false -- Only owner can modify RNG
    end

    for elem, rate in newRates do
        if currentRates[elem] ~= nil then
            currentRates[elem] = rate
        end
    end
    return true
end

-- OWNER-ONLY: Reset rates to default
function RNGSystem.ResetRates(ownerPlayer: Player): boolean
    if ownerPlayer.UserId ~= GameConfig.OWNER_USER_ID then
        return false
    end

    for elem, rate in GameConfig.SPIN_RATES do
        currentRates[elem] = rate
    end
    return true
end

-- OWNER-ONLY: Test simulate N spins
function RNGSystem.SimulateSpins(ownerPlayer: Player, count: number): { [ElementType]: number }?
    if ownerPlayer.UserId ~= GameConfig.OWNER_USER_ID then
        return nil
    end

    local counts: { [ElementType]: number } = {
        Fire = 0, Aqua = 0, Earth = 0, Light = 0, Wind = 0, Error = 0, Time = 0
    }

    local elements: { ElementType } = { "Fire", "Aqua", "Earth", "Light", "Wind", "Error", "Time" }
    for _ = 1, count do
        local roll = math.random()
        local cum = 0.0
        for _, elem in elements do
            cum += currentRates[elem]
            if roll <= cum then
                counts[elem] += 1
                break
            end
        end
    end

    return counts
end

return table.freeze(RNGSystem)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">RaidService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Enterprise Raid Progression & Boss Battle Service
    Orchestrates dynamic, multi-wave elemental boss raids (Blox Fruits style).
    
    Features:
    - 3 Scaled Waves:
        Wave 1: Corrupted Elementals (Mob swarm)
        Wave 2: Highland Wardens (Elite mini-bosses)
        Wave 3: Infernal Colossus (Titan Boss with 8,000 HP & dynamic boss bar)
    - Global raid progress announcements
    - Auto-rewards: +3 Levels, +20 Charges, +2 Spin Tickets on Boss Defeat
    - Clean cleanup of all raid instances after victory or failure
]]

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local PlayerDataService = require(script.Parent.PlayerDataService)

local RaidService = {}

local isRaidActive = false
local currentWave = 0
local activeRaidEnemies: { Model } = {}
local raidParticipants: { [Player]: boolean } = {}
local raidFolder: Folder? = nil

-- Global notification helper
local function BroadcastAnnouncement(message: string)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local announceEvent = remotes:FindFirstChild(GameConfig.REMOTES.GLOBAL_ANNOUNCEMENT) :: RemoteEvent?
        if announceEvent then
            announceEvent:FireAllClients(message)
        end
    end
end

-- Creates an elite raid combatant with overhead health bar
local function SpawnRaidMob(name: string, cframe: CFrame, maxHp: number, color: Color3, sizeScale: number): Model
    local mob = Instance.new("Model")
    mob.Name = name

    local scale = sizeScale or 1.0

    local root = Instance.new("Part")
    root.Name = "HumanoidRootPart"
    root.Size = Vector3.new(2 * scale, 2 * scale, 1 * scale)
    root.Color = color
    root.Material = Enum.Material.SmoothPlastic
    root.Anchored = false
    root.CFrame = cframe
    root.Parent = mob

    local torso = Instance.new("Part")
    torso.Name = "Torso"
    torso.Size = Vector3.new(2 * scale, 2.5 * scale, 1.2 * scale)
    torso.Color = color
    torso.Material = Enum.Material.Neon
    torso.Anchored = false
    torso.CFrame = cframe * CFrame.new(0, 2.25 * scale, 0)
    torso.Parent = mob

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = torso
    weld.Parent = root

    local head = Instance.new("Part")
    head.Name = "Head"
    head.Size = Vector3.new(1.4 * scale, 1.4 * scale, 1.4 * scale)
    head.Color = Color3.fromRGB(240, 240, 255)
    head.Material = Enum.Material.SmoothPlastic
    head.Anchored = false
    head.CFrame = cframe * CFrame.new(0, 4.5 * scale, 0)
    head.Parent = mob

    local headWeld = Instance.new("WeldConstraint")
    headWeld.Part0 = torso
    headWeld.Part1 = head
    headWeld.Parent = torso

    -- Modern Blox Fruits style overhead health bar
    local bg = Instance.new("BillboardGui")
    bg.Name = "BossHealthGui"
    bg.Size = UDim2.new(0, 140 * scale, 0, 22 * scale)
    bg.StudsOffset = Vector3.new(0, 3.5 * scale, 0)
    bg.AlwaysOnTop = true
    bg.Parent = head

    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(1, 0, 1, 0)
    barBg.BackgroundColor3 = Color3.fromRGB(12, 14, 22)
    barBg.BackgroundTransparency = 0.1
    barBg.Parent = bg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = barBg

    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = 1.8
    stroke.Parent = barBg

    local barFill = Instance.new("Frame")
    barFill.Name = "Fill"
    barFill.Size = UDim2.new(1, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(235, 60, 75)
    barFill.Parent = barBg

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 6)
    fillCorner.Parent = barFill

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, 0, 1, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Font = Enum.Font.GothamBlack
    titleLbl.TextSize = 11 * scale
    titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLbl.Text = name .. " [" .. tostring(maxHp) .. " HP]"
    titleLbl.Parent = barBg

    local hum = Instance.new("Humanoid")
    hum.MaxHealth = maxHp
    hum.Health = maxHp
    hum.WalkSpeed = 16
    hum.Parent = mob

    hum.HealthChanged:Connect(function(hp)
        local ratio = math.clamp(hp / maxHp, 0, 1)
        barFill.Size = UDim2.new(ratio, 0, 1, 0)
        titleLbl.Text = string.format("%s [%d/%d]", name, math.round(hp), maxHp)
    end)

    mob.PrimaryPart = root

    local parentFolder = raidFolder or Workspace
    mob.Parent = parentFolder

    -- Basic AI chase nearest participant
    task.spawn(function()
        while mob.Parent and hum.Health > 0 do
            local nearestRoot: BasePart? = nil
            local minDist = 150
            for player in raidParticipants do
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local pRoot = player.Character.HumanoidRootPart :: BasePart
                    local d = (pRoot.Position - root.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        nearestRoot = pRoot
                    end
                end
            end

            if nearestRoot then
                hum:MoveTo(nearestRoot.Position)
            end
            task.wait(1.5)
        end
    end)

    return mob
end

-- Advances to the next wave or finishes the raid
local function NextWave()
    if not isRaidActive then return end
    currentWave += 1

    table.clear(activeRaidEnemies)

    -- Dedicated Raid Arena Coordinates (Elevated Roman Colosseum Sky Dungeon)
    local ARENA_CENTER = Vector3.new(0, 252, 900)
    local ARENA_ENTRANCE = Vector3.new(0, 253, 850)

    if currentWave == 1 then
        BroadcastAnnouncement("[RAID WAVE 1/3] Corrupted Elementals have entered the Colosseum!")
        for i = 1, 4 do
            local angle = (i / 4) * math.pi * 2
            local pos = ARENA_CENTER + Vector3.new(math.cos(angle) * 30, 0, math.sin(angle) * 30)
            local mob = SpawnRaidMob("Corrupted Sentinel " .. i, CFrame.new(pos), 800, Color3.fromRGB(150, 60, 255), 1.0)
            table.insert(activeRaidEnemies, mob)

            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Died:Connect(function()
                    for idx, e in activeRaidEnemies do
                        if e == mob then
                            table.remove(activeRaidEnemies, idx)
                            break
                        end
                    end
                    if #activeRaidEnemies == 0 then
                        task.delay(2.0, NextWave)
                    end
                end)
            end
        end
    elseif currentWave == 2 then
        BroadcastAnnouncement("[RAID WAVE 2/3] Highland Wardens storming the Colosseum!")
        for i = 1, 2 do
            local offset = if i == 1 then Vector3.new(-25, 0, 0) else Vector3.new(25, 0, 0)
            local mob = SpawnRaidMob("Highland Warden " .. i, CFrame.new(ARENA_CENTER + offset), 2200, Color3.fromRGB(0, 180, 255), 1.3)
            table.insert(activeRaidEnemies, mob)

            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Died:Connect(function()
                    for idx, e in activeRaidEnemies do
                        if e == mob then
                            table.remove(activeRaidEnemies, idx)
                            break
                        end
                    end
                    if #activeRaidEnemies == 0 then
                        task.delay(2.5, NextWave)
                    end
                end)
            end
        end
    elseif currentWave == 3 then
        BroadcastAnnouncement("[RAID FINAL BOSS] INFERNAL TITAN has awakened in the Colosseum! Defeat the Colossus!")
        local boss = SpawnRaidMob("INFERNAL TITAN", CFrame.new(ARENA_CENTER), 8000, Color3.fromRGB(255, 60, 40), 2.2)
        table.insert(activeRaidEnemies, boss)

        local hum = boss:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Died:Connect(function()
                RaidService.EndRaid(true)
            end)
        end
    end
end

-- Starts a full raid session in the dedicated Colosseum
function RaidService.StartRaid(initiator: Player?): boolean
    if isRaidActive then
        return false -- Already active
    end

    isRaidActive = true
    currentWave = 0
    table.clear(raidParticipants)

    local portalPos = Vector3.new(320, 2, 280)
    local ARENA_ENTRANCE = Vector3.new(0, 253, 850)

    -- Register nearby players as participants and teleport them to the arena
    for _, player in Players:GetPlayers() do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local dist = (char.HumanoidRootPart.Position - portalPos).Magnitude
            if dist <= 100 or player == initiator then
                raidParticipants[player] = true
                -- Teleport to Colosseum staging platform
                char:PivotTo(CFrame.new(ARENA_ENTRANCE + Vector3.new(math.random(-10, 10), 0, math.random(-5, 5))))
            end
        end
    end

    -- Setup raid folder
    raidFolder = Instance.new("Folder")
    raidFolder.Name = "ActiveRaidFolder"
    raidFolder.Parent = Workspace

    BroadcastAnnouncement(string.format("[RAID] Elemental Colosseum Raid initiated by [%s]! Fight for glory!", initiator and initiator.Name or "Server"))

    task.delay(2.0, NextWave)
    return true
end

-- Ends raid session and distributes rewards
function RaidService.EndRaid(victory: boolean)
    if not isRaidActive then return end
    isRaidActive = false

    if victory then
        BroadcastAnnouncement("[RAID VICTORY] The Infernal Titan has fallen! Rewards awarded to all heroes!")
        for player in raidParticipants do
            if player.Parent then
                PlayerDataService.AddLevel(player, GameConfig.RAID_LEVEL_REWARD)
                PlayerDataService.AddCharges(player, GameConfig.RAID_CHARGES_REWARD)
                PlayerDataService.AddSpinTickets(player, 2)
            end
        end
    else
        BroadcastAnnouncement("[RAID DEFEAT] The Raid has concluded.")
    end

    task.delay(4.0, function()
        -- Teleport participants back to Village hub
        local villageSpawn = Vector3.new(0, 3, 30)
        for player in raidParticipants do
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char:PivotTo(CFrame.new(villageSpawn + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))))
            end
        end

        if raidFolder then
            pcall(function() raidFolder:Destroy() end)
            raidFolder = nil
        end
        table.clear(activeRaidEnemies)
        table.clear(raidParticipants)
    end)
end

function RaidService.IsActive(): boolean
    return isRaidActive
end

function RaidService.CompleteRaid(player: Player)
    PlayerDataService.AddLevel(player, GameConfig.RAID_LEVEL_REWARD)
    PlayerDataService.AddCharges(player, GameConfig.RAID_CHARGES_REWARD)
    PlayerDataService.AddSpinTickets(player, 2)
    BroadcastAnnouncement(string.format("[%s] completed an Elemental Raid! +%d Levels, +%d Charges, +2 Spins!",
        player.Name, GameConfig.RAID_LEVEL_REWARD, GameConfig.RAID_CHARGES_REWARD))
end

return table.freeze(RaidService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">StatusEffectService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Status Effect Service
    Server-authoritative status effect management, invulnerability checks, and cleanup.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local StatusTypes = require(ReplicatedStorage.Shared.Modules.StatusEffectTypes)
local VFXBroadcastService = require(script.Parent.VFXBroadcastService)

export type ActiveEffect = StatusTypes.ActiveEffect
export type StatusEffectName = StatusTypes.StatusEffectName

local StatusEffectService = {}

-- character instance -> effectName -> ActiveEffect
local characterEffects: { [Model]: { [StatusEffectName]: ActiveEffect } } = {}

-- Applies a status effect with a specific duration
function StatusEffectService.ApplyEffect(
    character: Model,
    effectName: StatusEffectName,
    duration: number,
    sourcePlayer: Player?,
    data: { [string]: any }?
)
    if not characterEffects[character] then
        characterEffects[character] = {}

        -- Bind cleanup on death or removing
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Died:Once(function()
                StatusEffectService.ClearAllEffects(character)
            end)
        end
        character.Destroying:Once(function()
            StatusEffectService.ClearAllEffects(character)
        end)
    end

    local now = os.clock()
    local effect: ActiveEffect = {
        Name = effectName,
        StartTime = now,
        Duration = duration,
        EndTime = now + duration,
        SourcePlayer = sourcePlayer,
        Data = data,
    }

    characterEffects[character][effectName] = effect

    -- Apply immediate mechanics
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?

    if effectName == "Stunned" or effectName == "TimeStopped" or effectName == "UnparalleledStun" then
        if humanoid then
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
        end
        if rootPart and (effectName == "TimeStopped" or effectName == "UnparalleledStun") then
            rootPart.Anchored = true
        end
    elseif effectName == "SpeedBoost" then
        if humanoid then
            humanoid.WalkSpeed = 32 -- Doubled standard walkspeed
        end
    elseif effectName == "GotGlitched" then
        -- Set character invisible on server (never touch HumanoidRootPart)
        for _, part in character:GetDescendants() do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                if part:GetAttribute("OrigTrans") == nil and part.Transparency < 0.9 then
                    part:SetAttribute("OrigTrans", part.Transparency)
                end
                part.Transparency = 1
            elseif part:IsA("Decal") then
                if part:GetAttribute("OrigTrans") == nil and part.Transparency < 0.9 then
                    part:SetAttribute("OrigTrans", part.Transparency)
                end
                part.Transparency = 1
            end
        end
    elseif effectName == "Blinded" then
        -- Notify client to show blind overlay
        local player = Players:GetPlayerFromCharacter(character)
        if player then
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if remotes then
                local vfxEvent = remotes:FindFirstChild(GameConfig.REMOTES.VFX_TRIGGER) :: RemoteEvent?
                if vfxEvent then
                    vfxEvent:FireClient(player, "Blind", { Duration = duration })
                end
            end
        end
    end

    -- Schedule removal
    task.delay(duration, function()
        -- Verify effect wasn't replaced by a newer one
        local current = characterEffects[character] and characterEffects[character][effectName]
        if current and current.StartTime == now then
            StatusEffectService.RemoveEffect(character, effectName)
        end
    end)
end

function StatusEffectService.HasEffect(character: Model, effectName: StatusEffectName): boolean
    local effects = characterEffects[character]
    if not effects then return false end
    local effect = effects[effectName]
    if not effect then return false end

    if os.clock() >= effect.EndTime then
        StatusEffectService.RemoveEffect(character, effectName)
        return false
    end

    return true
end

-- Checks if character can currently take damage (checks Untouchable & GotGlitched)
function StatusEffectService.CanTakeDamage(character: Model): boolean
    if StatusEffectService.HasEffect(character, "Untouchable") then
        return false -- Time: Untouchable stops all incoming attacks
    end
    if StatusEffectService.HasEffect(character, "GotGlitched") then
        return false -- Error: Got Glitched is immune to all damage
    end
    return true
end

-- Checks if character can cast normal abilities
function StatusEffectService.CanCastAbilities(character: Model): boolean
    if StatusEffectService.HasEffect(character, "Stunned") then
        return false
    end
    if StatusEffectService.HasEffect(character, "TimeStopped") then
        return false
    end
    if StatusEffectService.HasEffect(character, "UnparalleledStun") then
        return false
    end
    return true
end

-- Removes a specific status effect
function StatusEffectService.RemoveEffect(character: Model, effectName: StatusEffectName)
    local effects = characterEffects[character]
    if not effects or not effects[effectName] then return end

    effects[effectName] = nil

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?

    if effectName == "Stunned" or effectName == "TimeStopped" or effectName == "UnparalleledStun" or effectName == "SpeedBoost" then
        if humanoid then
            humanoid.WalkSpeed = 16 -- Standard walkspeed
            humanoid.JumpPower = 50
        end
        if rootPart and (effectName == "TimeStopped" or effectName == "UnparalleledStun") then
            rootPart.Anchored = false
        end
    elseif effectName == "GotGlitched" then
        -- Restore visibility on server using saved original transparencies
        for _, part in character:GetDescendants() do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local orig = part:GetAttribute("OrigTrans")
                part.Transparency = if (typeof(orig) == "number" and orig < 0.9) then orig else 0
                part:SetAttribute("OrigTrans", nil)
            elseif part:IsA("Decal") then
                local orig = part:GetAttribute("OrigTrans")
                part.Transparency = if (typeof(orig) == "number" and orig < 0.9) then orig else 0
                part:SetAttribute("OrigTrans", nil)
            end
        end
        -- Enforce client visibility restoration
        VFXBroadcastService.Broadcast("GlitchInvisEnd", { Character = character })
    end
end

-- Clear all effects on death / destroy
function StatusEffectService.ClearAllEffects(character: Model)
    local effects = characterEffects[character]
    if not effects then return end

    for effectName in effects do
        StatusEffectService.RemoveEffect(character, effectName)
    end
    characterEffects[character] = nil
    VFXBroadcastService.Broadcast("GlitchInvisEnd", { Character = character })
end

return table.freeze(StatusEffectService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">VFXBroadcastService</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: VFX Broadcast Service
    Provides high-performance, safe replication of VFX events (Craters, Beams,
    Shockwaves, SlashArcs, ImpactBursts, ScreenShakes) from server to all clients or specific players.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local VFXBroadcastService = {}

local vfxEvent: RemoteEvent? = nil

local function GetVFXRemote(): RemoteEvent?
    if not vfxEvent then
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            vfxEvent = remotes:FindFirstChild(GameConfig.REMOTES.VFX_TRIGGER) :: RemoteEvent?
        end
    end
    return vfxEvent
end

function VFXBroadcastService.Broadcast(vfxType: string, payload: any)
    local remote = GetVFXRemote()
    if remote then
        remote:FireAllClients(vfxType, payload)
    end
end

function VFXBroadcastService.BroadcastTo(player: Player, vfxType: string, payload: any)
    local remote = GetVFXRemote()
    if remote then
        remote:FireClient(player, vfxType, payload)
    end
end

return table.freeze(VFXBroadcastService)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="55">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="56">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="57">
        <Properties>
          <string name="Name">ElementalWorldsClient</string>
        </Properties>
        <Item class="LocalScript" referent="58">
          <Properties>
            <string name="Name">ClientMain</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Master Client Entry Point
    Initializes: Anime HUD, Creator Dashboard, Spin Gacha UI, Monetization Shop,
    World Map Panel, Camera Shake, 3D Damage Numbers, Tactile Audio, and Network Event Listeners.
    
    Load order:
    1. Core systems (CameraShake, Sound)
    2. HUD (UIController)
    3. Combat & Mobile input
    4. Specialized UIs (Admin, Spin, Shop, Map)
    5. Network listener hooks
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local SharedLoader = require(script.Parent.SharedLoader)
local GameConfig = SharedLoader.GameConfig
local UIController = require(script.Parent.Controllers.UIController)
local CombatController = require(script.Parent.Controllers.CombatController)
local CameraShakeController = require(script.Parent.Controllers.CameraShakeController)
local MobileController = require(script.Parent.Controllers.MobileController)
local VFXController = require(script.Parent.Controllers.VFXController)
local AdminPanelController = require(script.Parent.Controllers.AdminPanelController)
local SpinUIController = require(script.Parent.Controllers.SpinUIController)
local ShopUIController = require(script.Parent.Controllers.ShopUIController)

local localPlayer = Players.LocalPlayer

local function SafeInit(name: string, fn: () -> ())
    local success, err = pcall(fn)
    if not success then
        warn(string.format("[Elemental Worlds] Warning: Failed to init %s: %s", name, tostring(err)))
    else
        print(string.format("[Elemental Worlds] %s ready.", name))
    end
end

-- 1. Core Systems
SafeInit("CameraShake", CameraShakeController.Init)
SafeInit("HUD", UIController.CreateHUD)

-- 2. Link Combat cooldown callback to HUD
CombatController.SetCooldownCallback(function(slot, duration)
    UIController.StartCooldown(slot, duration)
end)

-- 3. Initialize all subsystems
SafeInit("Combat", CombatController.Init)
SafeInit("Mobile", MobileController.Init)
SafeInit("VFX", VFXController.Init)
SafeInit("AdminPanel", AdminPanelController.Init)
SafeInit("SpinUI", SpinUIController.Init)
SafeInit("ShopUI", ShopUIController.Init)

-- 4. Character health tracking
local function OnCharacterAdded(character: Model)
    UIController.CreateHUD() -- Guarantee HUD mounts if PlayerGui was delayed

    local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
    if humanoid then
        humanoid.HealthChanged:Connect(function(health)
            UIController.SetHealth(health, humanoid.MaxHealth)
        end)
        UIController.SetHealth(humanoid.Health, humanoid.MaxHealth)
    end
end

if localPlayer.Character then
    OnCharacterAdded(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(OnCharacterAdded)

-- 5. Network listeners
local remotes = ReplicatedStorage:WaitForChild("Remotes", 15)
if remotes then
    -- Stats sync
    local updateStatsEvent = remotes:WaitForChild(GameConfig.REMOTES.UPDATE_STATS, 10) :: RemoteEvent?
    if updateStatsEvent then
        updateStatsEvent.OnClientEvent:Connect(function(data)
            UIController.UpdateStats(data)
            if data and data.Element then
                CombatController.SetCurrentElement(data.Element)
            end
        end)
    end

    -- Global announcements
    local globalAnnounceEvent = remotes:WaitForChild(GameConfig.REMOTES.GLOBAL_ANNOUNCEMENT, 10) :: RemoteEvent?
    if globalAnnounceEvent then
        globalAnnounceEvent.OnClientEvent:Connect(function(message)
            UIController.ShowAnnouncement(message)
        end)
    end

    -- Fragment collection notification
    local fragmentEvent = remotes:WaitForChild(GameConfig.REMOTES.FRAGMENT_COLLECTED, 10) :: RemoteEvent?
    if fragmentEvent then
        fragmentEvent.OnClientEvent:Connect(function(fragmentName)
            UIController.ShowFragmentCollected(fragmentName)
            UIController.ShowAnnouncement("World Fragment Discovered: " .. tostring(fragmentName))
        end)
    end

    -- Element rolled result (handled by SpinUIController)
    local elementRolledEvent = remotes:WaitForChild(GameConfig.REMOTES.ELEMENT_ROLLED, 10) :: RemoteEvent?
    if elementRolledEvent then
        elementRolledEvent.OnClientEvent:Connect(function(element)
            SpinUIController.ShowRollResult(element)
            CombatController.SetCurrentElement(element)
        end)
    end

    -- VFXController.Init() already subscribes to VFX_TRIGGER with full payload decoding
end

print("[Elemental Worlds] Client initialized — HUD, Admin Suite, Spin Gacha, Shop, Map, VFX, and all listeners ready.")
]]></string>
          </Properties>
