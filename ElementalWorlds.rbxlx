          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Master Sound Controller
    High-fidelity 3D spatial and 2D combat sounds, direct audio asset playback,
    and distinct UI tactile interactions with organic pitch variance.
]]

local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local SoundController = {}

-- Verified Roblox Audio Asset IDs (Publicly Accessible)
local SFX_LIBRARY: { [string]: { string } } = {
    Punch = {
        "rbxassetid://1720389178",
        "rbxassetid://3041191430",
        "rbxassetid://5835032207",
        "rbxassetid://4612375233",
    },
    SwordSlash = {
        "rbxassetid://6760643020",
        "rbxassetid://7863855238",
        "rbxassetid://615910787",
        "rbxassetid://12222216",
    },
    Explosion = {
        "rbxassetid://3802269741",
        "rbxassetid://5898090542",
        "rbxassetid://287390954",
        "rbxassetid://138087122",
    },
    MagicCast = {
        "rbxassetid://3356359494",
        "rbxassetid://1840218341",
        "rbxassetid://1839806527",
    },
    Dash = {
        "rbxassetid://624706518",
        "rbxassetid://858508159",
    },
    HeavyHit = {
        "rbxassetid://3041191430",
        "rbxassetid://3802269741",
    },
    Glitch = {
        "rbxassetid://2767090000",
        "rbxassetid://5599818817",
        "rbxassetid://6527415891",
    },
    TimeStop = {
        "rbxassetid://4744477218",
        "rbxassetid://6148384813",
    },
    Water = {
        "rbxassetid://5850414902",
        "rbxassetid://6543434968",
    },
    Wind = {
        "rbxassetid://3484593077",
        "rbxassetid://624706518",
    },
}

-- Direct 2D Audio Playback by Asset ID
function SoundController.PlayAudioId2D(assetId: string, volume: number?, pitch: number?)
    if not assetId or assetId == "" or assetId == "rbxassetid://0" then return end

    local sound = Instance.new("Sound")
    sound.SoundId = assetId
    sound.Volume = volume or 0.7
    sound.PlaybackSpeed = (pitch or 1.0) * (0.96 + math.random() * 0.08)
    sound.Parent = SoundService

    sound:Play()
    sound.Ended:Once(function()
        sound:Destroy()
    end)
    Debris:AddItem(sound, 5)
end

-- Direct 3D Positional Audio Playback by Asset ID
function SoundController.PlayAudioId3D(assetId: string, position: Vector3, volume: number?, pitch: number?)
    if not assetId or assetId == "" or assetId == "rbxassetid://0" then return end

    local soundPart = Instance.new("Part")
    soundPart.Name = "SFX_DirectSpatialPart"
    soundPart.Size = Vector3.new(0.1, 0.1, 0.1)
    soundPart.CFrame = CFrame.new(position)
    soundPart.Transparency = 1
    soundPart.CanCollide = false
    soundPart.Anchored = true
    soundPart.Parent = Workspace:FindFirstChild("VFX") or Workspace

    local sound = Instance.new("Sound")
    sound.SoundId = assetId
    sound.Volume = volume or 0.85
    sound.PlaybackSpeed = (pitch or 1.0) * (0.95 + math.random() * 0.1)
    sound.RollOffMode = Enum.RollOffMode.InverseTapered
    sound.RollOffMinDistance = 12
    sound.RollOffMaxDistance = 140
    sound.Parent = soundPart

    sound:Play()
    sound.Ended:Once(function()
        soundPart:Destroy()
    end)
    Debris:AddItem(soundPart, 6)
end

-- Plays a 3D positional sound by category
function SoundController.PlaySound3D(soundCategory: string, position: Vector3, volume: number?)
    local sounds = SFX_LIBRARY[soundCategory]
    if not sounds or #sounds == 0 then return end

    local chosenId = sounds[math.random(1, #sounds)]
    SoundController.PlayAudioId3D(chosenId, position, volume)
end

-- Plays a 2D interface or HUD sound by category
function SoundController.PlaySound2D(soundCategory: string, volume: number?)
    local sounds = SFX_LIBRARY[soundCategory]
    if not sounds or #sounds == 0 then return end

    local chosenId = sounds[math.random(1, #sounds)]
    SoundController.PlayAudioId2D(chosenId, volume)
end

-- Tactile UI Audio Library with distinct modern sounds
local UI_SFX: { [string]: string } = {
    hover = "rbxassetid://6895079853",
    click = "rbxassetid://8560439519",
    open = "rbxassetid://6230938036",
    close = "rbxassetid://6241709963",
    success = "rbxasset://sounds/electronicpingshort.wav",
    spin_start = "rbxassetid://3356359494",
}

function SoundController.PlayUI(action: string)
    local soundId = UI_SFX[action] or UI_SFX.click
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = if action == "hover" then 0.22 else 0.5
    sound.PlaybackSpeed = if action == "hover" then 1.25 else 1.0
    sound.Parent = SoundService
    sound:Play()
    sound.Ended:Once(function()
        sound:Destroy()
    end)
    Debris:AddItem(sound, 3)
end

return table.freeze(SoundController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">SpinUIController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Element Spin Gacha UI Controller (Blox Fruits Modern Design)
    Features:
    - Blox Fruits Fruit Dealer aesthetic: deep dark navy cards with electric purple/cyan outlines
    - Rapid card shuffle animation with smooth ease-out deceleration
    - Void purple celebration effect for secret elements (Error, Time)
    - Live rates table with clean pill badges
    - Spin ticket counter with real-time server sync
    - NO gold or rainbow cycling
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local SharedLoader = require(script.Parent.Parent.SharedLoader)
local GameConfig = SharedLoader.GameConfig
local SoundController = require(script.Parent.SoundController)
local CameraShakeController = require(script.Parent.CameraShakeController)

local localPlayer = Players.LocalPlayer

local function GetPlayerGui(): PlayerGui?
    if not localPlayer then
        localPlayer = Players.LocalPlayer
    end
    if not localPlayer then return nil end
    return (localPlayer:FindFirstChild("PlayerGui") or localPlayer:WaitForChild("PlayerGui", 15)) :: PlayerGui?
end

local SpinUIController = {}

local spinGui: ScreenGui? = nil
local spinModal: Frame? = nil
local resultCard: Frame? = nil
local resultElementName: TextLabel? = nil
local resultRarityLabel: TextLabel? = nil
local resultCardStroke: UIStroke? = nil
local ticketCountLabel: TextLabel? = nil
local isSpinning = false

local ELEMENT_COLORS = {
    Fire  = Color3.fromRGB(255, 75, 30),
    Aqua  = Color3.fromRGB(0, 160, 255),
    Earth = Color3.fromRGB(150, 110, 65),
    Light = Color3.fromRGB(240, 220, 90),
    Wind  = Color3.fromRGB(60, 215, 150),
    Error = Color3.fromRGB(255, 20, 140),
    Time  = Color3.fromRGB(130, 80, 255),
}

local ELEMENT_RARITY = {
    Fire  = "COMMON",
    Aqua  = "COMMON",
    Earth = "COMMON",
    Light = "COMMON",
    Wind  = "COMMON",
    Error = "MYTHIC",
    Time  = "MYTHIC",
}

-- Modern Blox Fruits style rarity colors (No gold!)
local RARITY_COLORS = {
    COMMON = Color3.fromRGB(140, 150, 175),
    MYTHIC = Color3.fromRGB(160, 70, 255), -- Void Amethyst
}

local function MakeRounded(inst: GuiObject, r: number)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = inst
end

local function MakeStroke(inst: GuiObject, color: Color3, thickness: number): UIStroke
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness
    s.Parent = inst
    return s
end

function SpinUIController.Init()
    local playerGui = GetPlayerGui()
    if not playerGui then return end

    spinGui = Instance.new("ScreenGui")
    spinGui.Name = "ElementalWorlds_SpinGacha"
    spinGui.ResetOnSpawn = false
    spinGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    spinGui.Parent = playerGui

    -- HUD Toggle Button (Top-Right Widget Dock)
    local spinToggleBtn = Instance.new("TextButton")
    spinToggleBtn.Name = "SpinHUDButton"
    spinToggleBtn.Size = UDim2.new(0, 125, 0, 34)
    spinToggleBtn.Position = UDim2.new(1, -145, 0, 56)
    spinToggleBtn.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
    spinToggleBtn.Font = Enum.Font.GothamBlack
    spinToggleBtn.TextSize = 11
    spinToggleBtn.TextColor3 = Color3.fromRGB(160, 130, 255)
    spinToggleBtn.Text = "SPIN ELEMENT"
    spinToggleBtn.AutoButtonColor = false
    spinToggleBtn.Parent = spinGui
    MakeRounded(spinToggleBtn, 6)
    MakeStroke(spinToggleBtn, Color3.fromRGB(115, 90, 245), 1.5)

    spinToggleBtn.MouseEnter:Connect(function()
        TweenService:Create(spinToggleBtn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(24, 30, 48) }):Play()
        SoundController.PlayUI("hover")
    end)
    spinToggleBtn.MouseLeave:Connect(function()
        TweenService:Create(spinToggleBtn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(15, 20, 32) }):Play()
    end)

    -- Spin Modal Window (Blox Fruits Fruit Dealer Style)
    spinModal = Instance.new("Frame")
    spinModal.Name = "SpinModalWindow"
    spinModal.Size = UDim2.new(0, 520, 0, 460)
    spinModal.Position = UDim2.new(0.5, -260, 0.5, -230)
    spinModal.BackgroundColor3 = Color3.fromRGB(12, 16, 26)
    spinModal.BackgroundTransparency = 0.05
    spinModal.Visible = false
    spinModal.ZIndex = 20
    spinModal.Parent = spinGui
    MakeRounded(spinModal, 12)
    MakeStroke(spinModal, Color3.fromRGB(115, 90, 245), 2.0)

    -- Title Bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 48)
    titleBar.BackgroundColor3 = Color3.fromRGB(18, 22, 36)
    titleBar.ZIndex = 21
    titleBar.Parent = spinModal
    MakeRounded(titleBar, 12)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -60, 1, 0)
    titleLabel.Position = UDim2.new(0, 18, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.GothamBlack
    titleLabel.TextSize = 16
    titleLabel.TextColor3 = Color3.fromRGB(245, 248, 255)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Text = "ELEMENT GACHA"
    titleLabel.ZIndex = 22
    titleLabel.Parent = titleBar

    -- Close Button
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -40, 0.5, -15)
    closeBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 60)
    closeBtn.Font = Enum.Font.GothamBlack
    closeBtn.TextSize = 13
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.Text = "X"
    closeBtn.ZIndex = 22
    closeBtn.Parent = titleBar
    MakeRounded(closeBtn, 6)

    -- Result Display Card
    resultCard = Instance.new("Frame")
    resultCard.Name = "ResultCard"
    resultCard.Size = UDim2.new(0, 220, 0, 150)
    resultCard.Position = UDim2.new(0.5, -110, 0, 70)
    resultCard.BackgroundColor3 = Color3.fromRGB(18, 24, 38)
    resultCard.ZIndex = 21
    resultCard.Parent = spinModal
    MakeRounded(resultCard, 10)
    resultCardStroke = MakeStroke(resultCard, Color3.fromRGB(60, 75, 105), 2.0)

    -- Rarity Pill Badge
    resultRarityLabel = Instance.new("TextLabel")
    resultRarityLabel.Name = "RarityBadge"
    resultRarityLabel.Size = UDim2.new(0, 110, 0, 22)
    resultRarityLabel.Position = UDim2.new(0.5, -55, 0, 18)
    resultRarityLabel.BackgroundColor3 = Color3.fromRGB(26, 34, 52)
    resultRarityLabel.Font = Enum.Font.GothamBlack
    resultRarityLabel.TextSize = 11
    resultRarityLabel.TextColor3 = RARITY_COLORS.COMMON
    resultRarityLabel.Text = "COMMON"
    resultRarityLabel.ZIndex = 22
    resultRarityLabel.Parent = resultCard
    MakeRounded(resultRarityLabel, 4)

    -- Element Name
    resultElementName = Instance.new("TextLabel")
    resultElementName.Name = "ElementName"
    resultElementName.Size = UDim2.new(1, -20, 0, 48)
    resultElementName.Position = UDim2.new(0, 10, 0, 55)
    resultElementName.BackgroundTransparency = 1
    resultElementName.Font = Enum.Font.GothamBlack
    resultElementName.TextSize = 26
    resultElementName.TextColor3 = Color3.fromRGB(255, 255, 255)
    resultElementName.Text = "FIRE"
    resultElementName.ZIndex = 22
    resultElementName.Parent = resultCard

    -- Subtitle prompt
    local subPrompt = Instance.new("TextLabel")
    subPrompt.Size = UDim2.new(1, 0, 0, 20)
    subPrompt.Position = UDim2.new(0, 0, 1, -28)
    subPrompt.BackgroundTransparency = 1
    subPrompt.Font = Enum.Font.GothamMedium
    subPrompt.TextSize = 11
    subPrompt.TextColor3 = Color3.fromRGB(130, 140, 165)
    subPrompt.Text = "READY TO AWAKEN"
    subPrompt.ZIndex = 22
    subPrompt.Parent = resultCard

    -- Ticket Balance & Information
    ticketCountLabel = Instance.new("TextLabel")
    ticketCountLabel.Size = UDim2.new(1, -40, 0, 24)
    ticketCountLabel.Position = UDim2.new(0, 20, 0, 235)
    ticketCountLabel.BackgroundTransparency = 1
    ticketCountLabel.Font = Enum.Font.GothamBold
    ticketCountLabel.TextSize = 13
    ticketCountLabel.TextColor3 = Color3.fromRGB(140, 110, 255)
    ticketCountLabel.Text = "Available Spin Tickets: 1"
    ticketCountLabel.ZIndex = 21
    ticketCountLabel.Parent = spinModal

    -- Spin Action Button (Modern Solid Purple Button)
    local spinActionBtn = Instance.new("TextButton")
    spinActionBtn.Name = "SpinActionButton"
    spinActionBtn.Size = UDim2.new(0, 260, 0, 44)
    spinActionBtn.Position = UDim2.new(0.5, -130, 0, 270)
    spinActionBtn.BackgroundColor3 = Color3.fromRGB(115, 90, 245)
    spinActionBtn.Font = Enum.Font.GothamBlack
    spinActionBtn.TextSize = 14
    spinActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    spinActionBtn.Text = "ROLL ELEMENT (1 TICKET)"
    spinActionBtn.AutoButtonColor = false
    spinActionBtn.ZIndex = 21
    spinActionBtn.Parent = spinModal
    MakeRounded(spinActionBtn, 8)

    spinActionBtn.MouseEnter:Connect(function()
        TweenService:Create(spinActionBtn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(135, 110, 255) }):Play()
    end)
    spinActionBtn.MouseLeave:Connect(function()
        TweenService:Create(spinActionBtn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(115, 90, 245) }):Play()
    end)

    -- Rates Table Container
    local ratesFrame = Instance.new("Frame")
    ratesFrame.Size = UDim2.new(1, -40, 0, 115)
    ratesFrame.Position = UDim2.new(0, 20, 0, 328)
    ratesFrame.BackgroundColor3 = Color3.fromRGB(16, 20, 32)
    ratesFrame.ZIndex = 21
    ratesFrame.Parent = spinModal
    MakeRounded(ratesFrame, 8)
    MakeStroke(ratesFrame, Color3.fromRGB(35, 45, 68), 1.2)

    local ratesTitle = Instance.new("TextLabel")
    ratesTitle.Size = UDim2.new(1, -20, 0, 22)
    ratesTitle.Position = UDim2.new(0, 10, 0, 6)
    ratesTitle.BackgroundTransparency = 1
    ratesTitle.Font = Enum.Font.GothamBold
    ratesTitle.TextSize = 11
    ratesTitle.TextColor3 = Color3.fromRGB(140, 150, 175)
    ratesTitle.TextXAlignment = Enum.TextXAlignment.Left
    ratesTitle.Text = "DROP RATES"
    ratesTitle.ZIndex = 22
    ratesTitle.Parent = ratesFrame

    local ratesContent = Instance.new("TextLabel")
    ratesContent.Size = UDim2.new(1, -20, 0, 75)
    ratesContent.Position = UDim2.new(0, 10, 0, 30)
    ratesContent.BackgroundTransparency = 1
    ratesContent.Font = Enum.Font.GothamMedium
    ratesContent.TextSize = 11
    ratesContent.TextColor3 = Color3.fromRGB(190, 200, 225)
    ratesContent.TextXAlignment = Enum.TextXAlignment.Left
    ratesContent.TextYAlignment = Enum.TextYAlignment.Top
    ratesContent.Text = "Fire, Aqua, Earth, Light, Wind: 19.96% each\nMythic Secrets: Error (0.10%) | Time (0.10%)\nFirst 5,000 players to claim receive guaranteed Mythic allocation!"
    ratesContent.ZIndex = 22
    ratesContent.Parent = ratesFrame

    -- Toggle & Close Logic
    local function ToggleModal()
        spinModal.Visible = not spinModal.Visible
        if spinModal.Visible then
            SoundController.PlayUI("open")
            spinModal.Position = UDim2.new(0.5, -260, 0.5, -210)
            TweenService:Create(spinModal, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, -260, 0.5, -230),
            }):Play()
        else
            SoundController.PlayUI("close")
        end
    end

    spinToggleBtn.MouseButton1Click:Connect(ToggleModal)
    closeBtn.MouseButton1Click:Connect(ToggleModal)

    -- Spin Action
    spinActionBtn.MouseButton1Click:Connect(function()
        if isSpinning then return end
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if not remotes then return end
        local rollEvent = remotes:FindFirstChild(GameConfig.REMOTES.ROLL_ELEMENT) :: RemoteEvent?
        if rollEvent then
            rollEvent:FireServer()
        end
    end)
end

-- Displays the roll result with accelerating/decelerating shuffle animation
function SpinUIController.ShowRollResult(rolledElement: string)
    if not resultCard or not resultElementName or not resultRarityLabel or not resultCardStroke then
        return
    end

    isSpinning = true
    SoundController.PlayUI("spin_start")

    -- Shuffle through elements
    local candidates = { "Fire", "Aqua", "Earth", "Light", "Wind", "Error", "Time" }
    local totalTicks = 18
    local tickDelay = 0.04

    task.spawn(function()
        for i = 1, totalTicks do
            local randomElem = candidates[math.random(1, #candidates)]
            resultElementName.Text = string.upper(randomElem)
            resultElementName.TextColor3 = ELEMENT_COLORS[randomElem] or Color3.fromRGB(255, 255, 255)
            SoundController.PlayUI("hover")
            task.wait(tickDelay)
            tickDelay = tickDelay * 1.15 -- Smooth deceleration
        end

        -- Land on the final result
        resultElementName.Text = string.upper(rolledElement)
        local elemColor = ELEMENT_COLORS[rolledElement] or Color3.fromRGB(255, 255, 255)
        resultElementName.TextColor3 = elemColor

        local rarity = ELEMENT_RARITY[rolledElement] or "COMMON"
        resultRarityLabel.Text = rarity
        local rarityColor = RARITY_COLORS[rarity] or RARITY_COLORS.COMMON
        resultRarityLabel.TextColor3 = rarityColor

        -- Border animation
        TweenService:Create(resultCardStroke, TweenInfo.new(0.3), { Color = elemColor }):Play()

        -- Mythic Secret Celebration (Error or Time)
        if rarity == "MYTHIC" then
            SoundController.PlaySound2D("MagicCast", 1.0)
            CameraShakeController.Shake(0.6)

            -- Electric violet pulse
            for _ = 1, 3 do
                TweenService:Create(resultCardStroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(200, 80, 255), Thickness = 4.0 }):Play()
                task.wait(0.16)
                TweenService:Create(resultCardStroke, TweenInfo.new(0.15), { Color = elemColor, Thickness = 2.0 }):Play()
                task.wait(0.16)
            end
        else
            SoundController.PlayUI("success")
        end

        isSpinning = false
    end)
end

function SpinUIController.UpdateTickets(count: number)
    if ticketCountLabel then
        ticketCountLabel.Text = string.format("Available Spin Tickets: %d", count)
    end
end

return table.freeze(SpinUIController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Master Anime Combat HUD (Blox Fruits Modern Design)
    
    Aesthetic rules:
    - NO gold or rainbow cycling
    - Deep obsidian-navy cards (Color3.fromRGB(12, 16, 24))
    - Dual Stats: Emerald Health Bar + Electric Cyan Energy Bar (Blox Fruits signature)
    - Hotbar supporting [Z], [X], [C], [V], and [Q] Dash + M1
    - Cooldown swipe with bold countdown and off-cooldown flash
    - Floating combo counter with elastic bounce
    - Clean side menu buttons (MENU, SPIN, SHOP, CREATOR SUITE)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SharedLoader = require(script.Parent.Parent.SharedLoader)
local GameConfig = SharedLoader.GameConfig
local AbilityConfig = SharedLoader.AbilityConfig
local SoundController = require(script.Parent.SoundController)

local localPlayer = Players.LocalPlayer

local function GetPlayerGui(): PlayerGui?
    if not localPlayer then
        localPlayer = Players.LocalPlayer
    end
    if not localPlayer then return nil end
    return (localPlayer:FindFirstChild("PlayerGui") or localPlayer:WaitForChild("PlayerGui", 15)) :: PlayerGui?
end

local UIController = {}

-- Modern Blox Fruits Color Tokens
local PALETTE = {
    BG_MAIN         = Color3.fromRGB(12, 16, 26),
    BG_CARD         = Color3.fromRGB(18, 24, 38),
    BG_SLOT         = Color3.fromRGB(15, 20, 34),
    BORDER_DEFAULT  = Color3.fromRGB(45, 55, 80),
    BORDER_ACCENT   = Color3.fromRGB(115, 90, 245),
    TEXT_PRIMARY    = Color3.fromRGB(245, 248, 255),
    TEXT_MUTED      = Color3.fromRGB(135, 145, 170),
    HP_GREEN        = Color3.fromRGB(46, 204, 113),
    HP_ORANGE       = Color3.fromRGB(230, 126, 34),
    HP_RED          = Color3.fromRGB(231, 76, 60),
    HP_CHIP         = Color3.fromRGB(140, 30, 30),
    ENERGY_CYAN     = Color3.fromRGB(0, 165, 255),
    ENERGY_DARK     = Color3.fromRGB(10, 60, 110),
}

-- Curated Element Accents (No gold, clean vibrant anime tones)
local ELEMENT_THEMES = {
    Fire  = { Primary = Color3.fromRGB(255, 75, 30),  Accent = Color3.fromRGB(255, 130, 50) },
    Aqua  = { Primary = Color3.fromRGB(0, 160, 255),  Accent = Color3.fromRGB(100, 215, 255) },
    Earth = { Primary = Color3.fromRGB(150, 110, 65), Accent = Color3.fromRGB(200, 160, 110) },
    Light = { Primary = Color3.fromHex("#C8A2F0"), Accent = Color3.fromHex("#E9D8FF") },
    Wind  = { Primary = Color3.fromRGB(60, 215, 150), Accent = Color3.fromRGB(160, 255, 210) },
    Error = { Primary = Color3.fromRGB(255, 20, 140), Accent = Color3.fromRGB(0, 255, 240) },
    Time  = { Primary = Color3.fromRGB(120, 80, 255), Accent = Color3.fromRGB(190, 160, 255) },
}

-- GUI References
local screenGui: ScreenGui? = nil
local healthFill: Frame? = nil
local healthChip: Frame? = nil
local healthText: TextLabel? = nil
local energyFill: Frame? = nil
local energyText: TextLabel? = nil
local levelBadgeText: TextLabel? = nil
local elementTagText: TextLabel? = nil
local elementTagFrame: Frame? = nil
local spinTicketText: TextLabel? = nil
local fragmentsText: TextLabel? = nil
local chargesText: TextLabel? = nil
local comboLabel: TextLabel? = nil
local announcementBanner: Frame? = nil
local announcementLabel: TextLabel? = nil
local fragmentNotif: Frame? = nil
local fragmentLabel: TextLabel? = nil
local regionLabel: TextLabel? = nil
local blindOverlay: Frame? = nil
local errorMeterContainer: Frame? = nil
local errorMeterFill: Frame? = nil
local errorMeterText: TextLabel? = nil
local avatarStroke: UIStroke? = nil
local avatarImage: ImageLabel? = nil

local abilityButtons: { [string]: {
    Button: TextButton,
    CooldownOverlay: Frame,
    CooldownText: TextLabel,
    NameLabel: TextLabel,
    KeyLabel: TextLabel,
    Stroke: UIStroke,
} } = {}

-- State
local currentHealth = 100
local currentMaxHealth = 100
local currentEnergy = 500
local maxEnergy = 500
local currentCombo = 0
local lastComboTime = 0.0

local function MakeCorner(inst: GuiObject, r: number)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = inst
end

local function MakeStroke(inst: GuiObject, color: Color3, thickness: number): UIStroke
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

local function MakeGradient(inst: GuiObject, colorSeq: ColorSequence, rot: number?)
    local g = Instance.new("UIGradient")
    g.Color = colorSeq
    g.Rotation = rot or 90
    g.Parent = inst
    return g
end

-- ==================== CREATE HUD ====================
function UIController.CreateHUD()
    local playerGui = GetPlayerGui()
    if not playerGui then
        warn("[UIController] PlayerGui not available yet.")
        return
    end

    if screenGui and screenGui.Parent == playerGui then
        return
    end

    local existing = playerGui:FindFirstChild("ElementalWorlds_BloxFruitsHUD") :: ScreenGui?
    if existing then
        screenGui = existing
        return
    end

    screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ElementalWorlds_BloxFruitsHUD"
    screenGui.ResetOnSpawn = false
    screenGui.DisplayOrder = 10
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = playerGui

    -- ==================== 1. ROBLOX STYLE STATUS HUD (Top-Left) ====================
    local statsCard = Instance.new("Frame")
    statsCard.Name = "RobloxStatusHUD"
    statsCard.Size = UDim2.new(0, 290, 0, 72)
    statsCard.Position = UDim2.new(0, 16, 0, 14)
    statsCard.BackgroundColor3 = Color3.fromRGB(15, 18, 26)
    statsCard.BackgroundTransparency = 0.2
    statsCard.Parent = screenGui
    MakeCorner(statsCard, 6)
    MakeStroke(statsCard, Color3.fromRGB(45, 55, 75), 1.2)

    -- Top Row: Level Badge + Element Badge + Charges / Spins
    local topRow = Instance.new("Frame")
    topRow.Name = "TopRow"
    topRow.Size = UDim2.new(1, -16, 0, 18)
    topRow.Position = UDim2.new(0, 8, 0, 6)
    topRow.BackgroundTransparency = 1
    topRow.Parent = statsCard

    levelBadgeText = Instance.new("TextLabel")
    levelBadgeText.Size = UDim2.new(0, 48, 1, 0)
    levelBadgeText.Position = UDim2.new(0, 0, 0, 0)
    levelBadgeText.BackgroundTransparency = 1
    levelBadgeText.Font = Enum.Font.GothamBlack
    levelBadgeText.TextSize = 11
    levelBadgeText.TextColor3 = Color3.fromRGB(255, 255, 255)
    levelBadgeText.TextXAlignment = Enum.TextXAlignment.Left
    levelBadgeText.Text = "Lv. 1"
    levelBadgeText.Parent = topRow

    elementTagFrame = Instance.new("Frame")
    elementTagFrame.Name = "ElementBadge"
    elementTagFrame.Size = UDim2.new(0, 58, 1, 0)
    elementTagFrame.Position = UDim2.new(0, 48, 0, 0)
    elementTagFrame.BackgroundColor3 = Color3.fromRGB(24, 30, 44)
    elementTagFrame.Parent = topRow
    MakeCorner(elementTagFrame, 4)
    local elemStroke = MakeStroke(elementTagFrame, Color3.fromRGB(80, 100, 130), 1.0)

    elementTagText = Instance.new("TextLabel")
    elementTagText.Size = UDim2.new(1, 0, 1, 0)
    elementTagText.BackgroundTransparency = 1
    elementTagText.Font = Enum.Font.GothamBold
    elementTagText.TextSize = 10
    elementTagText.TextColor3 = Color3.fromRGB(255, 100, 40)
    elementTagText.Text = "FIRE"
    elementTagText.Parent = elementTagFrame

    spinTicketText = Instance.new("TextLabel")
    spinTicketText.Name = "CurrencyInfo"
    spinTicketText.Size = UDim2.new(1, -112, 1, 0)
    spinTicketText.Position = UDim2.new(0, 112, 0, 0)
    spinTicketText.BackgroundTransparency = 1
    spinTicketText.Font = Enum.Font.GothamMedium
    spinTicketText.TextSize = 10
    spinTicketText.TextColor3 = Color3.fromRGB(180, 192, 210)
    spinTicketText.TextXAlignment = Enum.TextXAlignment.Right
    spinTicketText.Text = "Charges: 0 | Spins: 1"
    spinTicketText.Parent = topRow

    -- Health Bar Track (Emerald Green with damage chip)
    local hpTrack = Instance.new("Frame")
    hpTrack.Name = "HealthTrack"
    hpTrack.Size = UDim2.new(1, -16, 0, 18)
    hpTrack.Position = UDim2.new(0, 8, 0, 27)
    hpTrack.BackgroundColor3 = Color3.fromRGB(10, 14, 20)
    hpTrack.Parent = statsCard
    MakeCorner(hpTrack, 4)
    MakeStroke(hpTrack, Color3.fromRGB(30, 40, 55), 1.0)

    healthChip = Instance.new("Frame")
    healthChip.Name = "HealthChip"
    healthChip.Size = UDim2.new(1, 0, 1, 0)
    healthChip.BackgroundColor3 = Color3.fromRGB(130, 30, 30)
    healthChip.BorderSizePixel = 0
    healthChip.Parent = hpTrack
    MakeCorner(healthChip, 4)

    healthFill = Instance.new("Frame")
    healthFill.Name = "HealthFill"
    healthFill.Size = UDim2.new(1, 0, 1, 0)
    healthFill.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    healthFill.BorderSizePixel = 0
    healthFill.Parent = hpTrack
    MakeCorner(healthFill, 4)

    healthText = Instance.new("TextLabel")
    healthText.Size = UDim2.new(1, 0, 1, 0)
    healthText.BackgroundTransparency = 1
    healthText.Font = Enum.Font.GothamBold
    healthText.TextSize = 10
    healthText.TextColor3 = Color3.fromRGB(255, 255, 255)
    healthText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    healthText.TextStrokeTransparency = 0.5
    healthText.TextXAlignment = Enum.TextXAlignment.Center
    healthText.Text = "100 / 100"
    healthText.Parent = hpTrack

    -- Energy Bar Track (Electric Cyan)
    local energyTrack = Instance.new("Frame")
    energyTrack.Name = "EnergyTrack"
    energyTrack.Size = UDim2.new(1, -16, 0, 15)
    energyTrack.Position = UDim2.new(0, 8, 0, 49)
    energyTrack.BackgroundColor3 = Color3.fromRGB(8, 16, 26)
    energyTrack.Parent = statsCard
    MakeCorner(energyTrack, 4)
    MakeStroke(energyTrack, Color3.fromRGB(20, 42, 68), 1.0)

    energyFill = Instance.new("Frame")
    energyFill.Name = "EnergyFill"
    energyFill.Size = UDim2.new(1, 0, 1, 0)
    energyFill.BackgroundColor3 = Color3.fromRGB(0, 165, 255)
    energyFill.BorderSizePixel = 0
    energyFill.Parent = energyTrack
    MakeCorner(energyFill, 4)

    energyText = Instance.new("TextLabel")
    energyText.Size = UDim2.new(1, 0, 1, 0)
    energyText.BackgroundTransparency = 1
    energyText.Font = Enum.Font.GothamBold
    energyText.TextSize = 9
    energyText.TextColor3 = Color3.fromRGB(255, 255, 255)
    energyText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    energyText.TextStrokeTransparency = 0.5
    energyText.TextXAlignment = Enum.TextXAlignment.Center
    energyText.Text = "500 / 500"
    energyText.Parent = energyTrack

    -- Smooth energy regeneration loop
    task.spawn(function()
        while true do
            if currentEnergy < maxEnergy then
                currentEnergy = math.min(maxEnergy, currentEnergy + 15)
                UIController.SetEnergy(currentEnergy, maxEnergy)
            end
            task.wait(0.2)
        end
    end)

    -- ==================== 2. MASTER ANIME ABILITY HOTBAR (Bottom-Center) ====================
    local hotbar = Instance.new("Frame")
    hotbar.Name = "AbilityHotbar"
    hotbar.Size = UDim2.new(0, 540, 0, 74)
    hotbar.AnchorPoint = Vector2.new(0.5, 1)
    hotbar.Position = UDim2.new(0.5, 0, 1, -16)
    hotbar.BackgroundTransparency = 1
    hotbar.Parent = screenGui

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.Padding = UDim.new(0, 8)
    layout.Parent = hotbar

    -- Hotbar slots matching top anime RPG conventions: M1 + 4 moves + Secret (5) + Q Dash!
    local slots = {
        { slot = "M1",   key = "M1", name = "Basic Attack" },
        { slot = "1",    key = "Z",  name = "Move 1" },
        { slot = "2",    key = "X",  name = "Move 2" },
        { slot = "3",    key = "C",  name = "Move 3" },
        { slot = "4",    key = "V",  name = "Move 4" },
        { slot = "5",    key = "B",  name = "Secret" },
        { slot = "Dash", key = "Q",  name = "Dash" },
    }

    for _, slotInfo in slots do
        local slot = slotInfo.slot
        local btn = Instance.new("TextButton")
        btn.Name = "Slot_" .. slot
        btn.Size = UDim2.new(0, 68, 0, 68)
        btn.BackgroundColor3 = PALETTE.BG_SLOT
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.Parent = hotbar
        MakeCorner(btn, 8)
        local btnStroke = MakeStroke(btn, PALETTE.BORDER_DEFAULT, 1.8)

        -- Keybind Badge [Z], [X], [C], [V], [Q]
        local keyBadge = Instance.new("Frame")
        keyBadge.Size = UDim2.new(0, 22, 0, 18)
        keyBadge.Position = UDim2.new(0, 5, 0, 5)
        keyBadge.BackgroundColor3 = PALETTE.BG_CARD
        keyBadge.Parent = btn
        MakeCorner(keyBadge, 4)

        local keyText = Instance.new("TextLabel")
        keyText.Size = UDim2.new(1, 0, 1, 0)
        keyText.BackgroundTransparency = 1
        keyText.Font = Enum.Font.GothamBlack
        keyText.TextSize = 10
        keyText.TextColor3 = PALETTE.BORDER_ACCENT
        keyText.Text = slotInfo.key
        keyText.Parent = keyBadge

        -- Ability Name
        local nameLbl = Instance.new("TextLabel")
        nameLbl.Name = "AbilityName"
        nameLbl.Size = UDim2.new(1, -8, 0, 36)
        nameLbl.Position = UDim2.new(0, 4, 1, -40)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 10
        nameLbl.TextWrapped = true
        nameLbl.TextColor3 = PALETTE.TEXT_PRIMARY
        nameLbl.Text = slotInfo.name
        nameLbl.Parent = btn

        -- Translucent vertical wipe cooldown overlay
        local cdOverlay = Instance.new("Frame")
        cdOverlay.Name = "CooldownOverlay"
        cdOverlay.Size = UDim2.new(1, 0, 0, 0)
        cdOverlay.Position = UDim2.new(0, 0, 1, 0)
        cdOverlay.AnchorPoint = Vector2.new(0, 1)
        cdOverlay.BackgroundColor3 = Color3.fromRGB(6, 8, 14)
        cdOverlay.BackgroundTransparency = 0.28
        cdOverlay.Visible = false
        cdOverlay.Parent = btn
        MakeCorner(cdOverlay, 8)

        local cdText = Instance.new("TextLabel")
        cdText.Size = UDim2.new(1, 0, 1, 0)
        cdText.BackgroundTransparency = 1
        cdText.Font = Enum.Font.GothamBlack
        cdText.TextSize = 17
        cdText.TextColor3 = PALETTE.TEXT_PRIMARY
        cdText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        cdText.TextStrokeTransparency = 0.3
        cdText.Text = ""
        cdText.Parent = cdOverlay

        -- Hover and tactile press animations
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), { Size = UDim2.new(0, 72, 0, 72), BackgroundColor3 = PALETTE.BG_CARD }):Play()
            SoundController.PlayUI("hover")
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), { Size = UDim2.new(0, 68, 0, 68), BackgroundColor3 = PALETTE.BG_SLOT }):Play()
        end)
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                TweenService:Create(btn, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 63, 0, 63) }):Play()
                task.delay(0.08, function()
                    TweenService:Create(btn, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 68, 0, 68) }):Play()
                end)
                local combatController = require(script.Parent.CombatController)
                combatController.Cast(slot)
            end
        end)

        abilityButtons[slot] = {
            Button = btn,
            CooldownOverlay = cdOverlay,
            CooldownText = cdText,
            NameLabel = nameLbl,
            KeyLabel = keyText,
            Stroke = btnStroke,
        }
    end

    -- ==================== 3. ERROR METER (For Secret Error Element) ====================
    errorMeterContainer = Instance.new("Frame")
    errorMeterContainer.Name = "ErrorMeter"
    errorMeterContainer.Size = UDim2.new(0, 420, 0, 22)
    errorMeterContainer.AnchorPoint = Vector2.new(0.5, 1)
    errorMeterContainer.Position = UDim2.new(0.5, 0, 1, -94)
    errorMeterContainer.BackgroundColor3 = Color3.fromRGB(16, 10, 24)
    errorMeterContainer.Visible = false
    errorMeterContainer.Parent = screenGui
    MakeCorner(errorMeterContainer, 6)
    MakeStroke(errorMeterContainer, Color3.fromRGB(255, 20, 140), 1.5)

    errorMeterFill = Instance.new("Frame")
    errorMeterFill.Size = UDim2.new(0, 0, 1, 0)
    errorMeterFill.BackgroundColor3 = Color3.fromRGB(255, 20, 140)
    errorMeterFill.BorderSizePixel = 0
    errorMeterFill.Parent = errorMeterContainer
    MakeCorner(errorMeterFill, 6)
    MakeGradient(errorMeterFill, ColorSequence.new(Color3.fromRGB(255, 20, 140), Color3.fromRGB(0, 240, 255)), 0)

    errorMeterText = Instance.new("TextLabel")
    errorMeterText.Size = UDim2.new(1, 0, 1, 0)
    errorMeterText.BackgroundTransparency = 1
    errorMeterText.Font = Enum.Font.GothamBlack
    errorMeterText.TextSize = 11
    errorMeterText.TextColor3 = PALETTE.TEXT_PRIMARY
    errorMeterText.Text = "ERROR METER: 0%"
    errorMeterText.Parent = errorMeterContainer

    -- ==================== 4. BLOX FRUITS COMBO COUNTER ====================
    comboLabel = Instance.new("TextLabel")
    comboLabel.Name = "BloxFruitsCombo"
    comboLabel.Size = UDim2.new(0, 240, 0, 48)
    comboLabel.Position = UDim2.new(0.12, 0, 0.45, 0)
    comboLabel.BackgroundTransparency = 1
    comboLabel.Font = Enum.Font.GothamBlack
    comboLabel.TextSize = 34
    comboLabel.TextColor3 = PALETTE.TEXT_PRIMARY
    comboLabel.TextStrokeColor3 = Color3.fromRGB(15, 20, 32)
    comboLabel.TextStrokeTransparency = 0.2
    comboLabel.TextXAlignment = Enum.TextXAlignment.Left
    comboLabel.Visible = false
    comboLabel.Text = "COMBO x3"
    comboLabel.Parent = screenGui

    -- ==================== 5. ANNOUNCEMENT BANNER ====================
    announcementBanner = Instance.new("Frame")
    announcementBanner.Name = "AnnouncementBanner"
    announcementBanner.Size = UDim2.new(0, 620, 0, 44)
    announcementBanner.Position = UDim2.new(0.5, -310, 0, 36)
    announcementBanner.BackgroundColor3 = PALETTE.BG_MAIN
    announcementBanner.BackgroundTransparency = 0.12
    announcementBanner.Visible = false
    announcementBanner.Parent = screenGui
    MakeCorner(announcementBanner, 8)
    MakeStroke(announcementBanner, PALETTE.BORDER_ACCENT, 1.8)

    announcementLabel = Instance.new("TextLabel")
    announcementLabel.Size = UDim2.new(1, -20, 1, 0)
    announcementLabel.Position = UDim2.new(0, 10, 0, 0)
    announcementLabel.BackgroundTransparency = 1
    announcementLabel.Font = Enum.Font.GothamBlack
    announcementLabel.TextSize = 14
    announcementLabel.TextColor3 = PALETTE.TEXT_PRIMARY
    announcementLabel.Text = ""
    announcementLabel.Parent = announcementBanner

    -- ==================== 6. FRAGMENT NOTIFICATION ====================
    fragmentNotif = Instance.new("Frame")
    fragmentNotif.Name = "FragmentNotif"
    fragmentNotif.Size = UDim2.new(0, 340, 0, 52)
    fragmentNotif.Position = UDim2.new(1, -360, 0.5, -26)
    fragmentNotif.BackgroundColor3 = PALETTE.BG_MAIN
    fragmentNotif.BackgroundTransparency = 0.12
    fragmentNotif.Visible = false
    fragmentNotif.Parent = screenGui
    MakeCorner(fragmentNotif, 8)
    MakeStroke(fragmentNotif, PALETTE.ENERGY_CYAN, 2.0)

    fragmentLabel = Instance.new("TextLabel")
    fragmentLabel.Size = UDim2.new(1, -16, 1, 0)
    fragmentLabel.Position = UDim2.new(0, 8, 0, 0)
    fragmentLabel.BackgroundTransparency = 1
    fragmentLabel.Font = Enum.Font.GothamBold
    fragmentLabel.TextSize = 13
    fragmentLabel.TextColor3 = PALETTE.TEXT_PRIMARY
    fragmentLabel.TextXAlignment = Enum.TextXAlignment.Left
    fragmentLabel.TextWrapped = true
    fragmentLabel.Text = "Fragment Discovered!"
    fragmentLabel.Parent = fragmentNotif

    -- ==================== 7. REGION BADGE (Top-Right) ====================
    local regionFrame = Instance.new("Frame")
    regionFrame.Size = UDim2.new(0, 200, 0, 32)
    regionFrame.Position = UDim2.new(1, -220, 0, 16)
    regionFrame.BackgroundColor3 = PALETTE.BG_MAIN
    regionFrame.BackgroundTransparency = 0.15
    regionFrame.Parent = screenGui
    MakeCorner(regionFrame, 6)
    MakeStroke(regionFrame, PALETTE.BORDER_DEFAULT, 1.2)

    regionLabel = Instance.new("TextLabel")
    regionLabel.Size = UDim2.new(1, -16, 1, 0)
    regionLabel.Position = UDim2.new(0, 8, 0, 0)
    regionLabel.BackgroundTransparency = 1
    regionLabel.Font = Enum.Font.GothamBold
    regionLabel.TextSize = 12
    regionLabel.TextColor3 = PALETTE.TEXT_MUTED
    regionLabel.TextXAlignment = Enum.TextXAlignment.Right
    regionLabel.Text = "Ember Highlands"
    regionLabel.Parent = regionFrame

    -- Blind Flash Overlay
    blindOverlay = Instance.new("Frame")
    blindOverlay.Name = "BlindOverlay"
    blindOverlay.Size = UDim2.new(1, 0, 1, 0)
    blindOverlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    blindOverlay.BackgroundTransparency = 1
    blindOverlay.ZIndex = 80
    blindOverlay.Parent = screenGui
end

-- ==================== HEALTH UPDATES ====================
function UIController.SetHealth(newHealth: number, maxHealth: number)
    currentHealth = math.clamp(newHealth, 0, maxHealth)
    currentMaxHealth = maxHealth

    local ratio = math.clamp(currentHealth / currentMaxHealth, 0, 1)

    if healthText then
        healthText.Text = string.format("%d / %d", math.round(currentHealth), math.round(currentMaxHealth))
    end

    if healthFill then
        healthFill.Size = UDim2.new(ratio, 0, 1, 0)
        -- Dynamic shift: Emerald green > Orange > Crimson
        healthFill.BackgroundColor3 = (ratio > 0.5)
            and PALETTE.HP_GREEN
            or (ratio > 0.25 and PALETTE.HP_ORANGE or PALETTE.HP_RED)
    end

    -- Catch-up damage chip
    if healthChip then
        task.delay(0.25, function()
            if healthChip then
                TweenService:Create(healthChip, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                    Size = UDim2.new(ratio, 0, 1, 0),
                }):Play()
            end
        end)
    end
end

-- ==================== ENERGY / STAMINA ====================
function UIController.SetEnergy(newEnergy: number, maxEng: number)
    currentEnergy = math.clamp(newEnergy, 0, maxEng)
    maxEnergy = maxEng

    local ratio = math.clamp(currentEnergy / maxEnergy, 0, 1)
    if energyFill then
        energyFill.Size = UDim2.new(ratio, 0, 1, 0)
    end
    if energyText then
        energyText.Text = string.format("%d / %d", math.round(currentEnergy), math.round(maxEnergy))
    end
end

function UIController.ConsumeEnergy(amount: number): boolean
    if currentEnergy >= amount then
        currentEnergy -= amount
        UIController.SetEnergy(currentEnergy, maxEnergy)
        return true
    end
    return false
end

-- ==================== COMBO COUNTER ====================
function UIController.RegisterComboHit(count: number)
    currentCombo = count
    lastComboTime = os.clock()

    if comboLabel then
        comboLabel.Text = string.format("COMBO x%d", count)
        comboLabel.Visible = true
        comboLabel.TextSize = 42
        comboLabel.TextColor3 = if count >= 4 then PALETTE.BORDER_ACCENT else PALETTE.TEXT_PRIMARY

        TweenService:Create(comboLabel, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            TextSize = 34,
        }):Play()

        task.delay(1.5, function()
            if os.clock() - lastComboTime >= 1.4 then
                if comboLabel then
                    local t = TweenService:Create(comboLabel, TweenInfo.new(0.25), { TextTransparency = 1 })
                    t:Play()
                    t.Completed:Wait()
                    comboLabel.Visible = false
                    comboLabel.TextTransparency = 0
                end
            end
        end)
    end
end

-- ==================== STATS SYNC ====================
function UIController.UpdateStats(data: {
    Level: number,
    Charges: number,
    Element: string,
    ErrorMeter: number,
    MaxHealth: number,
    SpinTickets: number?,
})
    if levelBadgeText then
        levelBadgeText.Text = "Lv. " .. tostring(data.Level)
    end

    if spinTicketText then
        spinTicketText.Text = string.format("Spins: %d | Charges: %d", data.SpinTickets or 0, data.Charges)
    end

    local theme = ELEMENT_THEMES[data.Element] or ELEMENT_THEMES.Fire
    if elementTagText then
        elementTagText.Text = string.upper(data.Element)
        elementTagText.TextColor3 = theme.Primary
    end
    if elementTagFrame then
        local stroke = elementTagFrame:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = theme.Primary
        end
    end
    if avatarStroke then
        avatarStroke.Color = theme.Primary
    end

    -- Update slot labels and borders
    for slot, btnData in abilityButtons do
        if slot == "Dash" then
            btnData.NameLabel.Text = "Dash"
        else
            local ability = AbilityConfig.GetAbility(data.Element, slot)
            if ability then
                btnData.NameLabel.Text = ability.Name
            end
        end
        TweenService:Create(btnData.Stroke, TweenInfo.new(0.3), { Color = theme.Primary }):Play()
    end

    -- Error meter
    if errorMeterContainer and errorMeterFill and errorMeterText then
        local isError = (data.Element == "Error")
        errorMeterContainer.Visible = isError
        if isError then
            local pct = math.round(data.ErrorMeter)
            if pct >= 100 then
                errorMeterText.Text = "ERROR METER: 100% [MAX POWER: UNPARALLELED READY]"
            elseif pct >= 50 then
                errorMeterText.Text = string.format("ERROR METER: %d%% [DOMAIN UNLOCKED] (100%%: Freeze)", pct)
            else
                errorMeterText.Text = string.format("ERROR METER: %d%% (50%%: Domain | 100%%: Freeze)", pct)
            end
        end
    end

    if abilityButtons["5"] then
        abilityButtons["5"].Button.Visible = (data.Element == "Error")
    end

    UIController.SetHealth(currentHealth, data.MaxHealth)
end

-- ==================== COOLDOWN TIMER & READY FLASH ====================
function UIController.StartCooldown(slot: string, durationSeconds: number)
    local btnData = abilityButtons[slot]
    if not btnData then return end

    local overlay = btnData.CooldownOverlay
    local cdText = btnData.CooldownText

    overlay.Visible = true
    overlay.Size = UDim2.new(1, 0, 1, 0)

    local startTime = os.clock()
    task.spawn(function()
        while true do
            local elapsed = os.clock() - startTime
            local remaining = math.max(0, durationSeconds - elapsed)

            if remaining <= 0 then
                overlay.Visible = false
                cdText.Text = ""

                -- Off-cooldown flash effect!
                local origColor = btnData.Stroke.Color
                TweenService:Create(btnData.Stroke, TweenInfo.new(0.08), { Color = Color3.fromRGB(255, 255, 255), Thickness = 3.2 }):Play()
                task.delay(0.15, function()
                    TweenService:Create(btnData.Stroke, TweenInfo.new(0.2), { Color = origColor, Thickness = 1.8 }):Play()
                end)
                break
            end

            cdText.Text = string.format("%.1f", remaining)
            overlay.Size = UDim2.new(1, 0, remaining / durationSeconds, 0)
            task.wait(0.04)
        end
    end)
end

-- ==================== ANNOUNCEMENTS ====================
function UIController.ShowAnnouncement(text: string)
    if not announcementBanner or not announcementLabel then return end

    announcementLabel.Text = text
    announcementBanner.Visible = true
    announcementBanner.BackgroundTransparency = 0.12
    announcementLabel.TextTransparency = 0

    task.delay(4.0, function()
        if announcementBanner then
            local t = TweenService:Create(announcementBanner, TweenInfo.new(0.6), { BackgroundTransparency = 1 })
            TweenService:Create(announcementLabel, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
            t:Play()
            t.Completed:Wait()
            announcementBanner.Visible = false
            announcementLabel.TextTransparency = 0
        end
    end)
end

-- ==================== FRAGMENT NOTIFICATION ====================
function UIController.ShowFragmentCollected(fragmentName: string)
    if not fragmentNotif or not fragmentLabel then return end

    fragmentLabel.Text = "[FRAGMENT DISCOVERED]\n" .. fragmentName
    fragmentNotif.Visible = true
    fragmentNotif.Position = UDim2.new(1, 10, 0.5, -26)

    TweenService:Create(fragmentNotif, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -360, 0.5, -26),
    }):Play()

    task.delay(3.5, function()
        if fragmentNotif then
            local t = TweenService:Create(fragmentNotif, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(1, 10, 0.5, -26),
            })
            t:Play()
            t.Completed:Wait()
            fragmentNotif.Visible = false
        end
    end)
end

function UIController.SetRegion(regionName: string)
    if regionLabel then
        regionLabel.Text = regionName
    end
end

function UIController.TriggerBlind(durationSeconds: number)
    if not blindOverlay then return end
    blindOverlay.BackgroundTransparency = 0
    TweenService:Create(blindOverlay, TweenInfo.new(durationSeconds, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
        BackgroundTransparency = 1,
    }):Play()
end

return table.freeze(UIController)
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Master VFX Controller (Top-Tier Stylized Anime Combat)
    Orchestrates high-fidelity anime effects:
    - Anime Impact Frames (Negative Contrast / Monochrome Inversion flash)
    - Stylized Torus shockwaves & multi-tier ground craters
    - Dual-Core Energy Beams & Anime Crescent Slash Arcs
    - Converging energy charge wind-ups
    - 3D damage numbers, camera trauma shake, and spatial audio
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local SharedLoader = require(script.Parent.Parent.SharedLoader)
local GameConfig = SharedLoader.GameConfig
local VFXHelper = SharedLoader.VFXHelper

local UIController = require(script.Parent.UIController)
local SoundController = require(script.Parent.SoundController)
local CameraShakeController = require(script.Parent.CameraShakeController)
local DamageNumbersController = require(script.Parent.DamageNumbersController)

local VFXController = {}

-- Anime Impact Frame ColorCorrection in Lighting
local impactCorrection: ColorCorrectionEffect? = nil

local function EnsureImpactCorrection(): ColorCorrectionEffect
    if not impactCorrection or not impactCorrection.Parent then
        local existing = Lighting:FindFirstChild("AnimeImpactFrame") :: ColorCorrectionEffect?
        if existing then
            impactCorrection = existing
        else
            local cc = Instance.new("ColorCorrectionEffect")
            cc.Name = "AnimeImpactFrame"
            cc.Contrast = 0
            cc.Brightness = 0
            cc.Saturation = 0
            cc.Enabled = false
            cc.Parent = Lighting
            impactCorrection = cc
        end
    end
    return impactCorrection :: ColorCorrectionEffect
end

-- Triggers a stylized anime negative contrast impact flash
function VFXController.TriggerImpactFrame(duration: number?, intensity: number?)
    local cc = EnsureImpactCorrection()
    local d = duration or 0.06
    local int = intensity or 1.0

    cc.Contrast = 1.8 * int
    cc.Brightness = 0.3 * int
    cc.Saturation = -1.0 -- Stylized anime high-contrast monochrome flash
    cc.Enabled = true

    task.delay(d, function()
        if cc.Parent then
            cc.Enabled = false
            cc.Contrast = 0
            cc.Brightness = 0
            cc.Saturation = 0
        end
    end)
end

function VFXController.Init()
    EnsureImpactCorrection()

    local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
    if not remotes then return end

    local vfxEvent = remotes:WaitForChild(GameConfig.REMOTES.VFX_TRIGGER, 5) :: RemoteEvent?
    if vfxEvent then
        vfxEvent.OnClientEvent:Connect(function(vfxType: string, data: any)
            if vfxType == "ElementalMove" and data and data.Element and data.Move then
                local evfx = ReplicatedStorage:FindFirstChild("ElementalVFX")
                if evfx then
                    local disp = evfx:FindFirstChild("Dispatcher")
                    if disp then
                        local ok, dmod = pcall(require, disp)
                        if ok and dmod and dmod.Play then
                            dmod.Play(data.Element, data.Move, {
                                character = data.Character,
                                target = data.Target,
                                direction = data.Direction,
                                duration = data.Duration,
                                radius = data.Radius,
                                targetCharacter = data.TargetCharacter,
                                targets = data.Targets,
                            })
                        end
                    end
                end

            elseif vfxType == "Blind" then
                local duration = (data and data.Duration) or 2.0
                UIController.TriggerBlind(duration)

            elseif vfxType == "ImpactFrame" then
                local d = (data and data.Duration) or 0.06
                local int = (data and data.Intensity) or 1.0
                VFXController.TriggerImpactFrame(d, int)

            elseif vfxType == "ImpactBurst" and data and data.Position then
                local element = data.Element or "Fire"
                VFXHelper.CreateImpactBurst(data.Position, element, data.Count or 32)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.85)
                else
                    SoundController.PlaySound3D("Punch", data.Position, 0.8)
                end

                if data.IsCrit then
                    VFXController.TriggerImpactFrame(0.06, 1.0)
                end
                CameraShakeController.Shake(data.Shake or 0.25)

            elseif vfxType == "Shockwave" and data and data.Position then
                local element = data.Element or "Fire"
                VFXHelper.CreateShockwave(data.Position, data.Radius or 22, data.Duration or 0.38, element)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.95)
                else
                    SoundController.PlaySound3D("Explosion", data.Position, 0.9)
                end
                CameraShakeController.Shake(data.Shake or 0.45)

            elseif vfxType == "Crater" and data and data.Position then
                local element = data.Element or "Earth"
                VFXHelper.CreateCrater(data.Position, data.Radius or 14, element)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 1.0)
                else
                    SoundController.PlaySound3D("Explosion", data.Position, 1.0)
                end
                CameraShakeController.Shake(data.Shake or 0.55)

            elseif vfxType == "Beam" and data and data.StartPos and data.EndPos then
                local element = data.Element or "Light"
                VFXHelper.CreateBeam(data.StartPos, data.EndPos, element, data.Thickness or 1.5)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.StartPos, 0.9)
                else
                    SoundController.PlaySound3D("MagicCast", data.StartPos, 0.85)
                end
                CameraShakeController.Shake(data.Shake or 0.3)

            elseif vfxType == "SlashArc" and data and data.CFrame then
                local element = data.Element or "Fire"
                VFXHelper.CreateSlashArc(data.CFrame, element, data.Scale or 1.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.CFrame.Position, 0.8)
                else
                    SoundController.PlaySound3D("SwordSlash", data.CFrame.Position, 0.7)
                end

            elseif vfxType == "CircularSlashWheel" and data and data.CFrame then
                local element = data.Element or "Fire"
                VFXHelper.CreateCircularSlashWheel(data.CFrame, element, data.Radius or 12, data.Count or 16, data.Duration or 0.35)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.CFrame.Position, 0.95)
                else
                    SoundController.PlaySound3D("SwordSlash", data.CFrame.Position, 0.85)
                end
                if data.Shake then
                    CameraShakeController.Shake(data.Shake)
                end
                VFXController.TriggerImpactFrame(0.06, 0.8)

            elseif vfxType == "LightExplosion" and data and data.Position then
                VFXHelper.CreateLightExplosion(data.Position, data.Radius or 22, data.Duration or 0.48)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 1.0)
                else
                    SoundController.PlaySound3D("Explosion", data.Position, 0.95)
                end
                if data.Shake then
                    CameraShakeController.Shake(data.Shake)
                end
                VFXController.TriggerImpactFrame(0.08, 1.1)

            elseif vfxType == "Fireball" and data and data.StartPos and data.EndPos then
                VFXHelper.CreateFireball(data.StartPos, data.EndPos, data.Duration or 0.35)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.StartPos, 0.85)
                end
                if data.Shake then
                    CameraShakeController.Shake(data.Shake)
                end

            elseif vfxType == "WaterSpray" and data and data.CFrame then
                VFXHelper.CreateWaterSpray(data.CFrame, data.Range or 12)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.CFrame.Position, 0.75)
                end

            elseif vfxType == "WaterHand" and data and data.Position then
                VFXHelper.CreateWaterHand(data.Position)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.9)
                end
                CameraShakeController.Shake(data.Shake or 0.45)

            elseif vfxType == "VortexSphere" and data and data.StartPos and data.EndPos then
                VFXHelper.CreateVortexSphere(data.StartPos, data.EndPos, data.Duration or 0.4)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.StartPos, 0.85)
                end
                CameraShakeController.Shake(data.Shake or 0.5)

            elseif vfxType == "WaterDragon" and data and data.Character then
                VFXHelper.AttachWaterDragon(data.Character, data.Duration or 5.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Character:GetPivot().Position, 0.85)
                end

            elseif vfxType == "EarthPillars" and data and data.CFrame then
                VFXHelper.CreateEarthPillars(data.CFrame, data.Duration or 6.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.CFrame.Position, 0.85)
                end
                CameraShakeController.Shake(0.35)

            elseif vfxType == "Boulder" and data and data.StartPos and data.EndPos then
                VFXHelper.CreateBoulder(data.StartPos, data.EndPos, data.Duration or 0.45)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.StartPos, 0.9)
                end
                CameraShakeController.Shake(data.Shake or 0.55)

            elseif vfxType == "StoneGauntlet" and data and data.Character then
                VFXHelper.CreateStoneGauntlet(data.Character, data.Duration or 0.4)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Character:GetPivot().Position, 0.8)
                end

            elseif vfxType == "TerraSequence" and data and data.Position then
                VFXHelper.CreateTerraSequence(data.Position)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.95)
                end

            elseif vfxType == "MirrorsOfJudgement" and data and data.Position then
                VFXHelper.CreateMirrorsOfJudgement(data.Position)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.85)
                end
                CameraShakeController.Shake(data.Shake or 0.5)

            elseif vfxType == "BlindingFlash" and data and data.Position then
                VFXHelper.CreateBlindingFlash(data.Position)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.85)
                end

            elseif vfxType == "Tornado" and data and data.StartPos and data.EndPos then
                VFXHelper.CreateTornado(data.StartPos, data.EndPos, data.Duration or 0.45)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.StartPos, 0.8)
                end
                CameraShakeController.Shake(data.Shake or 0.35)

            elseif vfxType == "Cyclone" and data and data.Position then
                VFXHelper.CreateCyclone(data.Position, data.Radius or 20, data.Duration or 4.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.9)
                end
                CameraShakeController.Shake(data.Shake or 0.5)

            elseif vfxType == "WindLightning" and data and data.StartPos and data.EndPos then
                VFXHelper.CreateWindLightning(data.StartPos, data.EndPos)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.StartPos, 0.8)
                end

            elseif vfxType == "SpeedBoost" and data and data.Character then
                VFXHelper.AttachSpeedBoost(data.Character, data.Duration or 5.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Character:GetPivot().Position, 0.8)
                end

            elseif vfxType == "GlitchedTrail" and data and data.StartPos and data.EndPos then
                VFXHelper.CreateGlitchedTrail(data.StartPos, data.EndPos)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.StartPos, 0.8)
                end

            elseif vfxType == "GlitchWall" and data and data.Character then
                VFXHelper.CreateGlitchWall(data.Character, data.Duration or 0.6)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Character:GetPivot().Position, 0.85)
                end

            elseif vfxType == "404Ball" and data and data.StartPos and data.EndPos then
                VFXHelper.Create404Ball(data.StartPos, data.EndPos, data.Duration or 0.45)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.StartPos, 0.9)
                end
                CameraShakeController.Shake(data.Shake or 0.6)

            elseif vfxType == "GlitchInvis" and data and data.Character then
                VFXHelper.AttachGlitchInvis(data.Character, data.Duration or 5.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Character:GetPivot().Position, 0.8)
                end

            elseif vfxType == "GlitchInvisEnd" and data and data.Character then
                VFXHelper.EndGlitchInvis(data.Character)

            elseif vfxType == "SpatialDistortionDomain" and data and data.Position then
                VFXHelper.CreateSpatialDistortionDomain(data.Position, data.Radius or 35, data.Duration or 7.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.95)
                end
                CameraShakeController.Shake(data.Shake or 0.65)

            elseif vfxType == "GlitchCage" and data and data.Position then
                VFXHelper.CreateGlitchCage(data.Position, data.Duration or 5.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.85)
                end

            elseif vfxType == "ClockAura" and data and data.Character then
                VFXHelper.AttachClockDial(data.Character)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Character:GetPivot().Position, 0.8)
                end

            elseif vfxType == "TimeInjection" and data and data.Position then
                VFXHelper.CreateTimeInjection(data.Position)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 0.85)
                end
                CameraShakeController.Shake(data.Shake or 0.45)

            elseif vfxType == "UntouchableBarrier" and data and data.Character then
                VFXHelper.AttachUntouchableBarrier(data.Character, data.Duration or 4.0)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Character:GetPivot().Position, 0.85)
                end

            elseif vfxType == "VirtualKill" and data and data.Position then
                VFXHelper.CreateVirtualKill(data.Position)
                if data.SFXId and data.SFXId ~= "" then
                    SoundController.PlayAudioId3D(data.SFXId, data.Position, 1.0)
                end

            elseif vfxType == "ConvergingCharge" and data and data.Position then
                local element = data.Element or "Fire"
                VFXHelper.CreateConvergingCharge(data.Position, element, data.Duration or 0.5)

            elseif vfxType == "DamageNumber" and data and data.Position and data.Damage then
                local element = data.Element or "Fire"
                DamageNumbersController.SpawnDamageNumber(data.Position, data.Damage, element, data.IsCrit or false)
                if data.IsCrit then
                    VFXController.TriggerImpactFrame(0.05, 0.85)
                end

            elseif vfxType == "ComboHit" and data and data.Count then
                UIController.RegisterComboHit(data.Count)
            end
        end)
    end
end

function VFXController.PlayVFX(vfxType: string, position: Vector3?, element: string?)
    local elem = element or "Fire"
    local pos = position or Vector3.new(0, 0, 0)
    if vfxType == "ImpactBurst" then
        VFXHelper.CreateImpactBurst(pos, elem, 32)
    elseif vfxType == "Shockwave" then
        VFXHelper.CreateShockwave(pos, 22, 0.38, elem)
    elseif vfxType == "Crater" then
        VFXHelper.CreateCrater(pos, 14, elem)
    elseif vfxType == "ConvergingCharge" then
        VFXHelper.CreateConvergingCharge(pos, elem, 0.5)
    end
end

-- ==================== REQUIRED UNIFIED VFX CONTROLLER API ====================

function VFXController.StopVFX(effectInstance: Instance?)
    if effectInstance and effectInstance.Parent then
        effectInstance:Destroy()
    end
end

function VFXController.AttachVFX(character: Model, element: string): Attachment?
    return VFXHelper.AttachElementalAura(character, element)
end

function VFXController.PlayImpact(position: Vector3, element: string, isCrit: boolean?, sfxId: string?, shake: number?)
    VFXHelper.CreateImpactBurst(position, element, 32)
    if isCrit then
        VFXController.TriggerImpactFrame(0.06, 1.0)
    end
    if sfxId and sfxId ~= "" then
        SoundController.PlayAudioId3D(sfxId, position, 0.85)
    else
        SoundController.PlaySound3D("Punch", position, 0.8)
    end
    CameraShakeController.Shake(shake or 0.3)
end

function VFXController.PlayProjectile(startPos: Vector3, endPos: Vector3, element: string, duration: number?)
    local dur = duration or 0.35
    if element == "Fire" then
        VFXHelper.CreateFireball(startPos, endPos, dur)
    elseif element == "Aqua" then
        VFXHelper.CreateVortexSphere(startPos, endPos, dur)
    elseif element == "Earth" then
        VFXHelper.CreateBoulder(startPos, endPos, dur)
    elseif element == "Wind" then
        VFXHelper.CreateTornado(startPos, endPos, dur)
    elseif element == "Error" then
        VFXHelper.Create404Ball(startPos, endPos, dur)
    else
        VFXHelper.CreateBeam(startPos, endPos, element, 1.5)
    end
end

function VFXController.PlayCharge(position: Vector3, element: string, duration: number?)
    VFXHelper.CreateConvergingCharge(position, element, duration or 0.5)
end

function VFXController.PlayTransformation(character: Model, element: string, duration: number?)
    local dur = duration or 5.0
    if element == "Aqua" then
        VFXHelper.AttachWaterDragon(character, dur)
    elseif element == "Wind" then
        VFXHelper.AttachSpeedBoost(character, dur)
    elseif element == "Error" then
        VFXHelper.AttachGlitchInvis(character, dur)
    elseif element == "Time" then
        VFXHelper.AttachUntouchableBarrier(character, dur)
    else
        VFXHelper.AttachElementalAura(character, element)
    end
end

function VFXController.CleanupVFX(target: Instance?)
    if target and target.Parent then
        target:Destroy()
    else
        local folder = Workspace:FindFirstChild("ActiveVFX")
        if folder then
            folder:ClearAllChildren()
        end
    end
end

return table.freeze(VFXController)

]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">SharedLoader</string>
            <string name="Source"><![CDATA[--!strict
--[[
    Elemental Worlds: Client Shared Loader
    Safely awaits network replication of ReplicatedStorage.Shared before requiring configs and modules.
    Guarantees zero-crash client startup in Roblox Studio and live servers.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local sharedFolder = ReplicatedStorage:WaitForChild("Shared", 30) :: Folder
if not sharedFolder then
    error("[Elemental Worlds] Critical: ReplicatedStorage.Shared failed to replicate within 30s.")
end

local configFolder = sharedFolder:WaitForChild("Config", 30) :: Folder
local modulesFolder = sharedFolder:WaitForChild("Modules", 30) :: Folder

local SharedLoader = {
    Shared = sharedFolder,
    Config = configFolder,
    Modules = modulesFolder,

    GameConfig = require(configFolder:WaitForChild("GameConfig", 30)) :: any,
    AbilityConfig = require(configFolder:WaitForChild("AbilityConfig", 30)) :: any,
    AdminConfig = require(configFolder:WaitForChild("AdminConfig", 30)) :: any,
    ShopConfig = require(configFolder:WaitForChild("ShopConfig", 30)) :: any,

    AnimationMarkerUtil = require(modulesFolder:WaitForChild("AnimationMarkerUtil", 30)) :: any,
    CombatHelper = require(modulesFolder:WaitForChild("CombatHelper", 30)) :: any,
    StatusEffectTypes = require(modulesFolder:WaitForChild("StatusEffectTypes", 30)) :: any,
    VFXHelper = require(modulesFolder:WaitForChild("VFXHelper", 30)) :: any,
}

return table.freeze(SharedLoader)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="72">
          <Properties>
            <string name="Name">TestElementalVFX</string>
            <string name="Source"><![CDATA[--!strict
--[[
    ===========================================================================
    ELEMENTAL WORLDS — CLIENT VFX TEST & SHOWCASE HARNESS
    ===========================================================================
    Location: StarterPlayer.StarterPlayerScripts.TestElementalVFX
    Demonstrates and tests all 36 ability visual effects from ReplicatedStorage.ElementalVFX.

    CONTROLS:
    - [T]: Cycle selected test element (Fire -> Aqua -> Earth -> Light -> Wind -> Error -> Time)
    - [M] / [F]: Cast M1
    - [1]: Cast Move 1
    - [2]: Cast Move 2
    - [3]: Cast Move 3 (handles auto-cycled/ended if persistent)
    - [4]: Cast Move 4
    - [5]: Cast Move 5 (Error only)
    - [P]: Run Automatic Showcase Demo across all 7 elements & 36 abilities!
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
player.CharacterAdded:Connect(function(newChar)
    character = newChar
end)

local elementalVFXFolder = ReplicatedStorage:WaitForChild("ElementalVFX", 10)
if not elementalVFXFolder then
    warn("[TestElementalVFX] ReplicatedStorage.ElementalVFX not found!")
    return
end

local DispatcherMod = elementalVFXFolder:WaitForChild("Dispatcher", 5) :: ModuleScript?
if not DispatcherMod then
    warn("[TestElementalVFX] ReplicatedStorage.ElementalVFX.Dispatcher not found!")
    return
end

local VFX = require(DispatcherMod)

local ELEMENTS = { "Fire", "Aqua", "Earth", "Light", "Wind", "Error", "Time" }
local currentElementIndex = 1
local activeHandles = {}

local function GetContext()
    local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return nil end
    local targetPos = root.Position + root.CFrame.LookVector * 28
    return {
        character = character,
        target = targetPos,
        origin = root.Position,
        direction = root.CFrame.LookVector,
        duration = 5,
        radius = 16,
    }
end

local function PlayMove(element: string, move: string)
    local ctx = GetContext()
    if not ctx then return end

    print(string.format("[VFX Test] Playing %s %s...", element, move))
    local handle = VFX.Play(element, move, ctx)

    if handle then
        print(string.format("[VFX Test] %s %s returned active handle.", element, move))
        table.insert(activeHandles, {
            element = element,
            move = move,
            handle = handle,
            time = os.clock(),
        })

        -- Auto-demonstrate handle methods after delay
        task.delay(2.5, function()
            if handle.Hit then
                pcall(function() handle:Hit() end)
            end
            if handle.SetHealth then
                pcall(function() handle:SetHealth(0.4) end)
            end
            if handle.Attack then
                pcall(function() handle:Attack(ctx.target) end)
            end
        end)

        task.delay(4.5, function()
            if handle.Shatter then
                pcall(function() handle:Shatter() end)
            elseif handle.End then
                pcall(function() handle:End(ctx.target) end)
            elseif handle.Despawn then
                pcall(function() handle:Despawn() end)
            end
        end)
    end
end

-- Automatic Showcase
local isShowcaseRunning = false
local function RunShowcase()
    if isShowcaseRunning then return end
    isShowcaseRunning = true
    print("==================================================")
    print("STARTING COMPLETE 36-ABILITY VFX SHOWCASE DEMO...")
    print("==================================================")

    task.spawn(function()
        for _, elem in ipairs(ELEMENTS) do
            local moves = { "M1", "Move1", "Move2", "Move3", "Move4" }
            if elem == "Error" then
                table.insert(moves, "Move5")
            end

            for _, mv in ipairs(moves) do
                PlayMove(elem, mv)
                task.wait(1.4)
            end
            task.wait(0.8)
        end
        print("==================================================")
        print("VFX SHOWCASE DEMO COMPLETED!")
        print("==================================================")
        isShowcaseRunning = false
    end)
end

-- Keybind listener
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.T then
        currentElementIndex = (currentElementIndex % #ELEMENTS) + 1
        local selected = ELEMENTS[currentElementIndex]
        print(string.format("[VFX Test] Selected Element: %s (Press M/1/2/3/4/5 or P for Showcase)", selected))

    elseif input.KeyCode == Enum.KeyCode.M or input.KeyCode == Enum.KeyCode.F then
        PlayMove(ELEMENTS[currentElementIndex], "M1")

    elseif input.KeyCode == Enum.KeyCode.One then
        PlayMove(ELEMENTS[currentElementIndex], "Move1")

    elseif input.KeyCode == Enum.KeyCode.Two then
        PlayMove(ELEMENTS[currentElementIndex], "Move2")

    elseif input.KeyCode == Enum.KeyCode.Three then
        PlayMove(ELEMENTS[currentElementIndex], "Move3")

    elseif input.KeyCode == Enum.KeyCode.Four then
        PlayMove(ELEMENTS[currentElementIndex], "Move4")

    elseif input.KeyCode == Enum.KeyCode.Five then
        if ELEMENTS[currentElementIndex] == "Error" then
            PlayMove("Error", "Move5")
        end

    elseif input.KeyCode == Enum.KeyCode.P then
        RunShowcase()
    end
end)

print("[Elemental Worlds VFX] Test Harness loaded! Press 'T' to switch element, 'M'/'1'-'4' to cast, 'P' for showcase.")
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
