  <Item class="ServerScriptService" referent="31">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="32">
      <Properties>
        <string name="Name">ElementalWorlds</string>
      </Properties>
      <Item class="Folder" referent="33">
